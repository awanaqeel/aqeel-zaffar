<section
  class="custom-banner"
  style="
    --desktop-banner-ratio: {{ section.settings.desktop_banner.aspect_ratio | default: 1.8 }};
    --mobile-banner-ratio: {{ section.settings.mobile_banner.aspect_ratio | default: 0.82 }};
  "
>
  <div class="custom-banner__media">
    {% if section.settings.desktop_banner != blank %}
      <picture>
        {% if section.settings.mobile_banner != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_banner | image_url: width: 1000 }}"
          >
        {% endif %}

        <img
          src="{{ section.settings.desktop_banner | image_url: width: 2400 }}"
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
          width="{{ section.settings.desktop_banner.width }}"
          height="{{ section.settings.desktop_banner.height }}"
        >
      </picture>
    {% endif %}
  </div>

  <div class="custom-banner__content">
    <div class="custom-banner__text">

      {% if section.settings.heading != blank %}
        <h2 class="custom-banner__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.content != blank %}
        <div class="custom-banner__description">
          {{ section.settings.content }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="custom-banner__button"
        >
          {{ section.settings.button_label }}

          <span class="custom-banner__button-arrow">
            →
          </span>
        </a>
      {% endif %}

    </div>
  </div>
</section>

<style>
  .custom-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: var(--desktop-banner-ratio);
    display: flex;
    align-items: center;
  }

  .custom-banner__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .custom-banner__media picture,
  .custom-banner__media img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .custom-banner__media img {
    object-fit: cover;
    object-position: center;
  }

  .custom-banner__content {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .custom-banner__text {
    max-width: 430px;
  }

  .custom-banner__heading {
    margin: 0 0 18px;
    font-size: 32px;
    line-height: 1.15;
    font-weight: 500;
    color: #000;
  }

  .custom-banner__description {
    margin-bottom: 24px;
    max-width: 390px;
    font-size: 13px;
    line-height: 1.5;
    color: #000;
  }

  .custom-banner__description p {
    margin: 0;
  }

  .custom-banner__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    min-width: 120px;
    padding: 12px 16px;
    overflow: hidden;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 11px;
    line-height: 1;
    color: {{ section.settings.button_text_color }};
    background-color: {{ section.settings.button_bg_color }};
    transition: color 0.3s ease, background-color 0.3s ease;
  }

  .custom-banner__button::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: {{ section.settings.button_bg_hover_color }};
    transition: left 0.35s ease;
    z-index: 0;
  }

  .custom-banner__button:hover::before {
    left: 0;
  }

  .custom-banner__button:hover {
    color: {{ section.settings.button_hover_text_color }};
  }

  .custom-banner__button > * {
    position: relative;
    z-index: 1;
  }

  .custom-banner__button {
    z-index: 1;
  }

  .custom-banner__button-arrow {
    font-size: 16px;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  .custom-banner__button:hover .custom-banner__button-arrow {
    transform: translateX(4px);
  }

  @media screen and (max-width: 749px) {
    .custom-banner {
      aspect-ratio: var(--mobile-banner-ratio);
      align-items: flex-start;
    }

    .custom-banner__content {
      height: 100%;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      text-align: center;
      padding-top: 18px;
    }

    .custom-banner__text {
      width: 100%;
      max-width: 250px;
    }

    .custom-banner__heading {
      margin: 0 0 10px;
      font-size: 17px;
      line-height: 1.2;
      font-weight: 500;
    }

    .custom-banner__description {
      max-width: 220px;
      margin: 0 auto 14px;
      font-size: 8px;
      line-height: 1.45;
    }

    .custom-banner__button {
      min-width: 82px;
      padding: 8px 10px;
      gap: 10px;
      font-size: 8px;
    }

    .custom-banner__button-arrow {
      font-size: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_banner",
      "label": "Desktop Banner"
    },
    {
      "type": "image_picker",
      "id": "mobile_banner",
      "label": "Mobile Banner"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gift.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Bg Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_bg_hover_color",
      "label": "Button BG Hover Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button BG Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Custom banner"
    }
  ]
}
{% endschema %}