<section
  class="custom-banner"
  style="
    --desktop-banner-ratio: {{ section.settings.desktop_banner.aspect_ratio | default: 1.8}};
    --mobile-banner-ratio: {{ section.settings.mobile_banner.aspect_ratio | default: 0.82 }}
  "
>
  <div class="custom-banner__media">
    {% if section.settings.desktop_banner != blank %}
      <picture>
        {% if section.settings.mobile_banner != blank %}
          <source media="(max-width: 989px)">
          srcset= "{{ section.settings.mobile_banner | image_url: width: 1000 }}"
        {% endif %}

        <img
          src="{{ section.settings.desktop_banner | image_url: width: 2400 }}"
          alt="{{ section.settings.heading | escape }}"
          loading=" lazy"
          width="{{  section.settings.desktop_banner.width }}"
          height=""
          {{ section.settings.desktop_banner.height }}
        >
      </picture>
    {% endif %}
  </div>
  <div class="custom-banner__content page-width">
    <div class="custom-banner__text">
      {% if section.settings.heading != blank %}
        <h2 class="custom-banner-heading">
          {{section.settings.heading }}
        </h2>
      {%  endif %}
      {% if section.settings.content != blank %}
        <div class="custom-banner-content">
          {{section.settings.content }}
        </div>
      {%  endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_banner",
      "label": "Desktop Banner"
    },
    {
      "type": "image_picker",
      "id": "mobile_banner",
      "label": "Mobile Banner"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Bg Color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color"
    },
    {
      "type": "color",
      "id": "button_bg_hover_color",
      "label": "Button BG Hover Color"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button BG Text Color"
    }
  ],
  "presets": [
    {
      "name": "Custom banner"
    }
  ]
}
{% endschema %}
