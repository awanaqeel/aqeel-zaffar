<style>
  #shopify-section-{{ section.id }}{
  {% if section.settings.section_padding_desktop != blank %}
    .custom-featured-grid {
      padding: {{ section.settings.section_padding_desktop }};
    }
  {% endif %}

  .section_heading h2 {
    font-family: 'Lustria';
    font-weight: 400;
    font-size: 36px;
    line-height: 120%;
    letter-spacing: 0;
    margin: 0 0 30px 0;
  }

  /* Product Grid */
  .custom-product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
  }

   .custom-banner__button {
    width: 100%;
    max-width: 100%;
    position: relative;
    overflow: hidden;
    font-weight: 400;
    font-size: 16px;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    color:#fff;
    background-color: #000;
    padding: 12px 39px;
    max-width: 220px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1;
  }
  .popup_add_to_cart_text, .popup_add_to_cart_arrow {
  font-weight: 400;
    font-size: 16px;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-align: center;
    text-transform: uppercase;
  }

  .custom-banner__button::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #FFF544;
    transform: translateX(-100%);
    transition: transform 0.4s ease;
    z-index: -1;
  }

  .custom-banner__button .popup_add_to_cart_arrow {
    margin-left: 10px;
    position: relative;
    z-index: 2;
  }

  .custom-banner__button:hover::before {
    transform: translateX(0);
  }

  .custom-banner__button:hover {
    color: #000;
  }

  /* Product Grid Item */
  .custom-product-grid-item {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  /* Product Image */
  .grid_image {
    width: 100%;
    height: 444px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .grid_image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Quick View Button */
  .quick_view_btn {
    position: absolute;

    /* Desktop Position */
    top: var(--quick-top);
    bottom: var(--quick-bottom);
    left: var(--quick-left);
    right: var(--quick-right);

    width: 16px;
    height: 16px;

    background: #F8F8F8E5;
    border-radius: 50%;
    box-shadow: 0px 3px 4px 0px #00000033;

    display: flex;
    justify-content: center;
    align-items: center;

    z-index: 5;
    box-sizing: border-box;
  }

  .quick_view_btn img {
    width: 8px;
    height: 8px;
    display: block;
  }

  /* =========================================
   QUICK VIEW POPUP
========================================= */

.product_popup {
  position: fixed;
  width: 100%;
  inset: 0;
  left: 0%;
  right: 0%;
  height: 100%;
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

.product_popup.is-open {
  display: flex;
}


/* Overlay */

.product_popup_overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.35);
}


/* Popup Card */

.product_popup_card {
  position: relative;
  width: min(700px, calc(100% - 40px));
  max-height: calc(100vh - 40px);
  background: #ffffff;
  z-index: 2;
  overflow: hidden;
  box-sizing: border-box;
}


/* Close Button */

.product_popup_close {
  position: absolute;
  top: 10px;
  right: 10px;

  width: 24px;
  height: 24px;

  padding: 0;
  border: 0;
  background: transparent;

  font-size: 22px;
  font-weight: 300;
  line-height: 24px;

  cursor: pointer;
  z-index: 10;

  display: flex;
  align-items: center;
  justify-content: center;
}


/* =========================================
   POPUP CONTENT
========================================= */

.popup_product_content {
  width: 100%;
  background-color: #fff;
  padding: 25px 20px;
  position: relative;
  max-width: 310px;
}
.close_popup{
  width: max-content;
    position: absolute;
    top: 2%;
    right: 2%;
    cursor:pointer;
}
.image_with_info{
  display: flex;
  flex-wrap: nowrap;
  justify-content: center;
  align-items: flex-start;
  margin-bottom: 10px;
  gap: 8px;
}


/* Product Image */

.popup_product_image {
  width: 100%;
  height: 120px;
}

.popup_product_image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}



/* Product Title */

.popup_product_title {
  font-weight: 300;
  font-size: 16px;
  line-height: 120%;
  letter-spacing: 0px;
  margin: 0 0 13px 0;
}


/* Price */

.popup_product_price {
  font-family: 'Lustria';
  font-weight: 400;
  font-size: 16px;
  line-height: 120%;
  letter-spacing: 0px;
  margin: 0 0 13px 0;
  color: #000;
}


/* Description */

.popup_product_description {
  font-weight: 300;
  font-size: 12px;
  line-height: 110%;
  letter-spacing: -1%;
  color: #000;
}


/* =========================================
   OPTIONS
========================================= */

.popup_product_option {
  margin-bottom: 14px;
}

.popup_option_label {
  display: block;

  margin-bottom: 7px;

  font-size: 11px;
  line-height: 1.2;
}


/* Option Buttons */

.popup_option_buttons {
  display: flex;
  width: 100%;
}

.popup_option_button {
  flex: 1;

  height: 40px;

  padding: 0 10px;

  border: 1px solid #999999;
  background: #ffffff;

  font-size: 16px;
  font-weight: 400;

  cursor: pointer;

  margin-left: -1px;
}

.popup_option_button:first-child {
  margin-left: 0;
}

.popup_option_button.is-selected {
  border: 1px solid #000000;
  background: #ffffff;
  color: #000000;

  position: relative;
  z-index: 1;
}


/* Select */

.popup_select_wrapper {
  position: relative;
  width: 100%;
}

.popup_option_select {
  appearance: none;
  -webkit-appearance: none;

  width: 100%;

  padding: 0 32px 0 10px;

  border: 1px solid #999999;
  border-radius: 0;

  background: #ffffff;

  font-size: 16px;
  height: 40px;

  cursor: pointer;
}

.popup_select_arrow {
  position: absolute;
  right: 10px;
  top: 50%;

  transform: translateY(-50%);

  font-size: 14px;
  line-height: 1;

  pointer-events: none;
}


/* =========================================
   ADD TO CART
========================================= */

.popup_product_form {
  width: 100%;
}

.popup_add_to_cart {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 100%;
  width: 100%;
  height: 40px;

  margin-top: 50px;

  padding: 0 16px;

  border: 0;
  border-radius: 0;

  background: #000000;
  color: #ffffff;

  font-family: inherit;
  font-size: 11px;
  font-weight: 400;

  cursor: pointer;
}


.popup_add_to_cart:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.popup_add_to_cart_text {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}


body.quick-view-open {
  overflow: hidden;
}
  /* Mobile */
  @media only screen and (max-width: 989px) {

    {% if section.settings.section_padding_mobile != blank %}
      .custom-featured-grid {
        padding: {{ section.settings.section_padding_mobile }};
      }
    {% endif %}

    .section_heading h2 {
      font-size: 24px;
      margin: 0 0 20px 0;
      text-align: center;
    }

    /* 2 Products Per Row */
    .custom-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .custom-product-grid-item {
      width: 100%;
    }

    /* Mobile Image */
    .grid_image {
      width: 100%;
      height: 186.42px;
    }

    .grid_image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Mobile Quick View Position */
    .quick_view_btn {
      top: var(--quick-top-mb);
      bottom: var(--quick-bottom-mb);
      left: var(--quick-left-mb);
      right: var(--quick-right-mb);
    }
.popup_product_content{
 max-width: 310px;
}

    .product_popup {
    padding: 12px;
    max-width: 100%;
    left: 0;
    right: 0;
    box-sizing: border-box;
  }

  .product_popup_card {
    width: 100%;
    max-width: 100%;
    max-height: calc(100vh - 24px);

    overflow-y: auto;
  }

  

  .popup_product_title {
    font-size: 12px;
    margin-bottom: 8px;
  }

  .popup_product_price {
    font-size: 12px;
    margin-bottom: 12px;
  }

  .popup_product_description {
    font-size: 8px;
    line-height: 1.3;
    margin-bottom: 16px;
  }

  .popup_product_option {
    margin-bottom: 12px;
  }

  .popup_option_label {
    font-size: 9px;
    margin-bottom: 5px;
  }

  .popup_option_button {
    height: 40px;
    font-size: 16px;
  }

  .popup_add_to_cart {
    margin-top: 22px;
    padding: 0 10px;
  }


  .product_popup_close {
    top: 6px;
    right: 7px;

    width: 18px;
    height: 18px;

    font-size: 17px;
  }
  }
}
</style>


<div class="page-width custom-featured-grid">

  {% if section.settings.section_heading != blank %}
    <div class="section_heading">
      <h2>{{ section.settings.section_heading }}</h2>
    </div>
  {% endif %}


  <div class="custom-product-grid">

    {% for block in section.blocks %}

      {% if block.settings.product != blank %}

        {% assign product = block.settings.product %}

        <div
          class="custom-product-grid-item"
          style="
            --quick-top: {% if block.settings.top > 0 %}{{ block.settings.top }}%{% else %}auto{% endif %};
            --quick-bottom: {% if block.settings.bottom > 0 %}{{ block.settings.bottom }}%{% else %}auto{% endif %};
            --quick-left: {% if block.settings.left > 0 %}{{ block.settings.left }}%{% else %}auto{% endif %};
            --quick-right: {% if block.settings.right > 0 %}{{ block.settings.right }}%{% else %}auto{% endif %};

            --quick-top-mb: {% if block.settings.top_mb > 0 %}{{ block.settings.top_mb }}%{% else %}auto{% endif %};
            --quick-bottom-mb: {% if block.settings.bottom_mb > 0 %}{{ block.settings.bottom_mb }}%{% else %}auto{% endif %};
            --quick-left-mb: {% if block.settings.left_mb > 0 %}{{ block.settings.left_mb }}%{% else %}auto{% endif %};
            --quick-right-mb: {% if block.settings.right_mb > 0 %}{{ block.settings.right_mb }}%{% else %}auto{% endif %};
          "
          {{ block.shopify_attributes }}
        >

          <div class="grid_image">
            <img
              src="{{ product.featured_image | img_url: 'master' }}"
              alt="{{ product.featured_image.alt | escape }}"
              loading="lazy"
            >
          </div>

          <div class="quick_view_btn" id="quick_view_btn_{{ product.id }}" data-product-id="{{  product.id }}" aria-label="Quick view {{ product.title | escape }}">
            <img
              src="https://cdn.shopify.com/s/files/1/0740/2592/6742/files/plus-sign.svg?v=1786143487"
              alt="plus-icon"
            >
          </div>
          <div class="product_popup" id="product-popup-{{  product.id }}" data-product-id="{{  product.id }}" aria-hidden="true">
            {% render 'popup-card', product: product, section: section %}
          </div>

        </div>

      {% endif %}

    {% endfor %}

  </div>

</div>
<script>
(function () {

  /*
   * ---------------------------------------------------------
   * POPUP PRODUCT VARIANT HANDLER
   * ---------------------------------------------------------
   */

  function initPopupProductForms() {

    const forms = document.querySelectorAll('.popup_product_form');

    forms.forEach(function (form) {

      /*
       * Prevent initializing the same form multiple times
       */
      if (form.dataset.variantInitialized === 'true') {
        return;
      }

      form.dataset.variantInitialized = 'true';


      const variantInput = form.querySelector('.popup_variant_id');

      const addToCartButton = form.querySelector('.popup_add_to_cart');

      const selects = form.querySelectorAll('.popup_option_select');

      const optionButtons = form.querySelectorAll('.popup_option_button');

      const variantDataElement =
        form.closest('.product_popup')
        ?.querySelector('.popup-product-variants');

      if (!variantInput || !variantDataElement) {
        return;
      }


      /*
       * Shopify product variants
       */
      let variants = [];

      try {
        variants = JSON.parse(variantDataElement.textContent);
      } catch (error) {
        console.error(
          'Unable to read product variants:',
          error
        );

        return;
      }


      /*
       * ---------------------------------------------------------
       * GET CURRENTLY SELECTED OPTIONS
       * ---------------------------------------------------------
       */

      function getSelectedOptions() {

        const selectedOptions = [];

        /*
         * Select dropdown values
         */
        selects.forEach(function (select) {

          const index = parseInt(
            select.dataset.optionIndex,
            10
          );

          selectedOptions[index] = select.value;

        });


        /*
         * Button values
         */
        optionButtons.forEach(function (button) {

          if (!button.classList.contains('is-selected')) {
            return;
          }

          const index = parseInt(
            button.dataset.optionIndex,
            10
          );

          selectedOptions[index] =
            button.dataset.optionValue;

        });


        return selectedOptions;
      }


      /*
       * ---------------------------------------------------------
       * FIND MATCHING VARIANT
       * ---------------------------------------------------------
       */

      function findVariant(selectedOptions) {

        return variants.find(function (variant) {

          if (!variant.options) {
            return false;
          }

          if (
            variant.options.length !==
            selectedOptions.length
          ) {
            return false;
          }

          return variant.options.every(function (
            optionValue,
            index
          ) {

            return optionValue === selectedOptions[index];

          });

        });

      }


      /*
       * ---------------------------------------------------------
       * UPDATE VARIANT
       * ---------------------------------------------------------
       */

      function updateVariant() {

        const selectedOptions = getSelectedOptions();

        const matchedVariant =
          findVariant(selectedOptions);


        if (!matchedVariant) {

          console.warn(
            'No matching variant found for:',
            selectedOptions
          );

          variantInput.value = '';

          if (addToCartButton) {

            addToCartButton.disabled = true;

            const text =
              addToCartButton.querySelector(
                '.popup_add_to_cart_text'
              );

            if (text) {
              text.innerHTML = 'UNAVAILABLE';
            }

          }

          return;
        }


        /*
         * IMPORTANT:
         *
         * This is the actual variant ID that Shopify
         * must receive.
         */
        variantInput.value = matchedVariant.id;


        /*
         * Update button availability
         */
        if (addToCartButton) {

          const text =
            addToCartButton.querySelector(
              '.popup_add_to_cart_text'
            );

          if (matchedVariant.available) {

            addToCartButton.disabled = false;

            if (text) {

              text.innerHTML =
                'ADD TO CART <span class="popup_add_to_cart_arrow">&xrarr;</span>';

            }

          } else {

            addToCartButton.disabled = true;

            if (text) {
              text.innerHTML = 'SOLD OUT';
            }

          }

        }


        /*
         * Update displayed price
         */
        const popup =
          form.closest('.product_popup');

        if (popup) {

          const priceElement =
            popup.querySelector(
              '.popup_product_price'
            );

          if (
            priceElement &&
            matchedVariant.price
          ) {

            priceElement.dataset.variantPrice =
              matchedVariant.price;

            /*
             * Shopify money formatting is handled
             * by requesting cart rendering below.
             *
             * For now the price remains the
             * Liquid-rendered product price.
             */
          }

        }


        /*
         * Store selected options on form
         * for automatic-product matching.
         */
        form.dataset.selectedOptions =
          JSON.stringify(selectedOptions);


        console.log(
          'Selected variant:',
          matchedVariant.id,
          selectedOptions
        );

      }


      /*
       * ---------------------------------------------------------
       * SELECT CHANGE
       * ---------------------------------------------------------
       */

      selects.forEach(function (select) {

        select.addEventListener(
          'change',
          function () {

            updateVariant();

          }
        );

      });


      /*
       * ---------------------------------------------------------
       * OPTION BUTTON CLICK
       * ---------------------------------------------------------
       */

      optionButtons.forEach(function (button) {

        button.addEventListener(
          'click',
          function () {

            const optionIndex =
              button.dataset.optionIndex;


            /*
             * Remove selected state only from
             * buttons belonging to this option.
             */
            optionButtons.forEach(
              function (otherButton) {

                if (
                  otherButton.dataset.optionIndex ===
                  optionIndex
                ) {

                  otherButton.classList.remove(
                    'is-selected'
                  );

                }

              }
            );


            /*
             * Select clicked option
             */
            button.classList.add(
              'is-selected'
            );


            updateVariant();

          }
        );

      });


      /*
       * Initial variant
       */
      updateVariant();


      /*
       * ---------------------------------------------------------
       * ADD TO CART
       * ---------------------------------------------------------
       */

      form.addEventListener(
        'submit',
        async function (event) {

          event.preventDefault();


          /*
           * Always get the latest variant ID.
           */
          const selectedVariantId =
            variantInput.value;


          if (!selectedVariantId) {

            alert(
              'Please select a valid product variant.'
            );

            return;

          }


          /*
           * Prevent double-click
           */
          if (
            form.dataset.submitting === 'true'
          ) {
            return;
          }

          form.dataset.submitting = 'true';


          if (addToCartButton) {
            addToCartButton.disabled = true;
          }


          try {

            /*
             * Get selected options.
             */
            const selectedOptions =
              getSelectedOptions();


            /*
             * Find selected variant again.
             */
            const selectedVariant =
              findVariant(
                selectedOptions
              );


            if (!selectedVariant) {

              throw new Error(
                'Selected product variant was not found.'
              );

            }


            /*
             * -------------------------------------------------
             * CHECK AUTOMATIC PRODUCT
             * -------------------------------------------------
             */

            let cartItems = [
              {
                id: Number(selectedVariant.id),
                quantity: 1
              }
            ];


            /*
             * Find automatic-product data.
             */
            const popup =
              form.closest('.product_popup');

            const autoProductDataElement =
              popup?.querySelector(
                '.popup-auto-product-data'
              );


            if (autoProductDataElement) {

              let autoProduct = null;

              try {

                autoProduct =
                  JSON.parse(
                    autoProductDataElement.textContent
                  );

              } catch (error) {

                console.error(
                  'Unable to read automatic product data:',
                  error
                );

              }


              if (autoProduct) {

                /*
                 * -------------------------------------------------
                 * DETERMINE IF CURRENT PRODUCT IS BLACK + MEDIUM
                 * -------------------------------------------------
                 */

                const hasBlack =
                  selectedOptions.some(
                    function (value) {

                      return String(value)
                        .trim()
                        .toLowerCase() === 'black';

                    }
                  );


                const hasMedium =
                  selectedOptions.some(
                    function (value) {

                      return String(value)
                        .trim()
                        .toLowerCase() === 'medium';

                    }
                  );


                /*
                 * Only add the automatic product when
                 * Black + Medium is selected.
                 */
                if (
                  hasBlack &&
                  hasMedium
                ) {

                  /*
                   * -----------------------------------------------
                   * FIND MATCHING AUTO PRODUCT VARIANT
                   * -----------------------------------------------
                   *
                   * IMPORTANT:
                   *
                   * We do NOT use:
                   *
                   * selected_or_first_available_variant
                   *
                   * because that would always add the first
                   * available variant.
                   */


                  const autoVariant =
                    findMatchingAutoVariant(
                      autoProduct,
                      selectedOptions
                    );


                  if (autoVariant) {

                    /*
                     * Don't add the automatic product twice
                     * if the selected product itself is the
                     * automatic product.
                     */
                    if (
                      Number(autoProduct.productId) !==
                      Number(selectedVariant.product_id)
                    ) {

                      cartItems.push({
                        id: Number(
                          autoVariant.id
                        ),
                        quantity: 1
                      });

                    }

                  } else {

                    console.warn(
                      'Black + Medium was selected, but no matching automatic-product variant was found.'
                    );

                  }

                }

              }

            }


            /*
             * -------------------------------------------------
             * ADD EVERYTHING TO CART
             * -------------------------------------------------
             */

            const response =
              await fetch(
                window.Shopify.routes.root +
                'cart/add.js',
                {
                  method: 'POST',

                  headers: {
                    'Content-Type':
                      'application/json',
                    'Accept':
                      'application/json'
                  },

                  body: JSON.stringify({
                    items: cartItems
                  })
                }
              );


            if (!response.ok) {

              const errorData =
                await response.json()
                  .catch(function () {
                    return {};
                  });

              throw new Error(
                errorData.description ||
                'Unable to add product to cart.'
              );

            }


            const result =
              await response.json();


            console.log(
              'Products added to cart:',
              result
            );


            /*
             * -------------------------------------------------
             * REFRESH CART UI
             * -------------------------------------------------
             */

            await refreshCart();


            /*
             * Close popup
             */
            const productPopup =
              form.closest('.product_popup');

            if (productPopup) {

              productPopup.setAttribute(
                'aria-hidden',
                'true'
              );

              productPopup.classList.remove(
                'active',
                'is-open',
                'open'
              );

            }


          } catch (error) {

            console.error(
              'Add to cart error:',
              error
            );

            alert(
              error.message ||
              'Something went wrong while adding the product to cart.'
            );


          } finally {

            form.dataset.submitting =
              'false';


            /*
             * Re-enable button.
             */
            updateVariant();

          }

        }
      );

    });

  }


  /*
   * ---------------------------------------------------------
   * FIND AUTOMATIC PRODUCT VARIANT
   * ---------------------------------------------------------
   *
   * This function tries to match the selected options
   * by OPTION NAME first.
   *
   * Example:
   *
   * Current product:
   *
   * Color = Black
   * Size  = Medium
   *
   * Automatic product:
   *
   * Size  = Medium
   * Color = Black
   *
   * Even though the option order is different,
   * it will still find the correct variant.
   */

  function findMatchingAutoVariant(
    autoProduct,
    selectedOptions
  ) {

    if (
      !autoProduct ||
      !autoProduct.variants ||
      !autoProduct.options
    ) {

      return null;

    }


    /*
     * Build selected option map from the
     * CURRENT product.
     */
    const currentPopupOptionNames =
      getCurrentPopupOptionNames();


    const selectedMap = {};


    currentPopupOptionNames.forEach(
      function (name, index) {

        if (
          selectedOptions[index] !==
          undefined
        ) {

          selectedMap[
            String(name).trim().toLowerCase()
          ] =
            String(
              selectedOptions[index]
            ).trim().toLowerCase();

        }

      }
    );


    /*
     * First try matching by option names.
     */
    let matchingVariant =
      autoProduct.variants.find(
        function (variant) {

          if (!variant.options) {
            return false;
          }


          return autoProduct.options.every(
            function (
              autoOptionName,
              autoOptionIndex
            ) {

              const normalizedName =
                String(autoOptionName)
                  .trim()
                  .toLowerCase();


              /*
               * If the automatic product has
               * the same option name, compare
               * its value.
               */
              if (
                selectedMap[
                  normalizedName
                ] !== undefined
              ) {

                return (
                  String(
                    variant.options[
                      autoOptionIndex
                    ]
                  )
                  .trim()
                  .toLowerCase() ===
                  selectedMap[
                    normalizedName
                  ]
                );

              }


              /*
               * Option isn't present on current
               * product. Don't block the match.
               */
              return true;

            }
          );

        }
      );


    if (matchingVariant) {

      return matchingVariant;

    }


    /*
     * ---------------------------------------------------------
     * FALLBACK
     * ---------------------------------------------------------
     *
     * If option names are different, look specifically
     * for a variant containing BOTH:
     *
     * Black
     * Medium
     */

    matchingVariant =
      autoProduct.variants.find(
        function (variant) {

          if (!variant.options) {
            return false;
          }


          const values =
            variant.options.map(
              function (value) {

                return String(value)
                  .trim()
                  .toLowerCase();

              }
            );


          return (
            values.includes('black') &&
            values.includes('medium')
          );

        }
      );


    return matchingVariant || null;

  }


  /*
   * ---------------------------------------------------------
   * GET CURRENT PRODUCT OPTION NAMES
   * ---------------------------------------------------------
   */

  function getCurrentPopupOptionNames() {

    /*
     * Use the first available popup form.
     * Option names are identical for variants
     * of the same product.
     */
    const form =
      document.querySelector(
        '.popup_product_form'
      );


    if (!form) {
      return [];
    }


    const labels =
      form.querySelectorAll(
        '.popup_product_option'
      );


    const names = [];


    labels.forEach(
      function (optionContainer) {

        const label =
          optionContainer.querySelector(
            '.popup_option_label'
          );


        if (label) {

          names.push(
            label.textContent.trim()
          );

        }

      }
    );


    return names;

  }


  /*
   * ---------------------------------------------------------
   * REFRESH CART
   * ---------------------------------------------------------
   */

  async function refreshCart() {

    /*
     * Dispatch common Shopify cart events.
     */
    document.dispatchEvent(
      new CustomEvent(
        'cart:refresh'
      )
    );


    document.dispatchEvent(
      new CustomEvent(
        'cart:updated'
      )
    );


    /*
     * Refresh cart drawer if Shopify theme
     * exposes a refresh method.
     */
    const cartDrawer =
      document.querySelector(
        'cart-drawer'
      );


    if (
      cartDrawer &&
      typeof cartDrawer.renderContents ===
        'function'
    ) {

      try {

        const response =
          await fetch(
            window.Shopify.routes.root +
            'cart.js'
          );

        const cart =
          await response.json();

        cartDrawer.renderContents(cart);

      } catch (error) {

        console.warn(
          'Cart drawer refresh failed:',
          error
        );

      }

    }


    /*
     * Some Shopify themes listen to this event.
     */
    document.dispatchEvent(
      new CustomEvent(
        'ajaxProduct:added'
      )
    );

  }


  /*
   * ---------------------------------------------------------
   * INITIALIZE
   * ---------------------------------------------------------
   */

  function initialize() {

    initPopupProductForms();

  }


  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initialize
    );

  } else {

    initialize();

  }


  /*
   * Shopify Theme Editor / dynamically
   * inserted sections.
   */
  document.addEventListener(
    'shopify:section:load',
    function () {

      initPopupProductForms();

    }
  );

})();
</script>

