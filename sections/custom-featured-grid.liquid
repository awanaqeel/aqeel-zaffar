<style>
  #shopify-section-{{ section.id }}{
  {% if section.settings.section_padding_desktop != blank %}
    .custom-featured-grid {
      padding: {{ section.settings.section_padding_desktop }};
    }
  {% endif %}

  .section_heading h2 {
    font-family: 'Lustria';
    font-weight: 400;
    font-size: 36px;
    line-height: 120%;
    letter-spacing: 0;
    margin: 0 0 30px 0;
  }

  /* Product Grid */
  .custom-product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
  }

   .custom-banner__button {
    width: 100%;
    max-width: 100%;
    position: relative;
    overflow: hidden;
    font-weight: 400;
    font-size: 16px;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    color:#fff;
    background-color: #000;
    padding: 12px 39px;
    max-width: 220px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1;
  }
  .popup_add_to_cart_text, .popup_add_to_cart_arrow {
  font-weight: 400;
    font-size: 16px;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-align: center;
    text-transform: uppercase;
  }

  .custom-banner__button::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #FFF544;
    transform: translateX(-100%);
    transition: transform 0.4s ease;
    z-index: -1;
  }

  .custom-banner__button .popup_add_to_cart_arrow {
    margin-left: 10px;
    position: relative;
    z-index: 2;
  }

  .custom-banner__button:hover::before {
    transform: translateX(0);
  }

  .custom-banner__button:hover {
    color: #000;
  }

  /* Product Grid Item */
  .custom-product-grid-item {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  /* Product Image */
  .grid_image {
    width: 100%;
    height: 444px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .grid_image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Quick View Button */
  .quick_view_btn {
    position: absolute;

    /* Desktop Position */
    top: var(--quick-top);
    bottom: var(--quick-bottom);
    left: var(--quick-left);
    right: var(--quick-right);

    width: 16px;
    height: 16px;

    background: #F8F8F8E5;
    border-radius: 50%;
    box-shadow: 0px 3px 4px 0px #00000033;

    display: flex;
    justify-content: center;
    align-items: center;

    z-index: 5;
    box-sizing: border-box;
  }

  .quick_view_btn img {
    width: 8px;
    height: 8px;
    display: block;
  }

  /* =========================================
   QUICK VIEW POPUP
========================================= */

.product_popup {
  position: fixed;
  width: 100%;
  inset: 0;
  left: 0%;
  right: 0%;
  height: 100%;
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

.product_popup.is-open {
  display: flex;
}


/* Overlay */

.product_popup_overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.35);
}


/* Popup Card */

.product_popup_card {
  position: relative;
  width: min(700px, calc(100% - 40px));
  max-height: calc(100vh - 40px);
  background: #ffffff;
  z-index: 2;
  overflow: hidden;
  box-sizing: border-box;
}


/* Close Button */

.product_popup_close {
  position: absolute;
  top: 10px;
  right: 10px;

  width: 24px;
  height: 24px;

  padding: 0;
  border: 0;
  background: transparent;

  font-size: 22px;
  font-weight: 300;
  line-height: 24px;

  cursor: pointer;
  z-index: 10;

  display: flex;
  align-items: center;
  justify-content: center;
}


/* =========================================
   POPUP CONTENT
========================================= */

.popup_product_content {
  width: 100%;
  background-color: #fff;
  padding: 25px 20px;
  position: relative;
  max-width: 310px;
}
.close_popup{
  width: max-content;
    position: absolute;
    top: 2%;
    right: 2%;
    cursor:pointer;
}
.image_with_info{
  display: flex;
  flex-wrap: nowrap;
  justify-content: center;
  align-items: flex-start;
  margin-bottom: 10px;
  gap: 8px;
}


/* Product Image */

.popup_product_image {
  width: 100%;
  height: 120px;
}

.popup_product_image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}



/* Product Title */

.popup_product_title {
  font-weight: 300;
  font-size: 16px;
  line-height: 120%;
  letter-spacing: 0px;
  margin: 0 0 13px 0;
}


/* Price */

.popup_product_price {
  font-family: 'Lustria';
  font-weight: 400;
  font-size: 16px;
  line-height: 120%;
  letter-spacing: 0px;
  margin: 0 0 13px 0;
  color: #000;
}


/* Description */

.popup_product_description {
  font-weight: 300;
  font-size: 12px;
  line-height: 110%;
  letter-spacing: -1%;
  color: #000;
}


/* =========================================
   OPTIONS
========================================= */

.popup_product_option {
  margin-bottom: 14px;
}

.popup_option_label {
  display: block;

  margin-bottom: 7px;

  font-size: 11px;
  line-height: 1.2;
}


/* Option Buttons */

.popup_option_buttons {
  display: flex;
  width: 100%;
}

.popup_option_button {
  flex: 1;

  height: 40px;

  padding: 0 10px;

  border: 1px solid #999999;
  background: #ffffff;

  font-size: 16px;
  font-weight: 400;

  cursor: pointer;

  margin-left: -1px;
}

.popup_option_button:first-child {
  margin-left: 0;
}

.popup_option_button.is-selected {
  border: 1px solid #000000;
  background: #ffffff;
  color: #000000;

  position: relative;
  z-index: 1;
}


/* Select */

.popup_select_wrapper {
  position: relative;
  width: 100%;
}

.popup_option_select {
  appearance: none;
  -webkit-appearance: none;

  width: 100%;

  padding: 0 32px 0 10px;

  border: 1px solid #999999;
  border-radius: 0;

  background: #ffffff;

  font-size: 16px;
  height: 40px;

  cursor: pointer;
}

.popup_select_arrow {
  position: absolute;
  right: 10px;
  top: 50%;

  transform: translateY(-50%);

  font-size: 14px;
  line-height: 1;

  pointer-events: none;
}


/* =========================================
   ADD TO CART
========================================= */

.popup_product_form {
  width: 100%;
}

.popup_add_to_cart {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 100%;
  width: 100%;
  height: 40px;

  margin-top: 50px;

  padding: 0 16px;

  border: 0;
  border-radius: 0;

  background: #000000;
  color: #ffffff;

  font-family: inherit;
  font-size: 11px;
  font-weight: 400;

  cursor: pointer;
}


.popup_add_to_cart:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.popup_add_to_cart_text {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}


body.quick-view-open {
  overflow: hidden;
}
  /* Mobile */
  @media only screen and (max-width: 989px) {

    {% if section.settings.section_padding_mobile != blank %}
      .custom-featured-grid {
        padding: {{ section.settings.section_padding_mobile }};
      }
    {% endif %}

    .section_heading h2 {
      font-size: 24px;
      margin: 0 0 20px 0;
      text-align: center;
    }

    /* 2 Products Per Row */
    .custom-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .custom-product-grid-item {
      width: 100%;
    }

    /* Mobile Image */
    .grid_image {
      width: 100%;
      height: 186.42px;
    }

    .grid_image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Mobile Quick View Position */
    .quick_view_btn {
      top: var(--quick-top-mb);
      bottom: var(--quick-bottom-mb);
      left: var(--quick-left-mb);
      right: var(--quick-right-mb);
    }
.popup_product_content{
 max-width: 310px;
}

    .product_popup {
    padding: 12px;
    max-width: 100%;
    left: 0;
    right: 0;
    box-sizing: border-box;
  }

  .product_popup_card {
    width: 100%;
    max-width: 100%;
    max-height: calc(100vh - 24px);

    overflow-y: auto;
  }

  

  .popup_product_title {
    font-size: 12px;
    margin-bottom: 8px;
  }

  .popup_product_price {
    font-size: 12px;
    margin-bottom: 12px;
  }

  .popup_product_description {
    font-size: 8px;
    line-height: 1.3;
    margin-bottom: 16px;
  }

  .popup_product_option {
    margin-bottom: 12px;
  }

  .popup_option_label {
    font-size: 9px;
    margin-bottom: 5px;
  }

  .popup_option_button {
    height: 40px;
    font-size: 16px;
  }

  .popup_add_to_cart {
    margin-top: 22px;
    padding: 0 10px;
  }


  .product_popup_close {
    top: 6px;
    right: 7px;

    width: 18px;
    height: 18px;

    font-size: 17px;
  }
  }
}
</style>


<div class="page-width custom-featured-grid">

  {% if section.settings.section_heading != blank %}
    <div class="section_heading">
      <h2>{{ section.settings.section_heading }}</h2>
    </div>
  {% endif %}


  <div class="custom-product-grid">

    {% for block in section.blocks %}

      {% if block.settings.product != blank %}

        {% assign product = block.settings.product %}

        <div
          class="custom-product-grid-item"
          style="
            --quick-top: {% if block.settings.top > 0 %}{{ block.settings.top }}%{% else %}auto{% endif %};
            --quick-bottom: {% if block.settings.bottom > 0 %}{{ block.settings.bottom }}%{% else %}auto{% endif %};
            --quick-left: {% if block.settings.left > 0 %}{{ block.settings.left }}%{% else %}auto{% endif %};
            --quick-right: {% if block.settings.right > 0 %}{{ block.settings.right }}%{% else %}auto{% endif %};

            --quick-top-mb: {% if block.settings.top_mb > 0 %}{{ block.settings.top_mb }}%{% else %}auto{% endif %};
            --quick-bottom-mb: {% if block.settings.bottom_mb > 0 %}{{ block.settings.bottom_mb }}%{% else %}auto{% endif %};
            --quick-left-mb: {% if block.settings.left_mb > 0 %}{{ block.settings.left_mb }}%{% else %}auto{% endif %};
            --quick-right-mb: {% if block.settings.right_mb > 0 %}{{ block.settings.right_mb }}%{% else %}auto{% endif %};
          "
          {{ block.shopify_attributes }}
        >

          <div class="grid_image">
            <img
              src="{{ product.featured_image | img_url: 'master' }}"
              alt="{{ product.featured_image.alt | escape }}"
              loading="lazy"
            >
          </div>

          <div class="quick_view_btn" id="quick_view_btn_{{ product.id }}" data-product-id="{{  product.id }}" aria-label="Quick view {{ product.title | escape }}">
            <img
              src="https://cdn.shopify.com/s/files/1/0740/2592/6742/files/plus-sign.svg?v=1786143487"
              alt="plus-icon"
            >
          </div>
          <div class="product_popup" id="product-popup-{{  product.id }}" data-product-id="{{  product.id }}" aria-hidden="true">
            {% render 'popup-card', product: product, section: section %}
          </div>

        </div>

      {% endif %}

    {% endfor %}

  </div>

</div>


{% schema %}
{
  "name": "Custom Featured Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading"
    },
    {
      "type": "product",
      "id": "select_product",
      "label": "Select Product",
      "info": "Product that is added automatically when Black and Medium is selected."
    },
    {
      "type": "text",
      "id": "section_padding_desktop",
      "label": "Section Padding (Desktop)",
      "info": "Write in this format (top right bottom left)"
    },
    {
      "type": "text",
      "id": "section_padding_mobile",
      "label": "Section Padding (Mobile)",
      "info": "Write in this format (top right bottom left)"
    }
  ],
  "blocks": [
    {
      "name": "Product",
      "type": "product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "header",
          "content": "Quick View Icon Position - Desktop"
        },
        {
          "type": "range",
          "id": "top",
          "label": "Top",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "bottom",
          "label": "Bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "left",
          "label": "Left",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "right",
          "label": "Right",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },

        {
          "type": "header",
          "content": "Quick View Icon Position - Mobile"
        },
        {
          "type": "range",
          "id": "top_mb",
          "label": "Top (Mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "bottom_mb",
          "label": "Bottom (Mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "left_mb",
          "label": "Left (Mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "right_mb",
          "label": "Right (Mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Grid"
    }
  ]
}
{% endschema %}

<script>
(function () {

  /*
   * IMPORTANT:
   *
   * This section can render multiple times (once per product),
   * and this specific popup markup can ALSO be re-injected later
   * by AJAX (filters, sorting, infinite scroll, "related products"
   * re-renders, etc).
   *
   * FIX (bugs #2 and #3):
   * The previous version only ever initialized popups that existed
   * in the DOM at first page load ("window.__quickViewInitialized"
   * blocked every later run entirely). Any popup added afterwards
   * never got its JS attached, so the browser fell back to native
   * form submission: the hidden variant input was never updated
   * (always added the first/default variant), and nothing blocked
   * rapid/duplicate clicks (so quantity could end up 2, 3, 4...).
   *
   * We now keep the "attach global listeners once" guard, but we
   * ALSO watch the DOM with a MutationObserver so ANY popup that
   * appears at ANY time gets initialized, not just the ones present
   * on first load.
   */

  var AUTO_ADDED_PRODUCT_ID = {{ auto_added_product | default: 0 }};


  /* =========================================================
   * HELPER: CLOSE ALL POPUPS
   * ========================================================= */

  function closeAllPopups() {

    document.querySelectorAll('.product_popup.is-open').forEach(function (popup) {

      popup.classList.remove('is-open');
      popup.setAttribute('aria-hidden', 'true');

      /*
       * Defensive reset: if a popup is force-closed mid "ADDING..."
       * state, don't leave its button stuck disabled next time it
       * opens.
       */
      var form = popup.querySelector('.popup_product_form');
      if (form && form.dataset.addingToCart === 'true') {

        form.dataset.addingToCart = 'false';

        var addButton = form.querySelector('.popup_add_to_cart');
        var addButtonText = form.querySelector('.popup_add_to_cart_text');

        if (addButton) {
          addButton.disabled = false;
        }

        if (addButtonText) {
          addButtonText.innerHTML =
            'ADD TO CART <span class="popup_add_to_cart_arrow"> &xrarr; </span>';
        }
      }

    });

    document.body.classList.remove('quick-view-open');
  }


  /* =========================================================
   * INITIALIZE A SINGLE PRODUCT POPUP
   * ========================================================= */

  function initializeProductPopup(content) {

    if (!content || content.dataset.quickViewInitialized === 'true') {
      return;
    }

    content.dataset.quickViewInitialized = 'true';


    var form = content.querySelector('.popup_product_form');

    if (!form) {
      return;
    }


    var popup = content.closest('.product_popup');

    if (!popup) {
      return;
    }


    var variantInput = form.querySelector('.popup_variant_id');
    var addButton = form.querySelector('.popup_add_to_cart');
    var addButtonText = form.querySelector('.popup_add_to_cart_text');
    var priceElement = popup.querySelector('.popup_product_price');
    var productDataElement = content.querySelector('.popup-product-json');


    if (!variantInput || !productDataElement) {
      return;
    }


    /* =========================================================
     * PRODUCT DATA
     * ========================================================= */

    var productData;

    try {

      productData = JSON.parse(productDataElement.textContent);

    } catch (error) {

      console.error('Quick View product JSON error:', error);
      return;
    }


    if (!productData || !productData.variants) {
      return;
    }


    /* =========================================================
     * GET SELECTED OPTIONS
     * ========================================================= */

    function getSelectedOptions() {

      var selectedOptions = [];

      content
        .querySelectorAll('.popup_product_option')
        .forEach(function (optionContainer) {

          var index = parseInt(
            optionContainer.getAttribute('data-option-index'),
            10
          );

          var selectedButton = optionContainer.querySelector(
            '.popup_option_button.is-selected'
          );

          var select = optionContainer.querySelector('.popup_option_select');

          if (selectedButton) {

            selectedOptions[index] = selectedButton.getAttribute('data-option-value');

          } else if (select) {

            selectedOptions[index] = select.value;

          }

        });

      return selectedOptions;

    }


    /* =========================================================
     * FIND VARIANT
     * ========================================================= */

    function findSelectedVariant() {

      var selectedOptions = getSelectedOptions();

      if (
        !selectedOptions.length ||
        selectedOptions.some(function (value) {
          return typeof value === 'undefined';
        })
      ) {
        return null;
      }

      var variant = productData.variants.find(function (variant) {

        return variant.options.every(function (optionValue, index) {

          return (
            String(optionValue).trim() === String(selectedOptions[index]).trim()
          );

        });

      });

      return variant || null;

    }


    /* =========================================================
     * UPDATE VARIANT
     *
     * FIX (bug #2): this always runs whenever an option is
     * clicked/changed, so the hidden input is kept in sync with
     * whatever is currently selected in the UI (rather than
     * staying stuck on the default variant when the popup was
     * never initialized in the first place).
     * ========================================================= */

    function updateVariant() {

      var variant = findSelectedVariant();

      if (!variant) {

        variantInput.value = '';

        if (addButton) {
          addButton.disabled = true;
        }

        if (addButtonText) {
          addButtonText.textContent = 'UNAVAILABLE';
        }

        return;
      }

      variantInput.value = String(variant.id);

      if (priceElement && typeof Shopify !== 'undefined' && Shopify.formatMoney) {

        priceElement.innerHTML = Shopify.formatMoney(variant.price, Shopify.money_format);

      }

      if (addButton) {
        addButton.disabled = !variant.available;
      }

      if (addButtonText) {
        addButtonText.textContent = variant.available ? 'ADD TO CART' : 'SOLD OUT';
      }

    }


    /* =========================================================
     * OPTION BUTTONS
     * ========================================================= */

    content.querySelectorAll('.popup_option_button').forEach(function (button) {

      button.addEventListener('click', function () {

        var index = this.getAttribute('data-option-index');

        content
          .querySelectorAll('.popup_option_button[data-option-index="' + index + '"]')
          .forEach(function (item) {
            item.classList.remove('is-selected');
          });

        this.classList.add('is-selected');

        updateVariant();

      });

    });


    /* =========================================================
     * SELECT OPTIONS
     * ========================================================= */

    content.querySelectorAll('.popup_option_select').forEach(function (select) {

      select.addEventListener('change', function () {
        updateVariant();
      });

    });


    /* =========================================================
     * ADD TO CART
     *
     * FIX (bug #3): guarded on TWO levels now -
     *  1) a dataset flag so a second submit event on the same
     *     form (e.g. double click before the button visually
     *     disables) is ignored outright.
     *  2) the button is disabled synchronously, before anything
     *     async happens, so no additional native submits can slip
     *     through while a request is in flight.
     * ========================================================= */

    form.addEventListener('submit', function (event) {

      event.preventDefault();
      event.stopPropagation();

      if (form.dataset.addingToCart === 'true') {
        return;
      }

      var selectedVariantId = variantInput.value;

      if (!selectedVariantId) {
        console.error('Quick View: No variant selected.');
        return;
      }

      form.dataset.addingToCart = 'true';

      if (addButton) {
        addButton.disabled = true;
      }

      if (addButtonText) {
        addButtonText.textContent = 'ADDING...';
      }


      /* =====================================================
       * GET CURRENT SELECTED OPTIONS
       * ===================================================== */

      var selectedOptions = getSelectedOptions();

      var normalizedOptions = selectedOptions.map(function (value) {
        return value ? String(value).trim().toLowerCase() : '';
      });

      var hasSizeM = normalizedOptions.indexOf('m') !== -1;
      var hasBlack = normalizedOptions.indexOf('black') !== -1;


      /* =====================================================
       * BUILD CART ITEMS
       * ===================================================== */

      var items = [
        {
          id: Number(selectedVariantId),
          quantity: 1
        }
      ];

      /*
       * Size M + Color Black -> auto add the configured product,
       * exactly once, and only if it isn't the same variant being
       * added already.
       */
      if (
        hasSizeM &&
        hasBlack &&
        AUTO_ADDED_PRODUCT_ID &&
        AUTO_ADDED_PRODUCT_ID !== Number(selectedVariantId)
      ) {

        items.push({
          id: AUTO_ADDED_PRODUCT_ID,
          quantity: 1
        });

      }


      /* =====================================================
       * ADD TO SHOPIFY CART
       * ===================================================== */

      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ items: items })
      })

        .then(function (response) {

          if (!response.ok) {
            return response.json().then(function (error) {
              throw error;
            });
          }

          return response.json();

        })

        .then(function (data) {

          if (popup) {
            popup.classList.remove('is-open');
            popup.setAttribute('aria-hidden', 'true');
          }

          document.body.classList.remove('quick-view-open');

          document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
          document.dispatchEvent(new CustomEvent('cart:refresh', { detail: data }));

          if (typeof window.refreshCart === 'function') {
            window.refreshCart();
          }

          form.dataset.addingToCart = 'false';

          if (addButton) {
            addButton.disabled = false;
          }

          if (addButtonText) {
            addButtonText.innerHTML =
              'ADD TO CART <span class="popup_add_to_cart_arrow"> &xrarr; </span>';
          }

        })

        .catch(function (error) {

          console.error('Quick View Add To Cart Error:', error);

          form.dataset.addingToCart = 'false';

          var currentVariant = findSelectedVariant();

          if (addButton) {
            addButton.disabled = !currentVariant || !currentVariant.available;
          }

          if (addButtonText) {
            addButtonText.innerHTML =
              'ADD TO CART <span class="popup_add_to_cart_arrow"> &xrarr; </span>';
          }

        });

    });


    /* =========================================================
     * INITIAL VARIANT SYNC
     * ========================================================= */

    updateVariant();

  }


  /* =========================================================
   * GLOBAL SETUP (runs once, guarded)
   * ========================================================= */

  if (window.__quickViewInitialized) {
    return;
  }

  window.__quickViewInitialized = true;


  /* OPEN QUICK VIEW ------------------------------------------------- */

  document.addEventListener('click', function (event) {

    var quickViewButton = event.target.closest('.quick_view_btn');

    if (!quickViewButton) {
      return;
    }

    event.preventDefault();

    var productId = quickViewButton.getAttribute('data-product-id');

    if (!productId) {
      return;
    }

    var popup = document.querySelector('#product-popup-' + productId);

    if (!popup) {
      return;
    }

    /*
     * FIX (bug #1): always close every other open popup first,
     * regardless of which one was open, before showing the new one.
     */
    closeAllPopups();

    popup.classList.add('is-open');
    popup.setAttribute('aria-hidden', 'false');

    document.body.classList.add('quick-view-open');

  });


  /* CLOSE POPUP ------------------------------------------------------ */

  document.addEventListener('click', function (event) {

    var closeButton = event.target.closest('.product_popup_close');

    if (closeButton) {

      event.preventDefault();

      var popup = closeButton.closest('.product_popup');

      if (popup) {
        popup.classList.remove('is-open');
        popup.setAttribute('aria-hidden', 'true');
      }

      document.body.classList.remove('quick-view-open');

      return;
    }

    var overlay = event.target.closest('.product_popup_overlay');

    if (overlay) {
      closeAllPopups();
    }

  });


  /* ESC KEY ------------------------------------------------------------ */

  document.addEventListener('keydown', function (event) {

    if (event.key !== 'Escape') {
      return;
    }

    closeAllPopups();

  });


  /* =========================================================
   * INITIALIZE ALL EXISTING POPUPS
   * ========================================================= */

  function initializeAllPopups(root) {

    (root || document)
      .querySelectorAll('.popup_product_content')
      .forEach(function (content) {
        initializeProductPopup(content);
      });

  }

  function runInitialPass() {
    initializeAllPopups(document);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runInitialPass);
  } else {
    runInitialPass();
  }


  /* =========================================================
   * FIX (bugs #2 and #3, root cause): watch for popups added
   * to the page AFTER first load (AJAX filters/sorting,
   * infinite scroll, re-rendered sections, etc.) and initialize
   * them the moment they appear, instead of relying only on the
   * one-time load above.
   * ========================================================= */

  var quickViewObserver = new MutationObserver(function (mutations) {

    mutations.forEach(function (mutation) {

      mutation.addedNodes.forEach(function (node) {

        if (node.nodeType !== 1) {
          return;
        }

        if (node.classList && node.classList.contains('popup_product_content')) {
          initializeProductPopup(node);
        }

        if (node.querySelectorAll) {
          node.querySelectorAll('.popup_product_content').forEach(initializeProductPopup);
        }

      });

    });

  });

  quickViewObserver.observe(document.documentElement, {
    childList: true,
    subtree: true
  });


})();
</script> 