<style>
    {% if section.settings.section_padding_desktop != blank %}
        .custom-featured-grid{
            padding: {{ section.settings.section_padding_desktop }};
        }
    {% endif %}
    .section_heading h2{
        font-family: 'Lustria';
        font-weight: 400;
        font-size: 36px;
        line-height: 120%;
        letter-spacing: 0px;
        margin: 0 0 30px 0;
    }
    .custom-product-grid{
      display: grid;
    }
    @media only screen and (max-width: 989px){
        {% if section.settings.section_padding_mobile != blank %}
        .custom-featured-grid{
            padding: {{ section.settings.section_padding_mobile }};
        }
        {% endif %}
        .section_heading h2{
          font-size: 24px;
          margin: 0 0 20px 0;
          text-align: center;
    }
    }
</style>
<div class="page-width custom-featured-grid">
  {% if section.settings.section_heading != blank %}
    <div class="section_heading">
      <h2>{{ section.settings.section_heading }}</h2>
    </div>
  {% endif %}

  <div class="custom-product-grid">
    {%  for block in section.blocks %}
      {%  if block.settings.product != blank %}
        <div class="custom-product-grid-item">
          
        </div>
      {%  endif %}
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "Custom Featured Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading"
    },
    {
      "type": "product",
      "id": "select_product",
      "label": "Select Product",
      "info": "Product that is added automatically when Black and Medium is selected."
    },
    {
      "type": "text",
      "id": "section_padding_desktop",
      "label": "Section Padding (Desktop)",
      "info": "Write in this format (top right bottom left)"
    },
    {
      "type": "text",
      "id": "section_padding_mobile",
      "label": "Section Padding (Mobile)",
      "info": "Write in this format (top right bottom left)"
    }
  ],
  "blocks": [
    {
      "name": "Product",
      "type": "product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "header",
          "content": "Quick View Icon Position"
        },
        {
          "type": "range",
          "id": "top",
          "label": "Top",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "bottom",
          "label": "Bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "left",
          "label": "Left",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "right",
          "label": "Right",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Grid"
    }
  ]
}
{% endschema %}
