<div class="page-width">

</div>
{% schema %}
{
  "name": "Custom Featured Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading"
    },
    {
      "type": "product",
      "id": "select_product",
      "label": "Select Product",
      "info": "Product that is added automatically when Black and Medium is selected."
    },
     {
      "type": "text",
      "id": "section_padding_desktop",
      "label": "Section Padding (Desktop)",
      "info": "Write in this format (top right bottom left)"
    },
    {
      "type": "text",
      "id": "section_padding_mobile",
      "label": "Section Padding (Mobile)",
      "info": "Write in this format (top right bottom left)"
    }
  ],
  "blocks": [
    {
      "name": "Product",
      "type": "product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "header",
          "content": "Quick View Icon Position"
        },
        {
          "type": "range",
          "id": "top",
          "label": "Top",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "bottom",
          "label": "Bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "left",
          "label": "Left",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "right",
          "label": "Right",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Grid"
    }
  ]
}
{% endschema %}
