<style>
  #shopify-section-{{ section.id }}{
  {% if section.settings.section_padding_desktop != blank %}
    .custom-featured-grid {
      padding: {{ section.settings.section_padding_desktop }};
    }
  {% endif %}

  .section_heading h2 {
    font-family: 'Lustria';
    font-weight: 400;
    font-size: 36px;
    line-height: 120%;
    letter-spacing: 0;
    margin: 0 0 30px 0;
  }

  /* Product Grid */
  .custom-product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
  }

   .custom-banner__button {
    width: 100%;
    max-width: 100%;
    position: relative;
    overflow: hidden;
    font-weight: 400;
    font-size: 16px;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    color:#fff;
    background-color: #000;
    padding: 12px 39px;
    max-width: 220px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1;
  }
  .popup_add_to_cart_text, .popup_add_to_cart_arrow {
  font-weight: 400;
    font-size: 16px;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-align: center;
    text-transform: uppercase;
  }

  .custom-banner__button::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #FFF544;
    transform: translateX(-100%);
    transition: transform 0.4s ease;
    z-index: -1;
  }

  .custom-banner__button .popup_add_to_cart_arrow {
    margin-left: 10px;
    position: relative;
    z-index: 2;
  }

  .custom-banner__button:hover::before {
    transform: translateX(0);
  }

  .custom-banner__button:hover {
    color: #000;
  }

  /* Product Grid Item */
  .custom-product-grid-item {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  /* Product Image */
  .grid_image {
    width: 100%;
    height: 444px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .grid_image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Quick View Button */
  .quick_view_btn {
    position: absolute;

    /* Desktop Position */
    top: var(--quick-top);
    bottom: var(--quick-bottom);
    left: var(--quick-left);
    right: var(--quick-right);

    width: 16px;
    height: 16px;

    background: #F8F8F8E5;
    border-radius: 50%;
    box-shadow: 0px 3px 4px 0px #00000033;

    display: flex;
    justify-content: center;
    align-items: center;

    z-index: 5;
    box-sizing: border-box;
  }

  .quick_view_btn img {
    width: 8px;
    height: 8px;
    display: block;
  }

  /* =========================================
   QUICK VIEW POPUP
========================================= */

.product_popup {
  position: fixed;
  width: 100%;
  inset: 0;
  left: 0%;
  right: 0%;
  height: 100%;
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

.product_popup.is-open {
  display: flex;
}


/* Overlay */

.product_popup_overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.35);
}


/* Popup Card */

.product_popup_card {
  position: relative;
  width: min(700px, calc(100% - 40px));
  max-height: calc(100vh - 40px);
  background: #ffffff;
  z-index: 2;
  overflow: hidden;
  box-sizing: border-box;
}


/* Close Button */

.product_popup_close {
  position: absolute;
  top: 10px;
  right: 10px;

  width: 24px;
  height: 24px;

  padding: 0;
  border: 0;
  background: transparent;

  font-size: 22px;
  font-weight: 300;
  line-height: 24px;

  cursor: pointer;
  z-index: 10;

  display: flex;
  align-items: center;
  justify-content: center;
}


/* =========================================
   POPUP CONTENT
========================================= */

.popup_product_content {
  width: 100%;
  background-color: #fff;
  padding: 25px 20px;
  position: relative;
  max-width: 310px;
}
.close_popup{
  width: max-content;
    position: absolute;
    top: 2%;
    right: 2%;
    cursor:pointer;
}
.image_with_info{
  display: flex;
  flex-wrap: nowrap;
  justify-content: center;
  align-items: flex-start;
  margin-bottom: 10px;
  gap: 8px;
}


/* Product Image */

.popup_product_image {
  width: 100%;
  height: 120px;
}

.popup_product_image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}



/* Product Title */

.popup_product_title {
  font-weight: 300;
  font-size: 16px;
  line-height: 120%;
  letter-spacing: 0px;
  margin: 0 0 13px 0;
}


/* Price */

.popup_product_price {
  font-family: 'Lustria';
  font-weight: 400;
  font-size: 16px;
  line-height: 120%;
  letter-spacing: 0px;
  margin: 0 0 13px 0;
  color: #000;
}


/* Description */

.popup_product_description {
  font-weight: 300;
  font-size: 12px;
  line-height: 110%;
  letter-spacing: -1%;
  color: #000;
}


/* =========================================
   OPTIONS
========================================= */

.popup_product_option {
  margin-bottom: 14px;
}

.popup_option_label {
  display: block;

  margin-bottom: 7px;

  font-size: 11px;
  line-height: 1.2;
}


/* Option Buttons */

.popup_option_buttons {
  display: flex;
  width: 100%;
}

.popup_option_button {
  flex: 1;

  height: 40px;

  padding: 0 10px;

  border: 1px solid #999999;
  background: #ffffff;

  font-size: 16px;
  font-weight: 400;

  cursor: pointer;

  margin-left: -1px;
}

.popup_option_button:first-child {
  margin-left: 0;
}

.popup_option_button.is-selected {
  border: 1px solid #000000;
  background: #ffffff;
  color: #000000;

  position: relative;
  z-index: 1;
}


/* Select */

.popup_select_wrapper {
  position: relative;
  width: 100%;
}

.popup_option_select {
  appearance: none;
  -webkit-appearance: none;

  width: 100%;

  padding: 0 32px 0 10px;

  border: 1px solid #999999;
  border-radius: 0;

  background: #ffffff;

  font-size: 16px;
  height: 40px;

  cursor: pointer;
}

.popup_select_arrow {
  position: absolute;
  right: 10px;
  top: 50%;

  transform: translateY(-50%);

  font-size: 14px;
  line-height: 1;

  pointer-events: none;
}


/* =========================================
   ADD TO CART
========================================= */

.popup_product_form {
  width: 100%;
}

.popup_add_to_cart {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 100%;
  width: 100%;
  height: 40px;

  margin-top: 50px;

  padding: 0 16px;

  border: 0;
  border-radius: 0;

  background: #000000;
  color: #ffffff;

  font-family: inherit;
  font-size: 11px;
  font-weight: 400;

  cursor: pointer;
}


.popup_add_to_cart:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.popup_add_to_cart_text {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}


body.quick-view-open {
  overflow: hidden;
}
  /* Mobile */
  @media only screen and (max-width: 989px) {

    {% if section.settings.section_padding_mobile != blank %}
      .custom-featured-grid {
        padding: {{ section.settings.section_padding_mobile }};
      }
    {% endif %}

    .section_heading h2 {
      font-size: 24px;
      margin: 0 0 20px 0;
      text-align: center;
    }

    /* 2 Products Per Row */
    .custom-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .custom-product-grid-item {
      width: 100%;
    }

    /* Mobile Image */
    .grid_image {
      width: 100%;
      height: 186.42px;
    }

    .grid_image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Mobile Quick View Position */
    .quick_view_btn {
      top: var(--quick-top-mb);
      bottom: var(--quick-bottom-mb);
      left: var(--quick-left-mb);
      right: var(--quick-right-mb);
    }
.popup_product_content{
 max-width: 310px;
}

    .product_popup {
    padding: 12px;
    max-width: 100%;
    left: 0;
    right: 0;
    box-sizing: border-box;
  }

  .product_popup_card {
    width: 100%;
    max-width: 100%;
    max-height: calc(100vh - 24px);

    overflow-y: auto;
  }

  

  .popup_product_title {
    font-size: 12px;
    margin-bottom: 8px;
  }

  .popup_product_price {
    font-size: 12px;
    margin-bottom: 12px;
  }

  .popup_product_description {
    font-size: 8px;
    line-height: 1.3;
    margin-bottom: 16px;
  }

  .popup_product_option {
    margin-bottom: 12px;
  }

  .popup_option_label {
    font-size: 9px;
    margin-bottom: 5px;
  }

  .popup_option_button {
    height: 40px;
    font-size: 16px;
  }

  .popup_add_to_cart {
    margin-top: 22px;
    padding: 0 10px;
  }


  .product_popup_close {
    top: 6px;
    right: 7px;

    width: 18px;
    height: 18px;

    font-size: 17px;
  }
  }
}
</style>


{% if section.settings.section_heading != blank %}
  <h2 class="custom-featured-grid-heading">
    {{ section.settings.section_heading }}
  </h2>
{% endif %}

<div
  class="custom-featured-grid"
  id="custom-featured-grid-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  {% for block in section.blocks %}

    {% if block.settings.product != blank %}

      {% assign product = block.settings.product %}

      <div
        class="custom-product-grid-item"
        style="
          --quick-top: {% if block.settings.top > 0 %}{{ block.settings.top }}%{% else %}auto{% endif %};
          --quick-bottom: {% if block.settings.bottom > 0 %}{{ block.settings.bottom }}%{% else %}auto{% endif %};
          --quick-left: {% if block.settings.left > 0 %}{{ block.settings.left }}%{% else %}auto{% endif %};
          --quick-right: {% if block.settings.right > 0 %}{{ block.settings.right }}%{% else %}auto{% endif %};

          --quick-top-mb: {% if block.settings.top_mb > 0 %}{{ block.settings.top_mb }}%{% else %}auto{% endif %};
          --quick-bottom-mb: {% if block.settings.bottom_mb > 0 %}{{ block.settings.bottom_mb }}%{% else %}auto{% endif %};
          --quick-left-mb: {% if block.settings.left_mb > 0 %}{{ block.settings.left_mb }}%{% else %}auto{% endif %};
          --quick-right-mb: {% if block.settings.right_mb > 0 %}{{ block.settings.right_mb }}%{% else %}auto{% endif %};
        "
        {{ block.shopify_attributes }}
      >

        <div class="grid_image">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              loading="lazy"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >
          {% endif %}
        </div>

        <!-- QUICK VIEW BUTTON -->
        <button
          type="button"
          class="quick_view_btn"
          id="quick_view_btn_{{ product.id }}"
          data-product-id="{{ product.id }}"
          aria-label="Quick view {{ product.title | escape }}"
          aria-expanded="false"
        >
          <img
            src="https://cdn.shopify.com/s/files/1/0740/2592/6742/files/plus-sign.svg?v=1786143487"
            alt="plus-icon"
          >
        </button>

        <!-- POPUP -->
        <div
          class="product_popup"
          id="product-popup-{{ product.id }}"
          data-product-id="{{ product.id }}"
          data-product-handle="{{ product.handle }}"
          aria-hidden="true"
        >
          {% render 'popup-card', product: product, section: section %}
        </div>

      </div>

    {% endif %}

  {% endfor %}
</div>


<!-- POPUP BACKDROP -->
<div
  class="custom-popup-backdrop"
  id="custom-popup-backdrop-{{ section.id }}"
  aria-hidden="true"
></div>


{% schema %}
{
  "name": "Custom Featured Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading"
    },
    {
      "type": "product",
      "id": "select_product",
      "label": "Auto Add Product",
      "info": "This product will be automatically added when Black and Medium are selected."
    },
    {
      "type": "text",
      "id": "section_padding_desktop",
      "label": "Section Padding (Desktop)",
      "info": "Write in this format (top right bottom left)"
    },
    {
      "type": "text",
      "id": "section_padding_mobile",
      "label": "Section Padding (Mobile)",
      "info": "Write in this format (top right bottom left)"
    }
  ],
  "blocks": [
    {
      "name": "Product",
      "type": "product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "header",
          "content": "Quick View Icon Position - Desktop"
        },
        {
          "type": "range",
          "id": "top",
          "label": "Top",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "bottom",
          "label": "Bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "left",
          "label": "Left",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "right",
          "label": "Right",
          "min": 0,
          "max": 100,
          "default": 0,
          "step": 1,
          "unit": "%"
        },
        {
          "type": "header",
          "content": "Quick View Icon Position - Mobile"
        },
        {
          "type": "range",
          "id": "top_mb",
          "label": "Top (Mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "bottom_mb",
          "label": "Bottom (Mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "left_mb",
          "label": "Left (Mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "right_mb",
          "label": "Right (Mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Grid"
    }
  ]
}
{% endschema %}


<style>
  /* ============================================
     POPUP BACKDROP
  ============================================ */

  .custom-popup-backdrop {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.45);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }

  .custom-popup-backdrop.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }


  /* ============================================
     POPUP
  ============================================ */

  .product_popup {
    position: fixed;
    z-index: 9999;

    top: 50%;
    left: 50%;

    width: min(92vw, 520px);
    max-height: 90vh;

    overflow-y: auto;

    background: #fff;

    transform: translate(-50%, -48%) scale(0.96);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      opacity 0.25s ease,
      visibility 0.25s ease,
      transform 0.25s ease;

    -webkit-overflow-scrolling: touch;
  }

  .product_popup.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translate(-50%, -50%) scale(1);
  }


  /* ============================================
     BODY LOCK WHEN POPUP IS OPEN
  ============================================ */

  body.custom-popup-open {
    overflow: hidden;
  }


  /* ============================================
     QUICK VIEW BUTTON
  ============================================ */

  .quick_view_btn {
    position: absolute;

    top: var(--quick-top);
    bottom: var(--quick-bottom);
    left: var(--quick-left);
    right: var(--quick-right);

    z-index: 5;

    cursor: pointer;

    border: 0;
    padding: 0;
    margin: 0;

    background: transparent;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quick_view_btn img {
    display: block;
    width: auto;
    height: auto;
  }


  /* ============================================
     ADD TO CART
  ============================================ */

  .popup_add_to_cart {
    cursor: pointer;
  }

  .popup_add_to_cart:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .popup_add_to_cart.is-loading {
    pointer-events: none;
    opacity: 0.7;
  }


  /* ============================================
     MOBILE
  ============================================ */

  @media screen and (max-width: 749px) {

    .quick_view_btn {
      top: var(--quick-top-mb);
      bottom: var(--quick-bottom-mb);
      left: var(--quick-left-mb);
      right: var(--quick-right-mb);
    }

    .product_popup {
      width: calc(100vw - 30px);
      max-height: 90vh;
    }

  }
</style>


<script>
(function () {

  'use strict';

  const sectionId = '{{ section.id }}';

  const section = document.getElementById(
    'custom-featured-grid-' + sectionId
  );

  const backdrop = document.getElementById(
    'custom-popup-backdrop-' + sectionId
  );

  if (!section || !backdrop) {
    return;
  }


  /* ============================================================
     AUTO ADDED PRODUCT DATA

     We output ALL variants of the configured auto product.

     JavaScript will find the exact Black + M variant.

     IMPORTANT:
     We do NOT use:
     selected_or_first_available_variant.id
     for the auto product.
  ============================================================ */

  const autoProduct = {
    {% if section.settings.select_product != blank %}

      id: {{ section.settings.select_product.id | json }},

      title: {{ section.settings.select_product.title | json }},

      variants: [
        {% for variant in section.settings.select_product.variants %}
          {
            id: {{ variant.id | json }},
            available: {{ variant.available | json }},
            option1: {{ variant.option1 | json }},
            option2: {{ variant.option2 | json }},
            option3: {{ variant.option3 | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]

    {% else %}

      null

    {% endif %}
  };


  /* ============================================================
     NORMALIZE VALUE
  ============================================================ */

  function normalize(value) {

    if (value === null || value === undefined) {
      return '';
    }

    return String(value)
      .trim()
      .toLowerCase();

  }


  /* ============================================================
     GET POPUP
  ============================================================ */

  function getPopup(productId) {

    return document.getElementById(
      'product-popup-' + productId
    );

  }


  /* ============================================================
     CLOSE ALL POPUPS
  ============================================================ */

  function closeAllPopups() {

    const popups = section.querySelectorAll('.product_popup');

    popups.forEach(function (popup) {

      popup.classList.remove('is-active');

      popup.setAttribute(
        'aria-hidden',
        'true'
      );

    });


    const buttons = section.querySelectorAll('.quick_view_btn');

    buttons.forEach(function (button) {

      button.setAttribute(
        'aria-expanded',
        'false'
      );

    });

  }


  /* ============================================================
     CLOSE POPUP
  ============================================================ */

  function closePopup() {

    closeAllPopups();

    backdrop.classList.remove('is-active');

    backdrop.setAttribute(
      'aria-hidden',
      'true'
    );

    document.body.classList.remove(
      'custom-popup-open'
    );

  }


  /* ============================================================
     OPEN POPUP
  ============================================================ */

  function openPopup(productId) {

    const popup = getPopup(productId);

    if (!popup) {
      return;
    }


    /*
      First close EVERYTHING.

      This guarantees that only one popup
      can ever remain open.
    */

    closeAllPopups();


    popup.classList.add('is-active');

    popup.setAttribute(
      'aria-hidden',
      'false'
    );


    const quickButton = section.querySelector(
      '.quick_view_btn[data-product-id="' + productId + '"]'
    );

    if (quickButton) {

      quickButton.setAttribute(
        'aria-expanded',
        'true'
      );

    }


    backdrop.classList.add('is-active');

    backdrop.setAttribute(
      'aria-hidden',
      'false'
    );

    document.body.classList.add(
      'custom-popup-open'
    );

  }


  /* ============================================================
     QUICK VIEW BUTTON CLICK
  ============================================================ */

  section.querySelectorAll('.quick_view_btn').forEach(
    function (button) {

      button.addEventListener(
        'click',
        function (event) {

          event.preventDefault();
          event.stopPropagation();

          const productId =
            button.getAttribute('data-product-id');

          openPopup(productId);

        }
      );

    }
  );


  /* ============================================================
     BACKDROP CLICK
  ============================================================ */

  backdrop.addEventListener(
    'click',
    function () {

      closePopup();

    }
  );


  /* ============================================================
     ESC KEY
  ============================================================ */

  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {

        const activePopup =
          section.querySelector('.product_popup.is-active');

        if (activePopup) {
          closePopup();
        }

      }

    }
  );


  /* ============================================================
     PRODUCT DATA

     Every popup gets its own product JSON.

     This allows us to find the correct variant ID
     without using a hidden form input.
  ============================================================ */

  section.querySelectorAll('.product_popup').forEach(
    function (popup) {

      const productDataElement =
        popup.querySelector('.popup-product-json');

      if (!productDataElement) {
        return;
      }


      try {

        const productData =
          JSON.parse(
            productDataElement.textContent
          );

        popup._productData = productData;

      } catch (error) {

        console.error(
          'Unable to read product variant data:',
          error
        );

      }

    }
  );


  /* ============================================================
     GET CURRENT SELECTED OPTIONS
  ============================================================ */

  function getSelectedOptions(popup) {

    const options = [];

    const selects =
      popup.querySelectorAll(
        '.popup_option_select'
      );

    selects.forEach(function (select) {

      options.push(
        select.value
      );

    });


    /*
      Buttons represent the other product options.
      Only the selected button is included.
    */

    const optionGroups =
      popup.querySelectorAll(
        '.popup_product_option'
      );

    optionGroups.forEach(function (group) {

      const index =
        parseInt(
          group.getAttribute('data-option-index'),
          10
        );

      /*
        If this option has a select, it has
        already been handled above.
      */

      const select =
        group.querySelector(
          '.popup_option_select'
        );

      if (select) {
        return;
      }


      const selectedButton =
        group.querySelector(
          '.popup_option_button.is-selected'
        );

      if (selectedButton) {

        options[index] =
          selectedButton.getAttribute(
            'data-option-value'
          );

      }

    });


    return options;

  }


  /* ============================================================
     FIND MAIN PRODUCT VARIANT
  ============================================================ */

  function findSelectedVariant(popup) {

    if (!popup._productData) {
      return null;
    }

    const product =
      popup._productData;

    const selectedOptions =
      getSelectedOptions(popup);


    if (!selectedOptions.length) {

      return product.selected_or_first_available_variant || null;

    }


    const variant =
      product.variants.find(
        function (variant) {

          return selectedOptions.every(
            function (selectedValue, index) {

              if (!selectedValue) {
                return false;
              }

              return normalize(
                variant.options[index]
              ) === normalize(
                selectedValue
              );

            }
          );

        }
      );


    return variant || null;

  }


  /* ============================================================
     UPDATE POPUP VARIANT
  ============================================================ */

  function updatePopupVariant(popup) {

    const variant =
      findSelectedVariant(popup);


    const addButton =
      popup.querySelector(
        '.popup_add_to_cart'
      );

    const price =
      popup.querySelector(
        '.popup_product_price'
      );


    if (!variant) {

      popup.dataset.selectedVariantId = '';

      if (addButton) {

        addButton.disabled = true;

        addButton.querySelector(
          '.popup_add_to_cart_text'
        ).firstChild.textContent =
          'UNAVAILABLE';

      }

      return;

    }


    /*
      Store the exact variant ID on the popup.

      NO hidden input.
    */

    popup.dataset.selectedVariantId =
      variant.id;


    /* Update price */

    if (price && variant.price) {

      const formattedPrice =
        Shopify.formatMoney(
          variant.price,
          window.Shopify?.money_format ||
          '${{amount}}'
        );

      price.innerHTML =
        formattedPrice;

    }


    /* Update Add To Cart button */

    if (addButton) {

      addButton.disabled =
        !variant.available;


      const text =
        addButton.querySelector(
          '.popup_add_to_cart_text'
        );

      if (text) {

        if (variant.available) {

          text.innerHTML =
            'ADD TO CART <span class="popup_add_to_cart_arrow"> &xrarr; </span>';

        } else {

          text.innerHTML =
            'SOLD OUT';

        }

      }

    }

  }


  /* ============================================================
     SELECT CHANGE
  ============================================================ */

  section.addEventListener(
    'change',
    function (event) {

      if (
        !event.target.classList.contains(
          'popup_option_select'
        )
      ) {
        return;
      }


      const popup =
        event.target.closest(
          '.product_popup'
        );

      if (!popup) {
        return;
      }


      updatePopupVariant(popup);

    }
  );


  /* ============================================================
     OPTION BUTTON CLICK
  ============================================================ */

  section.addEventListener(
    'click',
    function (event) {

      const optionButton =
        event.target.closest(
          '.popup_option_button'
        );

      if (!optionButton) {
        return;
      }


      event.preventDefault();


      const popup =
        optionButton.closest(
          '.product_popup'
        );

      if (!popup) {
        return;
      }


      const optionIndex =
        optionButton.getAttribute(
          'data-option-index'
        );


      /*
        Only buttons belonging to the same option
        are deselected.
      */

      popup.querySelectorAll(
        '.popup_option_button[data-option-index="' +
        optionIndex +
        '"]'
      ).forEach(
        function (button) {

          button.classList.remove(
            'is-selected'
          );

        }
      );


      optionButton.classList.add(
        'is-selected'
      );


      updatePopupVariant(popup);

    }
  );


  /* ============================================================
     FIND AUTO PRODUCT VARIANT
     
     IMPORTANT:
     
     We look for:
     
     BLACK
     +
     M / MEDIUM
     
     We DO NOT simply use the first variant.

     This solves the issue where:
     
     Main product = Black / M
     
     Auto product was previously added as:
     S / Black
  ============================================================ */

  function findAutoAddedVariant() {

    if (
      !autoProduct ||
      !autoProduct.variants ||
      !autoProduct.variants.length
    ) {
      return null;
    }


    const matchingVariant =
      autoProduct.variants.find(
        function (variant) {

          const values = [
            variant.option1,
            variant.option2,
            variant.option3
          ]
            .filter(Boolean)
            .map(normalize);


          const hasBlack =
            values.includes('black');


          const hasMedium =
            values.includes('m') ||
            values.includes('medium');


          return (
            hasBlack &&
            hasMedium &&
            variant.available
          );

        }
      );


    return matchingVariant || null;

  }


  /* ============================================================
     CHECK WHETHER MAIN PRODUCT IS BLACK + M
  ============================================================ */

  function isBlackMediumSelected(popup) {

    const selectedOptions =
      getSelectedOptions(popup);


    const normalizedOptions =
      selectedOptions
        .filter(Boolean)
        .map(normalize);


    const hasBlack =
      normalizedOptions.includes('black');


    const hasMedium =
      normalizedOptions.includes('m') ||
      normalizedOptions.includes('medium');


    return (
      hasBlack &&
      hasMedium
    );

  }


  /* ============================================================
     ADD TO SHOPIFY CART
  ============================================================ */

  async function addItemsToCart(items) {

    const response =
      await fetch(
        window.Shopify.routes.root +
        'cart/add.js',
        {
          method: 'POST',

          headers: {
            'Content-Type':
              'application/json',

            'Accept':
              'application/json'
          },

          body: JSON.stringify({
            items: items
          })
        }
      );


    const data =
      await response.json();


    if (!response.ok) {

      throw new Error(
        data.description ||
        data.message ||
        'Unable to add product to cart.'
      );

    }


    return data;

  }


  /* ============================================================
     UPDATE CART DRAWER / CART UI

     This dispatches Shopify's standard cart events.

     It does not depend on a product form.
  ============================================================ */

  function notifyCartUpdated() {

    document.dispatchEvent(
      new CustomEvent(
        'cart:updated',
        {
          bubbles: true
        }
      )
    );


    document.dispatchEvent(
      new CustomEvent(
        'cart:refresh',
        {
          bubbles: true
        }
      )
    );


    /*
      If the theme has a cart drawer element,
      try to refresh it using its standard methods.
    */

    const cartDrawer =
      document.querySelector(
        'cart-drawer'
      );

    if (
      cartDrawer &&
      typeof cartDrawer.renderContents === 'function'
    ) {

      fetch(
        window.Shopify.routes.root +
        'cart.js'
      )
        .then(
          function (response) {
            return response.json();
          }
        )
        .then(
          function (cart) {

            try {

              cartDrawer.renderContents(
                cart
              );

            } catch (error) {

              console.warn(
                'Cart drawer refresh failed:',
                error
              );

            }

          }
        );

    }

  }


  /* ============================================================
     ADD TO CART BUTTON
  ============================================================ */

  section.addEventListener(
    'click',
    async function (event) {

      const addButton =
        event.target.closest(
          '.popup_add_to_cart'
        );

      if (!addButton) {
        return;
      }


      event.preventDefault();


      if (addButton.disabled) {
        return;
      }


      const popup =
        addButton.closest(
          '.product_popup'
        );

      if (!popup) {
        return;
      }


      /*
        Get exact selected main product variant.
      */

      const mainVariantId =
        popup.dataset.selectedVariantId;


      if (!mainVariantId) {

        console.error(
          'No product variant selected.'
        );

        return;

      }


      /*
        Prevent double clicks.
      */

      if (
        addButton.classList.contains(
          'is-loading'
        )
      ) {
        return;
      }


      addButton.classList.add(
        'is-loading'
      );


      const originalText =
        addButton.querySelector(
          '.popup_add_to_cart_text'
        );


      if (originalText) {

        originalText.innerHTML =
          'ADDING...';

      }


      try {

        /*
          Main product is ALWAYS added.
        */

        const items = [
          {
            id: Number(mainVariantId),
            quantity: 1
          }
        ];


        /*
          If the user selected:
          
          Black + M
          
          then add the exact Black + M
          variant of the auto-added product.
        */

        if (
          autoProduct &&
          isBlackMediumSelected(popup)
        ) {

          const autoVariant =
            findAutoAddedVariant();


          if (autoVariant) {

            /*
              IMPORTANT:
              Only ONE variant ID is added.

              We are NOT adding the product ID.
              We are NOT adding all variants.
            */

            items.push({
              id: Number(autoVariant.id),
              quantity: 1
            });

          } else {

            console.warn(
              'Black + M was selected, but no available Black + M variant was found for the auto-added product.'
            );

          }

        }


        /*
          One AJAX request adds the main product
          and the matching auto-added variant.
        */

        await addItemsToCart(items);


        notifyCartUpdated();


        /*
          Close popup after successful add.
        */

        closePopup();


        /*
          Small delay before redirecting/opening cart,
          so the cart request has time to update.
        */

        /*
          If you want to stay on the page,
          remove the following block.
        */

        /*
        window.location.href =
          window.Shopify.routes.root + 'cart';
        */


      } catch (error) {

        console.error(
          'Add to cart error:',
          error
        );


        if (originalText) {

          originalText.innerHTML =
            'ADD TO CART <span class="popup_add_to_cart_arrow"> &xrarr; </span>';

        }


        alert(
          error.message ||
          'Something went wrong while adding the product to cart.'
        );

      } finally {

        addButton.classList.remove(
          'is-loading'
        );


        /*
          Recalculate the button state
          after adding.
        */

        updatePopupVariant(popup);

      }

    }
  );


  /* ============================================================
     INITIALIZE ALL POPUPS
  ============================================================ */

  section.querySelectorAll(
    '.product_popup'
  ).forEach(
    function (popup) {

      updatePopupVariant(popup);

    }
  );


})();
</script>