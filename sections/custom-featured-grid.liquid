{% if section.settings.section_heading != blank %}
  <div class="custom-featured-grid-heading">
    {{ section.settings.section_heading }}
  </div>
{% endif %}

<div
  class="custom-featured-grid-section"
  id="custom-featured-grid-{{ section.id }}"
  style="
    --section-padding-desktop: {{ section.settings.section_padding_desktop | default: '0' }};
    --section-padding-mobile: {{ section.settings.section_padding_mobile | default: '0' }};
  "
>

  <div class="custom-featured-grid">

    {% for block in section.blocks %}

      {% if block.settings.product != blank %}

        {% assign product = block.settings.product %}

        <div
          class="custom-product-grid-item"
          style="
            --quick-top: {% if block.settings.top > 0 %}{{ block.settings.top }}%{% else %}auto{% endif %};
            --quick-bottom: {% if block.settings.bottom > 0 %}{{ block.settings.bottom }}%{% else %}auto{% endif %};
            --quick-left: {% if block.settings.left > 0 %}{{ block.settings.left }}%{% else %}auto{% endif %};
            --quick-right: {% if block.settings.right > 0 %}{{ block.settings.right }}%{% else %}auto{% endif %};

            --quick-top-mb: {% if block.settings.top_mb > 0 %}{{ block.settings.top_mb }}%{% else %}auto{% endif %};
            --quick-bottom-mb: {% if block.settings.bottom_mb > 0 %}{{ block.settings.bottom_mb }}%{% else %}auto{% endif %};
            --quick-left-mb: {% if block.settings.left_mb > 0 %}{{ block.settings.left_mb }}%{% else %}auto{% endif %};
            --quick-right-mb: {% if block.settings.right_mb > 0 %}{{ block.settings.right_mb }}%{% else %}auto{% endif %};
          "
          {{ block.shopify_attributes }}
        >

          <div class="grid_image">
            {% if product.featured_image != blank %}
              <img
                src="{{ product.featured_image | image_url: width: 1600 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >
            {% endif %}
          </div>

          <button
            type="button"
            class="quick_view_btn"
            id="quick_view_btn_{{ product.id }}"
            data-product-id="{{ product.id }}"
            aria-label="Quick view {{ product.title | escape }}"
            aria-controls="product-popup-{{ product.id }}"
            aria-expanded="false"
          >
            <img
              src="https://cdn.shopify.com/s/files/1/0740/2592/6742/files/plus-sign.svg?v=1786143487"
              alt=""
              width="24"
              height="24"
            >
          </button>

          <div
            class="product_popup"
            id="product-popup-{{ product.id }}"
            data-product-id="{{ product.id }}"
            aria-hidden="true"
          >

            <div class="popup_overlay" data-popup-close></div>

            <div
              class="popup_inner"
              role="dialog"
              aria-modal="true"
              aria-label="{{ product.title | escape }}"
            >

              <button
                type="button"
                class="popup_close"
                data-popup-close
                aria-label="Close"
              >
                &times;
              </button>

              <div class="popup_content">

                <div class="popup_product_image">
                  {% if product.featured_image != blank %}
                    <img
                      src="{{ product.featured_image | image_url: width: 1200 }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      loading="lazy"
                    >
                  {% endif %}
                </div>

                <div class="popup_product_details">

                  {% render 'popup-card',
                    product: product,
                    section: section
                  %}

                </div>

              </div>

            </div>

          </div>

        </div>

      {% endif %}

    {% endfor %}

  </div>

</div>


<style>
  #custom-featured-grid-{{ section.id }} {
    padding: {{ section.settings.section_padding_desktop | default: '0' }};
  }

  #custom-featured-grid-{{ section.id }} .custom-featured-grid-heading {
    margin-bottom: 30px;
  }

  #custom-featured-grid-{{ section.id }} .custom-featured-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  #custom-featured-grid-{{ section.id }} .custom-product-grid-item {
    position: relative;
    overflow: visible;
  }

  #custom-featured-grid-{{ section.id }} .grid_image {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  #custom-featured-grid-{{ section.id }} .grid_image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /*
   * QUICK VIEW BUTTON
   */

  #custom-featured-grid-{{ section.id }} .quick_view_btn {
    position: absolute;

    top: var(--quick-top);
    bottom: var(--quick-bottom);
    left: var(--quick-left);
    right: var(--quick-right);

    z-index: 5;

    width: 45px;
    height: 45px;

    padding: 0;
    margin: 0;

    border: 0;
    background: transparent;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  #custom-featured-grid-{{ section.id }} .quick_view_btn img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /*
   * POPUP
   */

  #custom-featured-grid-{{ section.id }} .product_popup {
    position: fixed;
    inset: 0;

    z-index: 999999;

    display: none;

    width: 100%;
    height: 100%;

    align-items: center;
    justify-content: center;
  }

  #custom-featured-grid-{{ section.id }} .product_popup.is-open {
    display: flex;
  }

  #custom-featured-grid-{{ section.id }} .popup_overlay {
    position: absolute;
    inset: 0;

    background: rgba(0, 0, 0, 0.55);

    cursor: pointer;
  }

  #custom-featured-grid-{{ section.id }} .popup_inner {
    position: relative;

    z-index: 2;

    width: min(900px, calc(100% - 30px));
    max-height: calc(100vh - 30px);

    overflow-y: auto;

    background: #fff;

    border-radius: 10px;

    padding: 30px;

    box-sizing: border-box;

    animation: customPopupOpen 0.2s ease;
  }

  @keyframes customPopupOpen {
    from {
      opacity: 0;
      transform: translateY(15px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  #custom-featured-grid-{{ section.id }} .popup_close {
    position: absolute;

    top: 12px;
    right: 15px;

    z-index: 10;

    width: 35px;
    height: 35px;

    padding: 0;

    border: 0;

    background: transparent;

    font-size: 30px;
    line-height: 1;

    cursor: pointer;
  }

  #custom-featured-grid-{{ section.id }} .popup_content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);

    gap: 35px;

    align-items: center;
  }

  #custom-featured-grid-{{ section.id }} .popup_product_image img {
    display: block;

    width: 100%;
    height: auto;

    max-height: 550px;

    object-fit: contain;
  }

  /*
   * POPUP PRODUCT INFO
   */

  #custom-featured-grid-{{ section.id }} .popup_product_title {
    margin: 0 0 12px;

    font-size: 28px;
    line-height: 1.2;
  }

  #custom-featured-grid-{{ section.id }} .popup_product_price {
    margin-bottom: 15px;

    font-size: 20px;
    font-weight: 600;
  }

  #custom-featured-grid-{{ section.id }} .popup_product_description {
    margin-bottom: 25px;

    font-size: 14px;
    line-height: 1.6;
  }

  #custom-featured-grid-{{ section.id }} .popup_product_option {
    margin-bottom: 20px;
  }

  #custom-featured-grid-{{ section.id }} .popup_option_label {
    display: block;

    margin-bottom: 8px;

    font-size: 14px;
    font-weight: 600;
  }

  #custom-featured-grid-{{ section.id }} .popup_select_wrapper {
    position: relative;
  }

  #custom-featured-grid-{{ section.id }} .popup_option_select {
    width: 100%;

    min-height: 46px;

    padding: 10px 40px 10px 14px;

    border: 1px solid #ccc;
    border-radius: 4px;

    background: #fff;

    appearance: none;

    cursor: pointer;
  }

  #custom-featured-grid-{{ section.id }} .popup_select_arrow {
    position: absolute;

    top: 50%;
    right: 14px;

    transform: translateY(-50%);

    pointer-events: none;
  }

  #custom-featured-grid-{{ section.id }} .popup_option_buttons {
    display: flex;
    flex-wrap: wrap;

    gap: 8px;
  }

  #custom-featured-grid-{{ section.id }} .popup_option_button {
    min-width: 50px;

    padding: 10px 15px;

    border-top: 1px solid #ccc;
    border-right: 1px solid #ccc;
    border-bottom: 1px solid #ccc;

    background: #fff;

    cursor: pointer;

    transition: 0.2s ease;
  }

  #custom-featured-grid-{{ section.id }} .popup_option_button:hover,
  #custom-featured-grid-{{ section.id }} .popup_option_button.is-selected {
    background: #111;
    color: #fff;
  }

  #custom-featured-grid-{{ section.id }} .popup_add_to_cart {
    width: 100%;

    min-height: 50px;

    margin-top: 10px;

    cursor: pointer;
  }

  #custom-featured-grid-{{ section.id }} .popup_add_to_cart:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /*
   * MOBILE
   */

  @media screen and (max-width: 749px) {

    #custom-featured-grid-{{ section.id }} {
      padding: {{ section.settings.section_padding_mobile | default: '0' }};
    }

    #custom-featured-grid-{{ section.id }} .custom-featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    #custom-featured-grid-{{ section.id }} .quick_view_btn {
      top: var(--quick-top-mb);
      bottom: var(--quick-bottom-mb);
      left: var(--quick-left-mb);
      right: var(--quick-right-mb);
    }

    #custom-featured-grid-{{ section.id }} .popup_inner {
      width: calc(100% - 20px);
      max-height: calc(100vh - 20px);

      padding: 20px;
    }

    #custom-featured-grid-{{ section.id }} .popup_content {
      grid-template-columns: 1fr;

      gap: 20px;
    }

    #custom-featured-grid-{{ section.id }} .popup_product_image img {
      max-height: 300px;
    }

    #custom-featured-grid-{{ section.id }} .popup_product_title {
      font-size: 22px;
    }

  }

  @media screen and (max-width: 480px) {

    #custom-featured-grid-{{ section.id }} .custom-featured-grid {
      grid-template-columns: 1fr;
    }

  }
</style>


<script>
(function () {

  'use strict';

  /*
   * ------------------------------------------------------------
   * SECTION POPUP + PRODUCT VARIANT HANDLER
   * ------------------------------------------------------------
   */

  const sectionRoot =
    document.getElementById(
      'custom-featured-grid-{{ section.id }}'
    );

  if (!sectionRoot) {
    return;
  }


  /*
   * ------------------------------------------------------------
   * OPEN / CLOSE POPUP
   * ------------------------------------------------------------
   */

  function openPopup(popup, button) {

    if (!popup) {
      return;
    }

    popup.classList.add('is-open');

    popup.setAttribute(
      'aria-hidden',
      'false'
    );

    if (button) {
      button.setAttribute(
        'aria-expanded',
        'true'
      );
    }

    document.documentElement.classList.add(
      'custom-popup-open'
    );

  }


  function closePopup(popup) {

    if (!popup) {
      return;
    }

    popup.classList.remove('is-open');

    popup.setAttribute(
      'aria-hidden',
      'true'
    );

    const productId =
      popup.dataset.productId;

    const button =
      sectionRoot.querySelector(
        '.quick_view_btn[data-product-id="' +
        productId +
        '"]'
      );

    if (button) {
      button.setAttribute(
        'aria-expanded',
        'false'
      );
    }

    document.documentElement.classList.remove(
      'custom-popup-open'
    );

  }


  /*
   * Open buttons
   */

  sectionRoot
    .querySelectorAll('.quick_view_btn')
    .forEach(function (button) {

      button.addEventListener(
        'click',
        function (event) {

          event.preventDefault();

          const productId =
            button.dataset.productId;

          const popup =
            sectionRoot.querySelector(
              '.product_popup[data-product-id="' +
              productId +
              '"]'
            );

          openPopup(
            popup,
            button
          );

        }
      );

    });


  /*
   * Close buttons + overlay
   */

  sectionRoot
    .querySelectorAll('[data-popup-close]')
    .forEach(function (element) {

      element.addEventListener(
        'click',
        function () {

          const popup =
            element.closest('.product_popup');

          closePopup(popup);

        }
      );

    });


  /*
   * Escape key
   */

  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key !== 'Escape') {
        return;
      }

      sectionRoot
        .querySelectorAll(
          '.product_popup.is-open'
        )
        .forEach(function (popup) {

          closePopup(popup);

        });

    }
  );


  /*
   * ------------------------------------------------------------
   * PRODUCT VARIANTS
   * ------------------------------------------------------------
   */

  function initPopupVariants() {

    const forms =
      sectionRoot.querySelectorAll(
        '.popup_product_form'
      );


    forms.forEach(function (form) {

      /*
       * Don't initialize the same form twice.
       */

      if (
        form.dataset.variantHandlerInitialized ===
        'true'
      ) {
        return;
      }

      form.dataset.variantHandlerInitialized =
        'true';


      const popup =
        form.closest('.product_popup');


      if (!popup) {
        return;
      }


      const variantInput =
        form.querySelector(
          '.popup_variant_id'
        );


      const addToCartButton =
        form.querySelector(
          '.popup_add_to_cart'
        );


      const variantJson =
        popup.querySelector(
          '.popup-product-variants'
        );


      if (
        !variantInput ||
        !variantJson
      ) {
        console.error(
          'Popup variant data is missing.',
          form
        );

        return;
      }


      let variants = [];


      try {

        variants =
          JSON.parse(
            variantJson.textContent
          );

      } catch (error) {

        console.error(
          'Unable to parse product variants:',
          error
        );

        return;

      }


      /*
       * --------------------------------------------------------
       * GET SELECTED OPTIONS
       * --------------------------------------------------------
       */

      function getSelectedOptions() {

        const options = [];


        /*
         * Select dropdowns
         */

        form
          .querySelectorAll(
            '.popup_option_select'
          )
          .forEach(function (select) {

            const index =
              parseInt(
                select.dataset.optionIndex,
                10
              );

            options[index] =
              select.value;

          });


        /*
         * Button options
         */

        form
          .querySelectorAll(
            '.popup_option_button.is-selected'
          )
          .forEach(function (button) {

            const index =
              parseInt(
                button.dataset.optionIndex,
                10
              );

            options[index] =
              button.dataset.optionValue;

          });


        return options;

      }


      /*
       * --------------------------------------------------------
       * FIND EXACT PRODUCT VARIANT
       * --------------------------------------------------------
       */

      function findVariant(options) {

        if (!Array.isArray(options)) {
          return null;
        }


        return variants.find(
          function (variant) {

            if (
              !variant.options ||
              variant.options.length !==
              options.length
            ) {
              return false;
            }


            return variant.options.every(
              function (
                value,
                index
              ) {

                return (
                  String(value)
                    .trim()
                    .toLowerCase() ===

                  String(
                    options[index]
                  )
                    .trim()
                    .toLowerCase()
                );

              }
            );

          }
        ) || null;

      }


      /*
       * --------------------------------------------------------
       * UPDATE CURRENT VARIANT
       * --------------------------------------------------------
       */

      function updateVariant() {

        const options =
          getSelectedOptions();


        /*
         * Don't try to match incomplete
         * option selections.
         */

        if (
          options.length !==
          variants[0]?.options?.length ||
          options.some(
            function (value) {
              return value === undefined;
            }
          )
        ) {

          variantInput.value = '';

          if (addToCartButton) {
            addToCartButton.disabled = true;
          }

          return;

        }


        const variant =
          findVariant(options);


        if (!variant) {

          variantInput.value = '';

          if (addToCartButton) {

            addToCartButton.disabled =
              true;

            const text =
              addToCartButton.querySelector(
                '.popup_add_to_cart_text'
              );

            if (text) {
              text.textContent =
                'UNAVAILABLE';
            }

          }

          return;

        }


        /*
         * THIS IS THE IMPORTANT PART.
         *
         * Shopify receives the exact selected
         * variant ID.
         */

        variantInput.value =
          variant.id;


        form.dataset.selectedOptions =
          JSON.stringify(options);


        /*
         * Availability
         */

        if (addToCartButton) {

          const text =
            addToCartButton.querySelector(
              '.popup_add_to_cart_text'
            );


          if (variant.available) {

            addToCartButton.disabled =
              false;

            if (text) {

              text.innerHTML =
                'ADD TO CART <span class="popup_add_to_cart_arrow">&xrarr;</span>';

            }

          } else {

            addToCartButton.disabled =
              true;

            if (text) {
              text.textContent =
                'SOLD OUT';
            }

          }

        }


        /*
         * Update price
         */

        const priceElement =
          popup.querySelector(
            '.popup_product_price'
          );


        if (
          priceElement &&
          variant.price !== undefined
        ) {

          priceElement.innerHTML =
            Shopify.formatMoney(
              variant.price,
              {{ shop.money_format | json }}
            );

        }


      }


      /*
       * --------------------------------------------------------
       * DROPDOWN CHANGE
       * --------------------------------------------------------
       */

      form
        .querySelectorAll(
          '.popup_option_select'
        )
        .forEach(function (select) {

          select.addEventListener(
            'change',
            function () {

              updateVariant();

            }
          );

        });


      /*
       * --------------------------------------------------------
       * OPTION BUTTONS
       * --------------------------------------------------------
       */

      form
        .querySelectorAll(
          '.popup_option_button'
        )
        .forEach(function (button) {

          button.addEventListener(
            'click',
            function (event) {

              event.preventDefault();


              const optionIndex =
                button.dataset.optionIndex;


              form
                .querySelectorAll(
                  '.popup_option_button[data-option-index="' +
                  optionIndex +
                  '"]'
                )
                .forEach(
                  function (otherButton) {

                    otherButton.classList.remove(
                      'is-selected'
                    );

                  }
                );


              button.classList.add(
                'is-selected'
              );


              updateVariant();

            }
          );

        });


      /*
       * --------------------------------------------------------
       * INITIAL VARIANT
       * --------------------------------------------------------
       */

      updateVariant();


      /*
       * --------------------------------------------------------
       * ADD TO CART
       * --------------------------------------------------------
       */

      form.addEventListener(
        'submit',
        async function (event) {

          event.preventDefault();


          if (
            form.dataset.submitting ===
            'true'
          ) {
            return;
          }


          const options =
            getSelectedOptions();


          const selectedVariant =
            findVariant(options);


          if (!selectedVariant) {

            alert(
              'Please select a valid product variant.'
            );

            return;

          }


          /*
           * Always update hidden input immediately
           * before adding.
           */

          variantInput.value =
            selectedVariant.id;


          form.dataset.submitting =
            'true';


          if (addToCartButton) {
            addToCartButton.disabled =
              true;
          }


          try {

            /*
             * ------------------------------------------------
             * MAIN PRODUCT
             * ------------------------------------------------
             */

            const cartItems = [
              {
                id: Number(
                  selectedVariant.id
                ),
                quantity: 1
              }
            ];


            /*
             * ------------------------------------------------
             * AUTOMATIC PRODUCT
             * ------------------------------------------------
             */

            const autoProductJson =
              popup.querySelector(
                '.popup-auto-product-data'
              );


            if (autoProductJson) {

              let autoProduct =
                null;


              try {

                autoProduct =
                  JSON.parse(
                    autoProductJson.textContent
                  );

              } catch (error) {

                console.error(
                  'Unable to parse automatic product:',
                  error
                );

              }


              if (
                autoProduct &&
                autoProduct.variants
              ) {

                /*
                 * Check selected values.
                 */

                const normalizedOptions =
                  options.map(
                    function (value) {

                      return String(value)
                        .trim()
                        .toLowerCase();

                    }
                  );


                const hasBlack =
                  normalizedOptions.includes(
                    'black'
                  );


                const hasMedium =
                  normalizedOptions.includes(
                    'medium'
                  );


                /*
                 * ONLY Black + Medium triggers
                 * the automatic product.
                 */

                if (
                  hasBlack &&
                  hasMedium
                ) {

                  const autoVariant =
                    findAutoProductVariant(
                      autoProduct
                    );


                  if (autoVariant) {

                    /*
                     * Don't add the same product
                     * twice.
                     */

                    if (
                      Number(
                        autoProduct.product_id
                      ) !==
                      Number(
                        selectedVariant.product_id
                      )
                    ) {

                      cartItems.push({
                        id: Number(
                          autoVariant.id
                        ),
                        quantity: 1
                      });


                      console.log(
                        'AUTO PRODUCT ADDED:',
                        autoProduct.title,
                        autoVariant.id,
                        autoVariant.options
                      );

                    }

                  } else {

                    console.warn(
                      'Black + Medium selected, but the automatic product does not have a Black + Medium variant.'
                    );

                  }

                }

              }

            }


            /*
             * ------------------------------------------------
             * ADD BOTH PRODUCTS IN ONE REQUEST
             * ------------------------------------------------
             */

            const response =
              await fetch(
                window.Shopify.routes.root +
                'cart/add.js',
                {
                  method: 'POST',

                  headers: {
                    'Content-Type':
                      'application/json',

                    'Accept':
                      'application/json'
                  },

                  body: JSON.stringify({
                    items: cartItems
                  })
                }
              );


            const data =
              await response.json();


            if (!response.ok) {

              throw new Error(
                data.description ||
                data.message ||
                'Unable to add product to cart.'
              );

            }


            console.log(
              'CART ITEMS ADDED:',
              cartItems
            );


            /*
             * ------------------------------------------------
             * CLOSE POPUP
             * ------------------------------------------------
             */

            closePopup(popup);


            /*
             * ------------------------------------------------
             * OPEN / REFRESH CART DRAWER
             * ------------------------------------------------
             */

            await refreshCart();


          } catch (error) {

            console.error(
              'Add to cart error:',
              error
            );


            alert(
              error.message ||
              'Unable to add product to cart.'
            );


          } finally {

            form.dataset.submitting =
              'false';

            updateVariant();

          }

        }
      );

    });

  }


  /*
   * ------------------------------------------------------------
   * AUTOMATIC PRODUCT VARIANT MATCHER
   * ------------------------------------------------------------
   *
   * This specifically finds:
   *
   * BLACK + MEDIUM
   *
   * regardless of whether the automatic product
   * has:
   *
   * Color / Size
   *
   * or
   *
   * Size / Color
   *
   * ------------------------------------------------------------
   */

  function findAutoProductVariant(
    autoProduct
  ) {

    if (
      !autoProduct ||
      !Array.isArray(
        autoProduct.variants
      )
    ) {
      return null;
    }


    /*
     * First: exact variant containing
     * BOTH Black and Medium.
     */

    const matchingVariant =
      autoProduct.variants.find(
        function (variant) {

          if (
            !variant.options ||
            !Array.isArray(
              variant.options
            )
          ) {
            return false;
          }


          const values =
            variant.options.map(
              function (value) {

                return String(value)
                  .trim()
                  .toLowerCase();

              }
            );


          return (
            values.includes('black') &&
            values.includes('medium')
          );

        }
      );


    if (matchingVariant) {
      return matchingVariant;
    }


    return null;

  }


  /*
   * ------------------------------------------------------------
   * CART REFRESH
   * ------------------------------------------------------------
   */

  async function refreshCart() {

    /*
     * Get current cart first.
     */

    let cart = null;


    try {

      const response =
        await fetch(
          window.Shopify.routes.root +
          'cart.js',
          {
            headers: {
              'Accept':
                'application/json'
            }
          }
        );


      cart =
        await response.json();

    } catch (error) {

      console.warn(
        'Unable to fetch cart:',
        error
      );

    }


    /*
     * Dispatch events for themes/apps.
     */

    document.dispatchEvent(
      new CustomEvent(
        'cart:updated',
        {
          detail: {
            cart: cart
          }
        }
      )
    );


    document.dispatchEvent(
      new CustomEvent(
        'cart:refresh'
      )
    );


    document.dispatchEvent(
      new CustomEvent(
        'ajaxProduct:added',
        {
          detail: {
            cart: cart
          }
        }
      )
    );


    /*
     * Try Shopify cart drawer.
     */

    const cartDrawer =
      document.querySelector(
        'cart-drawer'
      );


    if (
      cartDrawer &&
      typeof cartDrawer.renderContents ===
      'function'
    ) {

      try {

        cartDrawer.renderContents(
          cart
        );

      } catch (error) {

        console.warn(
          'Cart drawer render failed:',
          error
        );

      }

    }


    /*
     * Try common cart drawer open methods.
     */

    if (cartDrawer) {

      if (
        typeof cartDrawer.open ===
        'function'
      ) {

        cartDrawer.open();

        return;

      }


      if (
        typeof cartDrawer.setActiveElement ===
        'function'
      ) {

        try {
          cartDrawer.setActiveElement(
            document.activeElement
          );
        } catch (e) {}

      }

    }


    /*
     * Try cart notification.
     */

    const cartNotification =
      document.querySelector(
        'cart-notification'
      );


    if (
      cartNotification &&
      typeof cartNotification.open ===
      'function'
    ) {

      try {

        cartNotification.open();

        return;

      } catch (error) {}

    }

  }


  /*
   * ------------------------------------------------------------
   * INITIALIZE
   * ------------------------------------------------------------
   */

  initPopupVariants();


  /*
   * Shopify Theme Editor
   */

  document.addEventListener(
    'shopify:section:load',
    function (event) {

      if (
        event.target &&
        event.target.id ===
        'custom-featured-grid-{{ section.id }}'
      ) {

        initPopupVariants();

      }

    }
  );

})();
</script>


