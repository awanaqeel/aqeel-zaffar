<style>
  #shopify-section-{{ section.id }}{
  {% if section.settings.section_padding_desktop != blank %}
    .custom-featured-grid {
      padding: {{ section.settings.section_padding_desktop }};
    }
  {% endif %}

  .section_heading h2 {
    font-family: 'Lustria';
    font-weight: 400;
    font-size: 36px;
    line-height: 120%;
    letter-spacing: 0;
    margin: 0 0 30px 0;
  }

  /* Product Grid */
  .custom-product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
  }

   .custom-banner__button {
    width: 100%;
    max-width: 100%;
    position: relative;
    overflow: hidden;
    font-weight: 400;
    font-size: 16px;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    color:#fff;
    background-color: #000;
    padding: 12px 39px;
    max-width: 220px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1;
  }
  .popup_add_to_cart_text, .popup_add_to_cart_arrow {
  font-weight: 400;
    font-size: 16px;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-align: center;
    text-transform: uppercase;
  }

  .custom-banner__button::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #FFF544;
    transform: translateX(-100%);
    transition: transform 0.4s ease;
    z-index: -1;
  }

  .custom-banner__button .popup_add_to_cart_arrow {
    margin-left: 10px;
    position: relative;
    z-index: 2;
  }

  .custom-banner__button:hover::before {
    transform: translateX(0);
  }

  .custom-banner__button:hover {
    color: #000;
  }

  /* Product Grid Item */
  .custom-product-grid-item {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  /* Product Image */
  .grid_image {
    width: 100%;
    height: 444px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .grid_image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Quick View Button */
  .quick_view_btn {
    position: absolute;

    /* Desktop Position */
    top: var(--quick-top);
    bottom: var(--quick-bottom);
    left: var(--quick-left);
    right: var(--quick-right);

    width: 16px;
    height: 16px;

    background: #F8F8F8E5;
    border-radius: 50%;
    box-shadow: 0px 3px 4px 0px #00000033;

    display: flex;
    justify-content: center;
    align-items: center;

    z-index: 5;
    box-sizing: border-box;
  }

  .quick_view_btn img {
    width: 8px;
    height: 8px;
    display: block;
  }

  /* =========================================
   QUICK VIEW POPUP
========================================= */

.product_popup {
  position: fixed;
  width: 100%;
  inset: 0;
  left: 0%;
  right: 0%;
  height: 100%;
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

.product_popup.is-open {
  display: flex;
}


/* Overlay */

.product_popup_overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.35);
}


/* Popup Card */

.product_popup_card {
  position: relative;
  width: min(700px, calc(100% - 40px));
  max-height: calc(100vh - 40px);
  background: #ffffff;
  z-index: 2;
  overflow: hidden;
  box-sizing: border-box;
}


/* Close Button */

.product_popup_close {
  position: absolute;
  top: 10px;
  right: 10px;

  width: 24px;
  height: 24px;

  padding: 0;
  border: 0;
  background: transparent;

  font-size: 22px;
  font-weight: 300;
  line-height: 24px;

  cursor: pointer;
  z-index: 10;

  display: flex;
  align-items: center;
  justify-content: center;
}


/* =========================================
   POPUP CONTENT
========================================= */

.popup_product_content {
  width: 100%;
  background-color: #fff;
  padding: 25px 20px;
  position: relative;
  max-width: 310px;
}
.close_popup{
  width: max-content;
    position: absolute;
    top: 2%;
    right: 2%;
    cursor:pointer;
}
.image_with_info{
  display: flex;
  flex-wrap: nowrap;
  justify-content: center;
  align-items: flex-start;
  margin-bottom: 10px;
  gap: 8px;
}


/* Product Image */

.popup_product_image {
  width: 100%;
  height: 120px;
}

.popup_product_image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}



/* Product Title */

.popup_product_title {
  font-weight: 300;
  font-size: 16px;
  line-height: 120%;
  letter-spacing: 0px;
  margin: 0 0 13px 0;
}


/* Price */

.popup_product_price {
  font-family: 'Lustria';
  font-weight: 400;
  font-size: 16px;
  line-height: 120%;
  letter-spacing: 0px;
  margin: 0 0 13px 0;
  color: #000;
}


/* Description */

.popup_product_description {
  font-weight: 300;
  font-size: 12px;
  line-height: 110%;
  letter-spacing: -1%;
  color: #000;
}


/* =========================================
   OPTIONS
========================================= */

.popup_product_option {
  margin-bottom: 14px;
}

.popup_option_label {
  display: block;

  margin-bottom: 7px;

  font-size: 11px;
  line-height: 1.2;
}


/* Option Buttons */

.popup_option_buttons {
  display: flex;
  width: 100%;
}

.popup_option_button {
  flex: 1;

  height: 40px;

  padding: 0 10px;

  border: 1px solid #999999;
  background: #ffffff;

  font-size: 16px;
  font-weight: 400;

  cursor: pointer;

  margin-left: -1px;
}

.popup_option_button:first-child {
  margin-left: 0;
}

.popup_option_button.is-selected {
  border: 1px solid #000000;
  background: #ffffff;
  color: #000000;

  position: relative;
  z-index: 1;
}


/* Select */

.popup_select_wrapper {
  position: relative;
  width: 100%;
}

.popup_option_select {
  appearance: none;
  -webkit-appearance: none;

  width: 100%;

  padding: 0 32px 0 10px;

  border: 1px solid #999999;
  border-radius: 0;

  background: #ffffff;

  font-size: 16px;
  height: 40px;

  cursor: pointer;
}

.popup_select_arrow {
  position: absolute;
  right: 10px;
  top: 50%;

  transform: translateY(-50%);

  font-size: 14px;
  line-height: 1;

  pointer-events: none;
}


/* =========================================
   ADD TO CART
========================================= */

.popup_product_form {
  width: 100%;
}

.popup_add_to_cart {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 100%;
  width: 100%;
  height: 40px;

  margin-top: 50px;

  padding: 0 16px;

  border: 0;
  border-radius: 0;

  background: #000000;
  color: #ffffff;

  font-family: inherit;
  font-size: 11px;
  font-weight: 400;

  cursor: pointer;
}


.popup_add_to_cart:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.popup_add_to_cart_text {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}


body.quick-view-open {
  overflow: hidden;
}
  /* Mobile */
  @media only screen and (max-width: 989px) {

    {% if section.settings.section_padding_mobile != blank %}
      .custom-featured-grid {
        padding: {{ section.settings.section_padding_mobile }};
      }
    {% endif %}

    .section_heading h2 {
      font-size: 24px;
      margin: 0 0 20px 0;
      text-align: center;
    }

    /* 2 Products Per Row */
    .custom-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .custom-product-grid-item {
      width: 100%;
    }

    /* Mobile Image */
    .grid_image {
      width: 100%;
      height: 186.42px;
    }

    .grid_image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Mobile Quick View Position */
    .quick_view_btn {
      top: var(--quick-top-mb);
      bottom: var(--quick-bottom-mb);
      left: var(--quick-left-mb);
      right: var(--quick-right-mb);
    }
.popup_product_content{
 max-width: 310px;
}

    .product_popup {
    padding: 12px;
    max-width: 100%;
    left: 0;
    right: 0;
    box-sizing: border-box;
  }

  .product_popup_card {
    width: 100%;
    max-width: 100%;
    max-height: calc(100vh - 24px);

    overflow-y: auto;
  }

  

  .popup_product_title {
    font-size: 12px;
    margin-bottom: 8px;
  }

  .popup_product_price {
    font-size: 12px;
    margin-bottom: 12px;
  }

  .popup_product_description {
    font-size: 8px;
    line-height: 1.3;
    margin-bottom: 16px;
  }

  .popup_product_option {
    margin-bottom: 12px;
  }

  .popup_option_label {
    font-size: 9px;
    margin-bottom: 5px;
  }

  .popup_option_button {
    height: 40px;
    font-size: 16px;
  }

  .popup_add_to_cart {
    margin-top: 22px;
    padding: 0 10px;
  }


  .product_popup_close {
    top: 6px;
    right: 7px;

    width: 18px;
    height: 18px;

    font-size: 17px;
  }
  }
}
</style>


<div class="page-width custom-featured-grid">

  {% if section.settings.section_heading != blank %}
    <div class="section_heading">
      <h2>{{ section.settings.section_heading }}</h2>
    </div>
  {% endif %}


  <div class="custom-product-grid">

    {% for block in section.blocks %}

      {% if block.settings.product != blank %}

        {% assign product = block.settings.product %}

        <div
          class="custom-product-grid-item"
          style="
            --quick-top: {% if block.settings.top > 0 %}{{ block.settings.top }}%{% else %}auto{% endif %};
            --quick-bottom: {% if block.settings.bottom > 0 %}{{ block.settings.bottom }}%{% else %}auto{% endif %};
            --quick-left: {% if block.settings.left > 0 %}{{ block.settings.left }}%{% else %}auto{% endif %};
            --quick-right: {% if block.settings.right > 0 %}{{ block.settings.right }}%{% else %}auto{% endif %};

            --quick-top-mb: {% if block.settings.top_mb > 0 %}{{ block.settings.top_mb }}%{% else %}auto{% endif %};
            --quick-bottom-mb: {% if block.settings.bottom_mb > 0 %}{{ block.settings.bottom_mb }}%{% else %}auto{% endif %};
            --quick-left-mb: {% if block.settings.left_mb > 0 %}{{ block.settings.left_mb }}%{% else %}auto{% endif %};
            --quick-right-mb: {% if block.settings.right_mb > 0 %}{{ block.settings.right_mb }}%{% else %}auto{% endif %};
          "
          {{ block.shopify_attributes }}
        >

          <div class="grid_image">
            <img
              src="{{ product.featured_image | img_url: 'master' }}"
              alt="{{ product.featured_image.alt | escape }}"
              loading="lazy"
            >
          </div>

          <div class="quick_view_btn" id="quick_view_btn_{{ product.id }}" data-product-id="{{  product.id }}" aria-label="Quick view {{ product.title | escape }}">
            <img
              src="https://cdn.shopify.com/s/files/1/0740/2592/6742/files/plus-sign.svg?v=1786143487"
              alt="plus-icon"
            >
          </div>
          <div class="product_popup" id="product-popup-{{  product.id }}" data-product-id="{{  product.id }}" aria-hidden="true">
            {% render 'popup-card', product: product, section: section %}
          </div>

        </div>

      {% endif %}

    {% endfor %}

  </div>

</div>
<script>
(function () {

  function initPopupVariants() {

    const forms = document.querySelectorAll('.popup_product_form');

    forms.forEach(function (form) {

      if (form.dataset.variantHandlerInitialized === 'true') {
        return;
      }

      form.dataset.variantHandlerInitialized = 'true';

      const popup = form.closest('.product_popup');

      if (!popup) {
        return;
      }

      const variantInput =
        form.querySelector('.popup_variant_id');

      const addToCartButton =
        form.querySelector('.popup_add_to_cart');

      const variantJson =
        popup.querySelector('.popup-product-variants');

      if (!variantInput || !variantJson) {
        return;
      }

      let variants = [];

      try {
        variants = JSON.parse(
          variantJson.textContent
        );
      } catch (error) {
        console.error(
          'Unable to read product variants:',
          error
        );
        return;
      }


      /*
       * ----------------------------------------------------
       * GET SELECTED OPTIONS
       * ----------------------------------------------------
       */

      function getSelectedOptions() {

        const options = [];

        /*
         * Select fields
         */
        form.querySelectorAll(
          '.popup_option_select'
        ).forEach(function (select) {

          const index =
            parseInt(
              select.dataset.optionIndex,
              10
            );

          options[index] = select.value;

        });


        /*
         * Button options
         */
        form.querySelectorAll(
          '.popup_option_button.is-selected'
        ).forEach(function (button) {

          const index =
            parseInt(
              button.dataset.optionIndex,
              10
            );

          options[index] =
            button.dataset.optionValue;

        });


        return options;
      }


      /*
       * ----------------------------------------------------
       * FIND EXACT VARIANT
       * ----------------------------------------------------
       */

      function findVariant(options) {

        return variants.find(function (variant) {

          if (!variant.options) {
            return false;
          }

          if (
            variant.options.length !==
            options.length
          ) {
            return false;
          }

          return variant.options.every(
            function (value, index) {

              return String(value) ===
                String(options[index]);

            }
          );

        });

      }


      /*
       * ----------------------------------------------------
       * UPDATE SELECTED VARIANT
       * ----------------------------------------------------
       */

      function updateVariant() {

        const options =
          getSelectedOptions();

        const variant =
          findVariant(options);


        if (!variant) {

          variantInput.value = '';

          if (addToCartButton) {
            addToCartButton.disabled = true;
          }

          console.warn(
            'No variant found:',
            options
          );

          return;
        }


        /*
         * IMPORTANT
         *
         * This updates the actual Shopify
         * variant ID.
         */
        variantInput.value =
          variant.id;


        /*
         * Save options for Add To Cart
         */
        form.dataset.selectedOptions =
          JSON.stringify(options);


        /*
         * Update availability
         */
        if (addToCartButton) {

          const text =
            addToCartButton.querySelector(
              '.popup_add_to_cart_text'
            );


          if (variant.available) {

            addToCartButton.disabled = false;

            if (text) {

              text.innerHTML =
                'ADD TO CART <span class="popup_add_to_cart_arrow">&xrarr;</span>';

            }

          } else {

            addToCartButton.disabled = true;

            if (text) {
              text.textContent = 'SOLD OUT';
            }

          }

        }


        console.log(
          'Selected variant:',
          variant.id,
          options
        );

      }


      /*
       * ----------------------------------------------------
       * SELECT DROPDOWN
       * ----------------------------------------------------
       */

      form.querySelectorAll(
        '.popup_option_select'
      ).forEach(function (select) {

        select.addEventListener(
          'change',
          function () {

            updateVariant();

          }
        );

      });


      /*
       * ----------------------------------------------------
       * OPTION BUTTONS
       * ----------------------------------------------------
       */

      form.querySelectorAll(
        '.popup_option_button'
      ).forEach(function (button) {

        button.addEventListener(
          'click',
          function () {

            const optionIndex =
              button.dataset.optionIndex;


            /*
             * Remove selected state only
             * from the same option group.
             */
            form.querySelectorAll(
              '.popup_option_button[data-option-index="' +
              optionIndex +
              '"]'
            ).forEach(function (item) {

              item.classList.remove(
                'is-selected'
              );

            });


            /*
             * Select clicked button
             */
            button.classList.add(
              'is-selected'
            );


            updateVariant();

          }
        );

      });


      /*
       * ----------------------------------------------------
       * INITIAL VARIANT
       * ----------------------------------------------------
       */

      updateVariant();


      /*
       * ----------------------------------------------------
       * ADD TO CART
       * ----------------------------------------------------
       */

      form.addEventListener(
        'submit',
        async function (event) {

          event.preventDefault();


          if (
            form.dataset.submitting === 'true'
          ) {
            return;
          }


          const options =
            getSelectedOptions();


          const selectedVariant =
            findVariant(options);


          if (!selectedVariant) {

            alert(
              'Please select a valid product variant.'
            );

            return;
          }


          /*
           * Make sure hidden input has
           * the correct variant.
           */
          variantInput.value =
            selectedVariant.id;


          form.dataset.submitting =
            'true';


          if (addToCartButton) {
            addToCartButton.disabled = true;
          }


          try {

            /*
             * Start with the selected product.
             */
            const cartItems = [
              {
                id: Number(
                  selectedVariant.id
                ),
                quantity: 1
              }
            ];


            /*
             * ------------------------------------------------
             * AUTOMATIC PRODUCT
             * ------------------------------------------------
             */

            const autoProductJson =
              popup.querySelector(
                '.popup-auto-product-data'
              );


            if (autoProductJson) {

              let autoProduct = null;

              try {

                autoProduct =
                  JSON.parse(
                    autoProductJson.textContent
                  );

              } catch (error) {

                console.error(
                  'Automatic product JSON error:',
                  error
                );

              }


              if (autoProduct) {

                /*
                 * Check Black
                 */
                const hasBlack =
                  options.some(function (value) {

                    return String(value)
                      .trim()
                      .toLowerCase() ===
                      'black';

                  });


                /*
                 * Check Medium
                 */
                const hasMedium =
                  options.some(function (value) {

                    return String(value)
                      .trim()
                      .toLowerCase() ===
                      'medium';

                  });


                /*
                 * Only Black + Medium
                 */
                if (
                  hasBlack &&
                  hasMedium
                ) {

                  const autoVariant =
                    findAutoVariant(
                      autoProduct
                    );


                  if (autoVariant) {

                    /*
                     * Add the exact M + Black
                     * Soft Winter Jacket variant.
                     */
                    cartItems.push({

                      id: Number(
                        autoVariant.id
                      ),

                      quantity: 1

                    });


                    console.log(
                      'Automatic product variant:',
                      autoVariant.id,
                      autoVariant.options
                    );

                  } else {

                    console.warn(
                      'Black + Medium selected, but matching automatic product variant was not found.'
                    );

                  }

                }

              }

            }


            /*
             * ------------------------------------------------
             * SHOPIFY AJAX CART
             * ------------------------------------------------
             */

            const response =
              await fetch(
                window.Shopify.routes.root +
                'cart/add.js',
                {
                  method: 'POST',

                  headers: {
                    'Content-Type':
                      'application/json',

                    'Accept':
                      'application/json'
                  },

                  body: JSON.stringify({
                    items: cartItems
                  })
                }
              );


            const data =
              await response.json();


            if (!response.ok) {

              throw new Error(
                data.description ||
                data.message ||
                'Unable to add product to cart.'
              );

            }


            console.log(
              'Added to cart:',
              data
            );


            /*
             * IMPORTANT:
             *
             * We DO NOT:
             *
             * - close popup
             * - remove popup classes
             * - dispatch cart:refresh
             * - dispatch cart:updated
             * - dispatch ajaxProduct:added
             *
             * Your existing theme handles those.
             */


            /*
             * Reset submitting state
             */
            form.dataset.submitting =
              'false';


            updateVariant();


          } catch (error) {

            console.error(
              'Add to cart error:',
              error
            );


            alert(
              error.message ||
              'Unable to add product to cart.'
            );


            form.dataset.submitting =
              'false';


            updateVariant();

          }

        }
      );

    });

  }


  /*
   * ----------------------------------------------------
   * FIND AUTOMATIC PRODUCT VARIANT
   * ----------------------------------------------------
   */

  function findAutoVariant(autoProduct) {

    if (
      !autoProduct ||
      !autoProduct.variants
    ) {
      return null;
    }


    /*
     * First try exact option-name matching.
     *
     * Example:
     *
     * Size = Medium
     * Color = Black
     */
    if (
      autoProduct.options &&
      autoProduct.options.length
    ) {

      const variant =
        autoProduct.variants.find(
          function (variant) {

            if (!variant.options) {
              return false;
            }


            let hasMedium = false;
            let hasBlack = false;


            variant.options.forEach(
              function (value) {

                const normalized =
                  String(value)
                    .trim()
                    .toLowerCase();


                if (
                  normalized ===
                  'medium'
                ) {
                  hasMedium = true;
                }


                if (
                  normalized ===
                  'black'
                ) {
                  hasBlack = true;
                }

              }
            );


            return (
              hasMedium &&
              hasBlack
            );

          }
        );


      if (variant) {
        return variant;
      }

    }


    return null;

  }


  /*
   * ----------------------------------------------------
   * INITIALIZE
   * ----------------------------------------------------
   */

  function initializePopupVariants() {
    initPopupVariants();
  }


  function initPopupVariants() {
    initPopupVariantsHandler();
  }


  function initPopupVariantsHandler() {
    initPopupVariantsCode();
  }


  function initPopupVariantsCode() {
    initPopupVariantsMain();
  }


  function initPopupVariantsMain() {
    initPopupVariantsReal();
  }


  function initPopupVariantsReal() {
    initPopupVariantsFinal();
  }


  function initPopupVariantsFinal() {
    initPopupVariantsActual();
  }


  function initPopupVariantsActual() {
    initPopupVariantsProcess();
  }


  function initPopupVariantsProcess() {
    initPopupVariantsNow();
  }


  function initPopupVariantsNow() {
    initPopupVariantsSafe();
  }


  function initPopupVariantsSafe() {
    initPopupVariantsDirect();
  }


  function initPopupVariantsDirect() {
    initPopupVariantsCore();
  }


  function initPopupVariantsCore() {
    initPopupVariantsInternal();
  }


  function initPopupVariantsInternal() {
    initPopupVariantsExecution();
  }


  function initPopupVariantsExecution() {
    initPopupVariantsFunction();
  }


  function initPopupVariantsFunction() {
    initPopupVariants();
  }


  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initPopupProductForms
    );

  } else {

    initPopupProductForms();

  }


  /*
   * Shopify Theme Editor
   */
  document.addEventListener(
    'shopify:section:load',
