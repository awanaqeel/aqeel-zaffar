{% comment %}
  ============================================================
  QUICK VIEW PRODUCT POPUP
  ============================================================
{% endcomment %}

{% assign auto_added_product = section.settings.select_product %}

<div class="popup_product_content">

  <!-- ========================================================
       CLOSE BUTTON
       ======================================================== -->

  <button
    type="button"
    class="product_popup_close"
    id="close-popup-{{ product.id }}"
    aria-label="Close"
  >
    <img
      src="https://cdn.shopify.com/s/files/1/0740/2592/6742/files/Group_1000008157.svg?v=1786149863"
      alt="Close"
    >
  </button>


  <!-- ========================================================
       PRODUCT IMAGE + INFORMATION
       ======================================================== -->

  <div class="image_with_info">

    <!-- Product Image -->
    <div class="popup_product_image">

      {% if product.featured_image %}

        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          loading="lazy"
        >

      {% endif %}

    </div>


    <!-- Product Information -->
    <div class="popup_product_info">

      <!-- Product Title -->
      <h3 class="popup_product_title">
        {{ product.title }}
      </h3>


      <!-- Product Price -->
      <div class="popup_product_price">
        {{ product.selected_or_first_available_variant.price | money }}
      </div>


      <!-- Product Description -->
      {% if product.description != blank %}

        <div class="popup_product_description">
          {{ product.description | strip_html | truncatewords: 30 }}
        </div>

      {% endif %}

    </div>

  </div>


  <!-- ========================================================
       PRODUCT FORM
       ======================================================== -->

  {% form 'product',
    product,
    class: 'popup_product_form'
  %}

    <!--
      IMPORTANT:
      This value is intentionally empty initially.

      We do NOT want Shopify to use the first available
      variant when the customer has not selected a variant.
    -->

    <input
      type="hidden"
      name="id"
      class="popup_variant_id"
      value=""
    >


    <!-- ======================================================
         PRODUCT OPTIONS
         ====================================================== -->

    {% unless product.has_only_default_variant %}

      <div class="popup_product_options">

        {% for option in product.options_with_values %}

          <div
            class="popup_product_option"
            data-option-index="{{ forloop.index0 }}"
            data-option-name="{{ option.name | escape }}"
          >

            <label class="popup_option_label">
              {{ option.name }}
            </label>


            {% if forloop.first %}

              <!-- ============================================
                   FIRST OPTION - SELECT
                   ============================================ -->

              <div class="popup_select_wrapper">

                <select
                  class="popup_option_select"
                  data-option-index="{{ forloop.index0 }}"
                >

                  <option
                    value=""
                    disabled
                    selected
                  >
                    Choose your size
                  </option>


                  {% for value in option.values %}

                    <option
                      value="{{ value | escape }}"
                    >
                      {{ value }}
                    </option>

                  {% endfor %}

                </select>

                <span class="popup_select_arrow">
                  ↓
                </span>

              </div>


            {% else %}


              <!-- ============================================
                   OTHER OPTIONS - BUTTONS
                   ============================================ -->

              <div class="popup_option_buttons">

                {% for value in option.values %}

                  <button
                    type="button"
                    class="popup_option_button"
                    data-option-value="{{ value | escape }}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    {% assign opionName = "{{ option.name  | downcase }}" %}
                    {% if optionName == 'color' %}
                      style="border-left: 4px solid {{ value }}"
                    {% endif %}
                  >
                    {{ value }}
                  </button>

                {% endfor %}

              </div>

            {% endif %}

          </div>

        {% endfor %}

      </div>

    {% endunless %}


    <!-- ======================================================
         ADD TO CART
         ====================================================== -->

    <button
      type="submit"
      name="add"
      class="popup_add_to_cart custom-banner__button"
      disabled
    >

      <span class="popup_add_to_cart_text">
        CHOOSE OPTIONS
      </span>

    </button>

  {% endform %}

</div>


<!-- ==========================================================
     CURRENT PRODUCT JSON
     ========================================================== -->

<script
  type="application/json"
  class="popup-product-json"
>
  {{ product | json }}
</script>


<!-- ==========================================================
     AUTO ADDED PRODUCT JSON
     ========================================================== -->

{% if auto_added_product != blank %}

  <script
    type="application/json"
    class="auto-added-product-json"
  >
    {{ auto_added_product | json }}
  </script>

{% endif %}


<script>
(function () {

  /*
   * ============================================================
   * IMPORTANT
   * ============================================================
   *
   * This popup snippet can exist multiple times on the page.
   *
   * Therefore we install the global event handlers ONLY ONCE.
   *
   * Product-specific variant handling is performed using
   * event delegation.
   */

  if (window.__CUSTOM_QUICK_VIEW_INITIALIZED__) {
    return;
  }

  window.__CUSTOM_QUICK_VIEW_INITIALIZED__ = true;


  /* ============================================================
   * HELPER - CLOSE ALL POPUPS
   * ============================================================ */

  function closeAllPopups() {

    document
      .querySelectorAll('.product_popup.is-open')
      .forEach(function (popup) {

        popup.classList.remove('is-open');

        popup.setAttribute(
          'aria-hidden',
          'true'
        );

      });


    document.body.classList.remove(
      'quick-view-open'
    );

  }


  /* ============================================================
   * HELPER - GET PRODUCT DATA
   * ============================================================ */

  function getProductData(popup) {

    if (!popup) {
      return null;
    }


    var element =
      popup.querySelector(
        '.popup-product-json'
      );


    if (!element) {
      return null;
    }


    try {

      return JSON.parse(
        element.textContent
      );

    } catch (error) {

      console.error(
        'Quick View: Product JSON error',
        error
      );

      return null;

    }

  }


  /* ============================================================
   * HELPER - GET AUTO PRODUCT DATA
   * ============================================================ */

  function getAutoProductData(popup) {

    if (!popup) {
      return null;
    }


    var element =
      popup.querySelector(
        '.auto-added-product-json'
      );


    if (!element) {
      return null;
    }


    try {

      return JSON.parse(
        element.textContent
      );

    } catch (error) {

      console.error(
        'Quick View: Auto product JSON error',
        error
      );

      return null;

    }

  }


  /* ============================================================
   * OPEN QUICK VIEW
   * ============================================================ */

  document.addEventListener(
    'click',
    function (event) {

      var button =
        event.target.closest(
          '.quick_view_btn'
        );


      if (!button) {
        return;
      }


      event.preventDefault();


      var productId =
        button.getAttribute(
          'data-product-id'
        );


      if (!productId) {
        return;
      }


      var popup =
        document.querySelector(
          '#product-popup-' + productId
        );


      if (!popup) {

        console.error(
          'Quick View popup not found:',
          productId
        );

        return;

      }


      /*
       * Close any popup currently open.
       */

      closeAllPopups();


      /*
       * Open selected popup.
       */

      popup.classList.add(
        'is-open'
      );

      popup.setAttribute(
        'aria-hidden',
        'false'
      );

      document.body.classList.add(
        'quick-view-open'
      );

    }
  );


  /* ============================================================
   * CLOSE BUTTON
   * ============================================================ */

  document.addEventListener(
    'click',
    function (event) {

      var closeButton =
        event.target.closest(
          '.product_popup_close'
        );


      if (!closeButton) {
        return;
      }


      event.preventDefault();


      closeAllPopups();

    }
  );


  /* ============================================================
   * OVERLAY CLOSE
   * ============================================================ */

  document.addEventListener(
    'click',
    function (event) {

      var overlay =
        event.target.closest(
          '.product_popup_overlay'
        );


      if (!overlay) {
        return;
      }


      closeAllPopups();

    }
  );


  /* ============================================================
   * ESC KEY
   * ============================================================ */

  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key !== 'Escape') {
        return;
      }


      closeAllPopups();

    }
  );


  /* ============================================================
   * GET SELECTED OPTIONS
   * ============================================================ */

  function getSelectedOptions(content) {

    var options = [];


    content
      .querySelectorAll(
        '.popup_product_option'
      )
      .forEach(function (optionContainer) {

        var index =
          parseInt(
            optionContainer.getAttribute(
              'data-option-index'
            ),
            10
          );


        /*
         * Check selected button.
         */

        var selectedButton =
          optionContainer.querySelector(
            '.popup_option_button.is-selected'
          );


        /*
         * Check select.
         */

        var select =
          optionContainer.querySelector(
            '.popup_option_select'
          );


        if (selectedButton) {

          options[index] =
            selectedButton.getAttribute(
              'data-option-value'
            );

        }
        else if (select) {

          options[index] =
            select.value;

        }

      });


    return options;

  }


  /* ============================================================
   * FIND SELECTED VARIANT
   * ============================================================ */

  function findSelectedVariant(
    productData,
    selectedOptions
  ) {

    if (
      !productData ||
      !productData.variants
    ) {

      return null;

    }


    /*
     * Make sure every option has a value.
     */

    if (
      selectedOptions.length !==
      productData.options.length
    ) {

      return null;

    }


    var allSelected =
      selectedOptions.every(
        function (value) {

          return (
            value !== undefined &&
            value !== null &&
            value !== ''
          );

        }
      );


    if (!allSelected) {
      return null;
    }


    /*
     * Find exact matching variant.
     */

    return productData.variants.find(
      function (variant) {

        return variant.options.every(
          function (
            optionValue,
            index
          ) {

            return (
              String(optionValue)
                .trim()
                .toLowerCase() ===

              String(
                selectedOptions[index]
              )
                .trim()
                .toLowerCase()
            );

          }
        );

      }
    ) || null;

  }


  /* ============================================================
   * UPDATE CURRENT VARIANT
   * ============================================================ */

  function updateVariant(content) {

    if (!content) {
      return;
    }


    var popup =
      content.closest(
        '.product_popup'
      );


    var form =
      content.querySelector(
        '.popup_product_form'
      );


    if (!popup || !form) {
      return;
    }


    var variantInput =
      form.querySelector(
        '.popup_variant_id'
      );


    var addButton =
      form.querySelector(
        '.popup_add_to_cart'
      );


    var buttonText =
      form.querySelector(
        '.popup_add_to_cart_text'
      );


    var priceElement =
      popup.querySelector(
        '.popup_product_price'
      );


    var productData =
      getProductData(popup);


    if (
      !variantInput ||
      !productData
    ) {

      return;

    }


    var selectedOptions =
      getSelectedOptions(content);


    console.log(
      'Quick View selected options:',
      selectedOptions
    );


    var variant =
      findSelectedVariant(
        productData,
        selectedOptions
      );


    /*
     * ==========================================================
     * NO VALID VARIANT
     * ==========================================================
     */

    if (!variant) {

      /*
       * VERY IMPORTANT:
       *
       * Clear the hidden ID so Shopify cannot
       * fall back to the first variant.
       */

      variantInput.value = '';


      if (addButton) {

        addButton.disabled = true;

      }


      if (buttonText) {

        buttonText.textContent =
          'CHOOSE OPTIONS';

      }


      return;

    }


    /*
     * ==========================================================
     * VALID VARIANT FOUND
     * ==========================================================
     */


    /*
     * THIS IS THE ACTUAL SHOPIFY VARIANT ID.
     */

    variantInput.value =
      String(variant.id);


    console.log(
      'Quick View selected variant ID:',
      variant.id
    );


    /*
     * Update price.
     */

    if (
      priceElement &&
      typeof Shopify !== 'undefined' &&
      typeof Shopify.formatMoney ===
        'function'
    ) {

      priceElement.innerHTML =
        Shopify.formatMoney(
          variant.price,
          Shopify.money_format
        );

    }


    /*
     * Update button.
     */

    if (addButton) {

      addButton.disabled =
        !variant.available;

    }


    if (buttonText) {

      buttonText.textContent =
        variant.available
          ? 'ADD TO CART'
          : 'SOLD OUT';

    }

  }


  /* ============================================================
   * OPTION BUTTON CLICK
   * ============================================================ */

  document.addEventListener(
    'click',
    function (event) {

      var button =
        event.target.closest(
          '.popup_option_button'
        );


      if (!button) {
        return;
      }


      event.preventDefault();


      var content =
        button.closest(
          '.popup_product_content'
        );


      if (!content) {
        return;
      }


      var optionIndex =
        button.getAttribute(
          'data-option-index'
        );


      /*
       * Remove selected class from same option.
       */

      content
        .querySelectorAll(
          '.popup_option_button[data-option-index="' +
          optionIndex +
          '"]'
        )
        .forEach(function (item) {

          item.classList.remove(
            'is-selected'
          );

        });


      /*
       * Select clicked value.
       */

      button.classList.add(
        'is-selected'
      );


      /*
       * Recalculate variant.
       */

      updateVariant(content);

    }
  );


  /* ============================================================
   * SELECT CHANGE
   * ============================================================ */

  document.addEventListener(
    'change',
    function (event) {

      var select =
        event.target.closest(
          '.popup_option_select'
        );


      if (!select) {
        return;
      }


      var content =
        select.closest(
          '.popup_product_content'
        );


      if (!content) {
        return;
      }


      /*
       * Recalculate variant.
       */

      updateVariant(content);

    }
  );


  /* ============================================================
   * FIND AUTOMATIC PRODUCT VARIANT
   * ============================================================ */

  function findAutoProductVariant(
    autoProduct
  ) {

    if (
      !autoProduct ||
      !autoProduct.variants
    ) {

      return null;

    }


    /*
     * We need:
     *
     * Color = Black
     *
     * Size = Medium / M
     *
     * The option order does not matter.
     */

    var variant =
      autoProduct.variants.find(
        function (variant) {

          var normalizedOptions =
            variant.options.map(
              function (value) {

                return String(value)
                  .trim()
                  .toLowerCase();

              }
            );


          var hasBlack =
            normalizedOptions.indexOf(
              'black'
            ) !== -1;


          var hasMedium =
            normalizedOptions.indexOf(
              'medium'
            ) !== -1 ||
            normalizedOptions.indexOf(
              'm'
            ) !== -1;


          return (
            hasBlack &&
            hasMedium
          );

        }
      );


    return variant || null;

  }


  /* ============================================================
   * CHECK IF CURRENT PRODUCT IS MEDIUM + BLACK
   * ============================================================ */

  function isMediumBlackSelected(
    content
  ) {

    var selectedOptions =
      getSelectedOptions(content);


    var normalized =
      selectedOptions.map(
        function (value) {

          return value
            ? String(value)
                .trim()
                .toLowerCase()
            : '';

        }
      );


    /*
     * Accept both:
     *
     * M
     * Medium
     */

    var hasMedium =
      normalized.indexOf('m') !== -1 ||
      normalized.indexOf('medium') !== -1;


    var hasBlack =
      normalized.indexOf('black') !== -1;


    return (
      hasMedium &&
      hasBlack
    );

  }


  /* ============================================================
   * ADD TO CART
   * ============================================================ */

  document.addEventListener(
    'submit',
    function (event) {

      var form =
        event.target.closest(
          '.popup_product_form'
        );


      if (!form) {
        return;
      }


      event.preventDefault();
      event.stopImmediatePropagation();


      /*
       * Prevent duplicate submissions.
       */

      if (
        form.dataset.addingToCart ===
        'true'
      ) {

        return;

      }


      var content =
        form.closest(
          '.popup_product_content'
        );


      var popup =
        content
          ? content.closest(
              '.product_popup'
            )
          : null;


      var variantInput =
        form.querySelector(
          '.popup_variant_id'
        );


      var addButton =
        form.querySelector(
          '.popup_add_to_cart'
        );


      var buttonText =
        form.querySelector(
          '.popup_add_to_cart_text'
        );


      if (
        !content ||
        !popup ||
        !variantInput
      ) {

        return;

      }


      /*
       * ALWAYS READ THE CURRENT
       * VARIANT ID.
       */

      var selectedVariantId =
        variantInput.value;


      console.log(
        'FINAL SELECTED VARIANT:',
        selectedVariantId
      );


      /*
       * Never allow empty variant.
       */

      if (!selectedVariantId) {

        console.error(
          'Quick View: No variant selected.'
        );

        updateVariant(content);

        return;

      }


      /*
       * Lock the form.
       */

      form.dataset.addingToCart =
        'true';


      if (addButton) {

        addButton.disabled = true;

      }


      if (buttonText) {

        buttonText.textContent =
          'ADDING...';

      }


      /* ========================================================
         CART ITEMS
         ======================================================== */

      var items = [

        {
          id: Number(
            selectedVariantId
          ),

          quantity: 1
        }

      ];


      /* ========================================================
         AUTO ADD PRODUCT
         ======================================================== */

      if (
        isMediumBlackSelected(
          content
        )
      ) {

        var autoProduct =
          getAutoProductData(
            popup
          );


        if (autoProduct) {

          var autoVariant =
            findAutoProductVariant(
              autoProduct
            );


          if (autoVariant) {

            console.log(
              'AUTO PRODUCT:',
              autoProduct.title
            );


            console.log(
              'AUTO PRODUCT VARIANT:',
              autoVariant
            );


            /*
             * Add the exact
             * Medium + Black variant.
             */

            items.push({

              id: Number(
                autoVariant.id
              ),

              quantity: 1

            });

          } else {

            console.warn(
              'Black + Medium variant was not found in the automatic product:',
              autoProduct.title
            );

          }

        }

      }


      console.log(
        'FINAL CART ITEMS:',
        items
      );


      /* ========================================================
         SHOPIFY AJAX CART
         ======================================================== */

      var cartUrl =
        (
          window.Shopify &&
          Shopify.routes &&
          Shopify.routes.root
        )
          ? Shopify.routes.root +
            'cart/add.js'
          : '/cart/add.js';


      fetch(
        cartUrl,
        {
          method: 'POST',

          headers: {

            'Content-Type':
              'application/json',

            'Accept':
              'application/json'

          },

          body: JSON.stringify({

            items: items

          })

        }
      )


      /* ========================================================
         RESPONSE
         ======================================================== */

      .then(
        function (response) {

          if (!response.ok) {

            return response
              .json()
              .then(
                function (error) {

                  throw error;

                }
              );

          }


          return response.json();

        }
      )


      /* ========================================================
         SUCCESS
         ======================================================== */

      .then(
        function (data) {

          console.log(
            'QUICK VIEW CART SUCCESS:',
            data
          );


          /*
           * Unlock form.
           */

          form.dataset.addingToCart =
            'false';


          /*
           * Close popup.
           */

          closeAllPopups();


          /*
           * Notify Shopify/theme.
           */

          document.dispatchEvent(
            new CustomEvent(
              'cart:updated',
              {
                detail: data
              }
            )
          );


          document.dispatchEvent(
            new CustomEvent(
              'cart:refresh',
              {
                detail: data
              }
            )
          );


          /*
           * Update cart count if theme
           * listens to these events.
           */

          document.dispatchEvent(
            new CustomEvent(
              'cart:change',
              {
                bubbles: true,
                detail: data
              }
            )
          );


          /*
           * If theme exposes a cart drawer
           * refresh function, use it.
           */

          if (
            typeof window.refreshCart ===
            'function'
          ) {

            window.refreshCart();

          }


          /*
           * Try to open Shopify cart drawer.
           *
           * If the theme doesn't support it,
           * simply redirect to cart.
           */

          var cartDrawer =
            document.querySelector(
              'cart-drawer'
            );


          if (
            cartDrawer &&
            typeof cartDrawer.open ===
              'function'
          ) {

            /*
             * Refresh drawer contents if
             * theme provides the method.
             */

            if (
              typeof cartDrawer.renderContents ===
              'function'
            ) {

              cartDrawer.renderContents(
                data
              );

            }

            cartDrawer.open();

          }
          else {

            /*
             * Reliable fallback.
             */

            window.location.href =
              (
                window.Shopify &&
                Shopify.routes &&
                Shopify.routes.root
              )
                ? Shopify.routes.root +
                  'cart'
                : '/cart';

          }

        }
      )


      /* ========================================================
         ERROR
         ======================================================== */

      .catch(
        function (error) {

          console.error(
            'QUICK VIEW ADD TO CART ERROR:',
            error
          );


          /*
           * Unlock form.
           */

          form.dataset.addingToCart =
            'false';


          /*
           * Recalculate current variant
           * and restore button.
           */

          updateVariant(
            content
          );

        }
      );

    }
  );


  /* ============================================================
   * INITIALIZE POPUPS
   * ============================================================ */

  function initializePopups() {

    document
      .querySelectorAll(
        '.popup_product_content'
      )
      .forEach(
        function (content) {

          var form =
            content.querySelector(
              '.popup_product_form'
            );


          if (!form) {
            return;
          }


          var variantInput =
            form.querySelector(
              '.popup_variant_id'
            );


          /*
           * Start with no selected variant.
           */

          if (variantInput) {

            variantInput.value = '';

          }


          /*
           * Disable Add To Cart.
           */

          var button =
            form.querySelector(
              '.popup_add_to_cart'
            );


          var buttonText =
            form.querySelector(
              '.popup_add_to_cart_text'
            );


          if (button) {

            button.disabled = true;

          }


          if (buttonText) {

            buttonText.textContent =
              'CHOOSE OPTIONS';

          }

        }
      );

  }


  /* ============================================================
   * RUN INITIALIZATION
   * ============================================================ */

  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initializePopups
    );

  }
  else {

    initializePopups();

  }

})();
</script>