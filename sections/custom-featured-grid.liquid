{% if section.settings.section_heading != blank %}
  <div class="custom-featured-grid-heading">
    {{ section.settings.section_heading }}
  </div>
{% endif %}

<div
  id="custom-featured-grid-{{ section.id }}"
  class="custom-featured-grid"
>
  {% for block in section.blocks %}

    {% if block.settings.product != blank %}

      {% assign product = block.settings.product %}

      <div
        class="custom-product-grid-item"
        style="
          --quick-top: {% if block.settings.top > 0 %}{{ block.settings.top }}%{% else %}auto{% endif %};
          --quick-bottom: {% if block.settings.bottom > 0 %}{{ block.settings.bottom }}%{% else %}auto{% endif %};
          --quick-left: {% if block.settings.left > 0 %}{{ block.settings.left }}%{% else %}auto{% endif %};
          --quick-right: {% if block.settings.right > 0 %}{{ block.settings.right }}%{% else %}auto{% endif %};

          --quick-top-mb: {% if block.settings.top_mb > 0 %}{{ block.settings.top_mb }}%{% else %}auto{% endif %};
          --quick-bottom-mb: {% if block.settings.bottom_mb > 0 %}{{ block.settings.bottom_mb }}%{% else %}auto{% endif %};
          --quick-left-mb: {% if block.settings.left_mb > 0 %}{{ block.settings.left_mb }}%{% else %}auto{% endif %};
          --quick-right-mb: {% if block.settings.right_mb > 0 %}{{ block.settings.right_mb }}%{% else %}auto{% endif %};
        "
        {{ block.shopify_attributes }}
      >

        <!-- PRODUCT IMAGE -->
        <div class="grid_image">
          {% if product.featured_image != blank %}
            <img
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              loading="lazy"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >
          {% endif %}
        </div>


        <!-- QUICK VIEW BUTTON -->
        <button
          type="button"
          class="quick_view_btn"
          id="quick_view_btn_{{ product.id }}_{{ section.id }}"
          data-product-id="{{ product.id }}"
          data-popup-id="product-popup-{{ product.id }}-{{ section.id }}"
          aria-label="Quick view {{ product.title | escape }}"
        >
          <img
            src="https://cdn.shopify.com/s/files/1/0740/2592/6742/files/plus-sign.svg?v=1786143487"
            alt="plus-icon"
          >
        </button>


        <!-- PRODUCT POPUP -->
        <div
          class="product_popup"
          id="product-popup-{{ product.id }}-{{ section.id }}"
          data-product-id="{{ product.id }}"
          aria-hidden="true"
        >

          <div class="product_popup_inner">

            <!-- CLOSE BUTTON -->
            <button
              type="button"
              class="product_popup_close"
              aria-label="Close popup"
            >
              ×
            </button>

            {% render 'popup-card',
              product: product,
              section: section
            %}

          </div>

        </div>

      </div>

    {% endif %}

  {% endfor %}
</div>


<script>
(function () {

  'use strict';


  /*
   * ============================================================
   * POPUP SYSTEM
   * ============================================================
   */

  function initPopupSystem(scope) {

    scope = scope || document;

    /*
     * ------------------------------------------------------------
     * OPEN POPUP
     * ------------------------------------------------------------
     */

    scope.querySelectorAll('.quick_view_btn').forEach(function (button) {

      if (button.dataset.popupOpenInitialized === 'true') {
        return;
      }

      button.dataset.popupOpenInitialized = 'true';


      button.addEventListener('click', function (event) {

        event.preventDefault();
        event.stopPropagation();


        var popupId = button.getAttribute('data-popup-id');

        if (!popupId) {
          return;
        }


        var popup = document.getElementById(popupId);

        if (!popup) {
          console.error(
            'Popup not found:',
            popupId
          );

          return;
        }


        /*
         * Close any other popup first.
         */
        document.querySelectorAll('.product_popup').forEach(function (item) {

          if (item !== popup) {

            item.setAttribute(
              'aria-hidden',
              'true'
            );

            item.classList.remove(
              'active',
              'is-open',
              'open'
            );

          }

        });


        /*
         * Open current popup.
         */
        popup.setAttribute(
          'aria-hidden',
          'false'
        );

        popup.classList.add(
          'active',
          'is-open',
          'open'
        );


        /*
         * Initialize variants for this popup.
         */
        initPopupProductForms(popup);

      });

    });


    /*
     * ------------------------------------------------------------
     * CLOSE BUTTON
     * ------------------------------------------------------------
     */

    scope.querySelectorAll('.product_popup_close').forEach(function (button) {

      if (button.dataset.popupCloseInitialized === 'true') {
        return;
      }

      button.dataset.popupCloseInitialized = 'true';


      button.addEventListener('click', function (event) {

        event.preventDefault();
        event.stopPropagation();


        var popup = button.closest('.product_popup');

        if (!popup) {
          return;
        }


        closePopup(popup);

      });

    });


    /*
     * ------------------------------------------------------------
     * CLICK OUTSIDE POPUP CONTENT
     * ------------------------------------------------------------
     */

    scope.querySelectorAll('.product_popup').forEach(function (popup) {

      if (popup.dataset.popupBackdropInitialized === 'true') {
        return;
      }

      popup.dataset.popupBackdropInitialized = 'true';


      popup.addEventListener('click', function (event) {

        if (event.target === popup) {
          closePopup(popup);
        }

      });

    });

  }


  function closePopup(popup) {

    if (!popup) {
      return;
    }


    popup.setAttribute(
      'aria-hidden',
      'true'
    );


    popup.classList.remove(
      'active',
      'is-open',
      'open'
    );

  }


  /*
   * ============================================================
   * ESC KEY
   * ============================================================
   */

  function initEscapeKey() {

    if (window.customFeaturedPopupEscapeInitialized) {
      return;
    }

    window.customFeaturedPopupEscapeInitialized = true;


    document.addEventListener('keydown', function (event) {

      if (event.key !== 'Escape') {
        return;
      }


      document.querySelectorAll(
        '.product_popup[aria-hidden="false"]'
      ).forEach(function (popup) {

        closePopup(popup);

      });

    });

  }


  /*
   * ============================================================
   * POPUP PRODUCT VARIANTS
   * ============================================================
   */

  function initPopupProductForms(scope) {

    scope = scope || document;


    /*
     * If scope itself is a popup, use it.
     * Otherwise find all popups inside scope.
     */

    var popups = [];

    if (
      scope.classList &&
      scope.classList.contains('product_popup')
    ) {

      popups = [scope];

    } else {

      popups = Array.from(
        scope.querySelectorAll('.product_popup')
      );

    }


    popups.forEach(function (popup) {

      var form =
        popup.querySelector('.popup_product_form');


      if (!form) {
        return;
      }


      /*
       * Prevent duplicate initialization.
       */

      if (
        form.dataset.variantHandlerInitialized ===
        'true'
      ) {
        return;
      }


      form.dataset.variantHandlerInitialized =
        'true';


      /*
       * ----------------------------------------------------------
       * ELEMENTS
       * ----------------------------------------------------------
       */

      var variantInput =
        form.querySelector('.popup_variant_id');


      var addToCartButton =
        form.querySelector('.popup_add_to_cart');


      var variantJson =
        popup.querySelector(
          '.popup-product-variants'
        );


      if (!variantInput) {

        console.error(
          'Popup variant input not found.',
          popup
        );

        return;

      }


      if (!variantJson) {

        console.error(
          'Popup variant JSON not found.',
          popup
        );

        return;

      }


      /*
       * ----------------------------------------------------------
       * READ PRODUCT VARIANTS
       * ----------------------------------------------------------
       */

      var variants = [];


      try {

        variants =
          JSON.parse(
            variantJson.textContent
          );

      } catch (error) {

        console.error(
          'Unable to parse product variants:',
          error
        );

        return;

      }


      if (!Array.isArray(variants)) {

        console.error(
          'Product variants JSON is not an array.',
          variants
        );

        return;

      }


      /*
       * ----------------------------------------------------------
       * GET SELECTED OPTIONS
       * ----------------------------------------------------------
       */

      function getSelectedOptions() {

        var options = [];


        /*
         * SELECT DROPDOWNS
         */

        form.querySelectorAll(
          '.popup_option_select'
        ).forEach(function (select) {

          var index =
            parseInt(
              select.dataset.optionIndex,
              10
            );


          if (!isNaN(index)) {

            options[index] =
              String(select.value);

          }

        });


        /*
         * BUTTON OPTIONS
         */

        form.querySelectorAll(
          '.popup_option_button.is-selected'
        ).forEach(function (button) {

          var index =
            parseInt(
              button.dataset.optionIndex,
              10
            );


          if (!isNaN(index)) {

            options[index] =
              String(
                button.dataset.optionValue
              );

          }

        });


        return options;

      }


      /*
       * ----------------------------------------------------------
       * FIND EXACT PRODUCT VARIANT
       * ----------------------------------------------------------
       */

      function findVariant(options) {

        if (!options || !options.length) {
          return null;
        }


        return variants.find(function (variant) {

          if (!variant.options) {
            return false;
          }


          if (
            variant.options.length !==
            options.length
          ) {
            return false;
          }


          return variant.options.every(
            function (variantValue, index) {

              return (
                String(variantValue).trim() ===
                String(options[index]).trim()
              );

            }
          );

        }) || null;

      }


      /*
       * ----------------------------------------------------------
       * UPDATE CURRENT VARIANT
       * ----------------------------------------------------------
       */

      function updateVariant() {

        var options =
          getSelectedOptions();


        /*
         * Do not search until every option
         * has a selected value.
         */

        var optionCount =
          form.querySelectorAll(
            '.popup_product_option'
          ).length;


        if (
          optionCount &&
          options.length !== optionCount
        ) {

          variantInput.value = '';


          if (addToCartButton) {
            addToCartButton.disabled = true;
          }


          return null;

        }


        var variant =
          findVariant(options);


        if (!variant) {

          variantInput.value = '';


          if (addToCartButton) {

            addToCartButton.disabled = true;


            var unavailableText =
              addToCartButton.querySelector(
                '.popup_add_to_cart_text'
              );


            if (unavailableText) {
              unavailableText.textContent =
                'UNAVAILABLE';
            }

          }


          console.warn(
            'No matching variant found:',
            options
          );


          return null;

        }


        /*
         * THIS IS THE IMPORTANT PART.
         *
         * The actual selected Shopify variant ID
         * is written into the hidden input.
         */

        variantInput.value =
          variant.id;


        /*
         * Store selected options.
         */

        form.dataset.selectedOptions =
          JSON.stringify(options);


        /*
         * Update availability.
         */

        if (addToCartButton) {

          var buttonText =
            addToCartButton.querySelector(
              '.popup_add_to_cart_text'
            );


          if (variant.available) {

            addToCartButton.disabled = false;


            if (buttonText) {

              buttonText.innerHTML =
                'ADD TO CART <span class="popup_add_to_cart_arrow">&xrarr;</span>';

            }

          } else {

            addToCartButton.disabled = true;


            if (buttonText) {
              buttonText.textContent =
                'SOLD OUT';
            }

          }

        }


        /*
         * Update price if price data exists.
         */

        var priceElement =
          popup.querySelector(
            '.popup_product_price'
          );


        if (
          priceElement &&
          variant.price_formatted
        ) {

          priceElement.innerHTML =
            variant.price_formatted;

        }


        /*
         * Debugging.
         */

        console.log(
          '[Popup] Selected variant:',
          variant.id,
          variant.options
        );


        return variant;

      }


      /*
       * ----------------------------------------------------------
       * SELECT CHANGE
       * ----------------------------------------------------------
       */

      form.querySelectorAll(
        '.popup_option_select'
      ).forEach(function (select) {

        select.addEventListener(
          'change',
          function () {

            updateVariant();

          }
        );

      });


      /*
       * ----------------------------------------------------------
       * OPTION BUTTONS
       * ----------------------------------------------------------
       */

      form.querySelectorAll(
        '.popup_option_button'
      ).forEach(function (button) {

        button.addEventListener(
          'click',
          function (event) {

            event.preventDefault();


            var optionIndex =
              button.dataset.optionIndex;


            /*
             * Remove selection only from
             * the same option group.
             */

            form.querySelectorAll(
              '.popup_option_button[data-option-index="' +
              optionIndex +
              '"]'
            ).forEach(function (otherButton) {

              otherButton.classList.remove(
                'is-selected'
              );

            });


            /*
             * Select clicked value.
             */

            button.classList.add(
              'is-selected'
            );


            updateVariant();

          }
        );

      });


      /*
       * ----------------------------------------------------------
       * AUTOMATIC PRODUCT DATA
       * ----------------------------------------------------------
       */

      function getAutomaticProduct() {

        var element =
          popup.querySelector(
            '.popup-auto-product-data'
          );


        if (!element) {
          return null;
        }


        try {

          return JSON.parse(
            element.textContent
          );

        } catch (error) {

          console.error(
            'Unable to parse automatic product data:',
            error
          );


          return null;

        }

      }


      /*
       * ----------------------------------------------------------
       * FIND AUTOMATIC PRODUCT VARIANT
       *
       * REQUIRED:
       *
       * Black + Medium
       *
       * This does NOT use:
       *
       * selected_or_first_available_variant
       *
       * It searches the actual variants.
       * ----------------------------------------------------------
       */

      function findAutoVariant(autoProduct) {

        if (
          !autoProduct ||
          !Array.isArray(autoProduct.variants)
        ) {

          return null;

        }


        /*
         * Find a variant containing BOTH:
         *
         * Medium
         * Black
         */

        var matchingVariant =
          autoProduct.variants.find(
            function (variant) {

              if (
                !variant ||
                !Array.isArray(variant.options)
              ) {

                return false;

              }


              var normalizedValues =
                variant.options.map(
                  function (value) {

                    return String(value)
                      .trim()
                      .toLowerCase();

                  }
                );


              var hasMedium =
                normalizedValues.includes(
                  'medium'
                );


              var hasBlack =
                normalizedValues.includes(
                  'black'
                );


              return (
                hasMedium &&
                hasBlack
              );

            }
          );


        if (matchingVariant) {

          console.log(
            '[Popup] Automatic product variant found:',
            matchingVariant.id,
            matchingVariant.options
          );

        }


        return matchingVariant || null;

      }


      /*
       * ----------------------------------------------------------
       * ADD TO CART
       * ----------------------------------------------------------
       */

      if (
        form.dataset.submitHandlerInitialized !==
        'true'
      ) {

        form.dataset.submitHandlerInitialized =
          'true';


        form.addEventListener(
          'submit',
          async function (event) {

            event.preventDefault();


            /*
             * Prevent double submission.
             */

            if (
              form.dataset.submitting ===
              'true'
            ) {

              return;

            }


            /*
             * Get current options.
             */

            var selectedOptions =
              getSelectedOptions();


            /*
             * Find exact selected product variant.
             */

            var selectedVariant =
              findVariant(
                selectedOptions
              );


            if (!selectedVariant) {

              alert(
                'Please select a valid product variant.'
              );

              return;

            }


            /*
             * Make absolutely sure hidden input
             * contains the selected variant ID.
             */

            variantInput.value =
              selectedVariant.id;


            /*
             * Check availability.
             */

            if (!selectedVariant.available) {

              alert(
                'This variant is currently sold out.'
              );

              return;

            }


            form.dataset.submitting =
              'true';


            if (addToCartButton) {
              addToCartButton.disabled = true;
            }


            try {

              /*
               * ------------------------------------------------
               * MAIN PRODUCT
               * ------------------------------------------------
               */

              var cartItems = [

                {
                  id: Number(
                    selectedVariant.id
                  ),

                  quantity: 1

                }

              ];


              /*
               * ------------------------------------------------
               * AUTOMATIC PRODUCT
               * ------------------------------------------------
               */

              var autoProduct =
                getAutomaticProduct();


              if (autoProduct) {

                /*
                 * Check whether current product has
                 * Black selected.
                 */

                var hasBlack =
                  selectedOptions.some(
                    function (value) {

                      return String(value)
                        .trim()
                        .toLowerCase() ===
                        'black';

                    }
                  );


                /*
                 * Check whether current product has
                 * Medium selected.
                 */

                var hasMedium =
                  selectedOptions.some(
                    function (value) {

                      return String(value)
                        .trim()
                        .toLowerCase() ===
                        'medium';

                    }
                  );


                console.log(
                  '[Popup] Automatic product condition:',
                  {
                    hasBlack: hasBlack,
                    hasMedium: hasMedium,
                    selectedOptions:
                      selectedOptions
                  }
                );


                /*
                 * ONLY add Soft Winter Jacket when:
                 *
                 * Black + Medium
                 */

                if (
                  hasBlack &&
                  hasMedium
                ) {

                  var autoVariant =
                    findAutoVariant(
                      autoProduct
                    );


                  if (autoVariant) {

                    /*
                     * Don't add the same product
                     * twice.
                     */

                    if (
                      Number(
                        autoProduct.productId
                      ) !==
                      Number(
                        selectedVariant.product_id
                      )
                    ) {

                      cartItems.push({

                        id: Number(
                          autoVariant.id
                        ),

                        quantity: 1

                      });


                      console.log(
                        '[Popup] Adding automatic product:',
                        autoVariant.id,
                        autoVariant.options
                      );

                    }

                  } else {

                    console.warn(
                      '[Popup] Black + Medium selected, but no Black + Medium variant exists on the automatic product.'
                    );

                  }

                }

              }


              /*
               * ------------------------------------------------
               * ADD ALL ITEMS
               * ------------------------------------------------
               */

              console.log(
                '[Popup] Final cart items:',
                cartItems
              );


              var response =
                await fetch(
                  window.Shopify.routes.root +
                  'cart/add.js',
                  {

                    method: 'POST',

                    headers: {

                      'Content-Type':
                        'application/json',

                      'Accept':
                        'application/json'

                    },

                    body:
                      JSON.stringify({
                        items:
                          cartItems
                      })

                  }
                );


              var data =
                await response.json();


              if (!response.ok) {

                throw new Error(
                  data.description ||
                  data.message ||
                  'Unable to add product to cart.'
                );

              }


              console.log(
                '[Popup] Added to cart:',
                data
              );


              /*
               * Let the Shopify theme update
               * its cart UI.
               */

              document.dispatchEvent(
                new CustomEvent(
                  'cart:updated'
                )
              );


              document.dispatchEvent(
                new CustomEvent(
                  'cart:refresh'
                )
              );


              document.dispatchEvent(
                new CustomEvent(
                  'ajaxProduct:added'
                )
              );


              /*
               * Try to update cart drawer.
               */

              var cartDrawer =
                document.querySelector(
                  'cart-drawer'
                );


              if (
                cartDrawer &&
                typeof cartDrawer.renderContents ===
                'function'
              ) {

                try {

                  var cartResponse =
                    await fetch(
                      window.Shopify.routes.root +
                      'cart.js'
                    );


                  var cart =
                    await cartResponse.json();


                  cartDrawer.renderContents(
                    cart
                  );

                } catch (drawerError) {

                  console.warn(
                    '[Popup] Cart drawer refresh failed:',
                    drawerError
                  );

                }

              }


              /*
               * Close popup after successful
               * add to cart.
               */

              closePopup(popup);


            } catch (error) {

              console.error(
                '[Popup] Add to cart error:',
                error
              );


              alert(
                error.message ||
                'Unable to add product to cart.'
              );


            } finally {

              form.dataset.submitting =
                'false';


              /*
               * Recalculate selected variant
               * and restore button state.
               */

              updateVariant();

            }

          }
        );

      }


      /*
       * ----------------------------------------------------------
       * INITIAL VARIANT
       * ----------------------------------------------------------
       */

      updateVariant();

    });

  }


  /*
   * ============================================================
   * INITIALIZE
   * ============================================================
   */

  function initialize() {

    initPopupSystem(
      document
    );

    /*
     * Initialize all forms immediately.
     */

    initPopupProductForms(
      document
    );

    initEscapeKey();

  }


  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initialize
    );

  } else {

    initialize();

  }


  /*
   * Shopify Theme Editor
   */

  document.addEventListener(
    'shopify:section:load',
    function (event) {

      var sectionElement =
        event.target;


      initPopupSystem(
        sectionElement
      );


      initPopupProductForms(
        sectionElement
      );

    }
  );


})();
</script>


{% schema %}
{
  "name": "Custom Featured Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading"
    },
    {
      "type": "product",
      "id": "select_product",
      "label": "Select Product",
      "info": "Product that is added automatically when Black and Medium is selected."
    },
    {
      "type": "text",
      "id": "section_padding_desktop",
      "label": "Section Padding (Desktop)",
      "info": "Write in this format (top right bottom left)"
    },
    {
      "type": "text",
      "id": "section_padding_mobile",
      "label": "Section Padding (Mobile)",
      "info": "Write in this format (top right bottom left)"
    }
  ],
  "blocks": [
    {
      "name": "Product",
      "type": "product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "header",
          "content": "Quick View Icon Position - Desktop"
        },
        {
          "type": "range",
          "id": "top",
          "label": "Top",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "bottom",
          "label": "Bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "left",
          "label": "Left",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "right",
          "label": "Right",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "header",
          "content": "Quick View Icon Position - Mobile"
        },
        {
          "type": "range",
          "id": "top_mb",
          "label": "Top (Mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "bottom_mb",
          "label": "Bottom (Mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "left_mb",
          "label": "Left (Mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 0,
