{% assign auto_added_product = section.settings.select_product.selected_or_first_available_variant.id %}

<div class="popup_product_content">
  <div class="product_popup_close" id="close-popup-{{ product.id }}">
    <img
      src="https://cdn.shopify.com/s/files/1/0740/2592/6742/files/Group_1000008157.svg?v=1786149863"
      alt="close_icon"
    >
  </div>

  <div class="image_with_info">
    <div class="popup_product_image">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          loading="lazy"
        >
      {% endif %}
    </div>

    <div class="popup_product_info">
      <h3 class="popup_product_title">
        {{ product.title }}
      </h3>

      <div class="popup_product_price">
        {{ product.selected_or_first_available_variant.price | money }}
      </div>

      {% if product.description != blank %}
        <div class="popup_product_description">
          {{ product.description | strip_html | truncatewords: 30 }}
        </div>
      {% endif %}
    </div>
  </div>

  <!-- No <form> tag at all now — plain div, no native submission possible -->
  <div class="popup_product_form">

    <input
      type="hidden"
      name="id"
      class="popup_variant_id"
      value="{{ product.selected_or_first_available_variant.id }}"
    >

    {% unless product.has_only_default_variant %}
      <div class="popup_product_options">

        {% for option in product.options_with_values %}

          <div
            class="popup_product_option"
            data-option-index="{{ forloop.index0 }}"
          >

            <label class="popup_option_label">
              {{ option.name }}
            </label>

            {% if forloop.first %}

              <div class="popup_select_wrapper">
                <select
                  class="popup_option_select"
                  data-option-index="{{ forloop.index0 }}"
                  placeholder="Choose your size;"
                >
                    <option value="" disabled selected>Choose your size</option>

                  {% for value in option.values %}
                    <option value="{{ value | escape }}">
                      {{ value }}
                    </option>
                  {% endfor %}

                </select>

                <span class="popup_select_arrow">↓</span>
              </div>

            {% else %}

              <div class="popup_option_buttons">

                {% for value in option.values %}

                  <button
                    type="button"
                    class="popup_option_button {% if option.selected_value == value %}is-selected{% endif %}"
                    style="border-left: 4px solid {{ value }}"
                    data-option-value="{{ value | escape }}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                  >
                    {{ value }}
                  </button>

                {% endfor %}

              </div>

            {% endif %}

          </div>

        {% endfor %}

      </div>
    {% endunless %}

    <!-- type="button" — never "submit", since there's no form to submit -->
    <button
      type="button"
      class="popup_add_to_cart custom-banner__button"
      {% unless product.selected_or_first_available_variant.available %}
        disabled
      {% endunless %}
    >
      <span class="popup_add_to_cart_text">
        {% if product.selected_or_first_available_variant.available %}
          ADD TO CART
          <span class="popup_add_to_cart_arrow"> &xrarr; </span>
        {% else %}
          SOLD OUT
        {% endif %}
      </span>
    </button>

  </div>

</div>


<script
  type="application/json"
  class="popup-product-json"
>
  {{ product | json }}
</script>


<script>
(function () {

  if (window.__quickViewInitialized) {
    return;
  }

  window.__quickViewInitialized = true;


  function closeAllPopups() {
    document.querySelectorAll('.product_popup.is-open').forEach(function (popup) {
      popup.classList.remove('is-open');
      popup.setAttribute('aria-hidden', 'true');
    });
    document.body.classList.remove('quick-view-open');
  }


  document.addEventListener('click', function (event) {
    var quickViewButton = event.target.closest('.quick_view_btn');
    if (!quickViewButton) return;

    event.preventDefault();

    var productId = quickViewButton.getAttribute('data-product-id');
    if (!productId) return;

    var popup = document.querySelector('#product-popup-' + productId);
    if (!popup) return;

    closeAllPopups();

    popup.classList.add('is-open');
    popup.setAttribute('aria-hidden', 'false');
    document.body.classList.add('quick-view-open');
  });


  document.addEventListener('click', function (event) {
    var closeButton = event.target.closest('.product_popup_close');

    if (closeButton) {
      event.preventDefault();
      var popup = closeButton.closest('.product_popup');
      if (popup) {
        popup.classList.remove('is-open');
        popup.setAttribute('aria-hidden', 'true');
      }
      document.body.classList.remove('quick-view-open');
      return;
    }

    var overlay = event.target.closest('.product_popup_overlay');
    if (overlay) {
      closeAllPopups();
    }
  });


  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;
    closeAllPopups();
  });


  function initializeProductPopup(content) {

    if (!content) return;

    if (content.dataset.quickViewInitialized === 'true') return;
    content.dataset.quickViewInitialized = 'true';

    /*
     * No more `.popup_product_form` being a <form> —
     * it's just a wrapper <div> now.
     */
    var wrapper = content.querySelector('.popup_product_form');
    if (!wrapper) return;

    var popup = content.closest('.product_popup');
    if (!popup) return;

    var variantInput = wrapper.querySelector('.popup_variant_id');
    var addButton = wrapper.querySelector('.popup_add_to_cart');
    var addButtonText = wrapper.querySelector('.popup_add_to_cart_text');
    var priceElement = popup.querySelector('.popup_product_price');
    var productDataElement = popup.querySelector('.popup-product-json');

    if (!variantInput || !productDataElement) return;

    var productData;

    try {
      productData = JSON.parse(productDataElement.textContent);
    } catch (error) {
      console.error('Quick View product JSON error:', error);
      return;
    }

    if (!productData || !productData.variants) return;


    function getSelectedOptions() {
      var selectedOptions = [];

      content.querySelectorAll('.popup_product_option').forEach(function (optionContainer) {
        var index = parseInt(optionContainer.getAttribute('data-option-index'), 10);

        var selectedButton = optionContainer.querySelector('.popup_option_button.is-selected');
        var select = optionContainer.querySelector('.popup_option_select');

        if (selectedButton) {
          selectedOptions[index] = selectedButton.getAttribute('data-option-value');
        } else if (select) {
          selectedOptions[index] = select.value;
        }
      });

      return selectedOptions;
    }


    function findSelectedVariant() {
      var selectedOptions = getSelectedOptions();

      if (
        !selectedOptions.length ||
        selectedOptions.some(function (value) {
          return typeof value === 'undefined';
        })
      ) {
        return null;
      }

      var variant = productData.variants.find(function (variant) {
        return variant.options.every(function (optionValue, index) {
          return String(optionValue).trim() === String(selectedOptions[index]).trim();
        });
      });

      return variant || null;
    }


    function updateVariant() {
      var variant = findSelectedVariant();

      if (!variant) {
        variantInput.value = '';
        if (addButton) addButton.disabled = true;
        if (addButtonText) addButtonText.textContent = 'UNAVAILABLE';
        return;
      }

      variantInput.value = String(variant.id);

      if (priceElement && typeof Shopify !== 'undefined' && Shopify.formatMoney) {
        priceElement.innerHTML = Shopify.formatMoney(variant.price, Shopify.money_format);
      }

      if (addButton) addButton.disabled = !variant.available;
      if (addButtonText) addButtonText.textContent = variant.available ? 'ADD TO CART' : 'SOLD OUT';
    }


    content.querySelectorAll('.popup_option_button').forEach(function (button) {
      button.addEventListener('click', function () {
        var index = this.getAttribute('data-option-index');

        content.querySelectorAll('.popup_option_button[data-option-index="' + index + '"]').forEach(function (item) {
          item.classList.remove('is-selected');
        });

        this.classList.add('is-selected');
        updateVariant();
      });
    });


    content.querySelectorAll('.popup_option_select').forEach(function (select) {
      select.addEventListener('change', function () {
        updateVariant();
      });
    });


    /* =========================================================
     * ADD TO CART — direct button click, no form/submit at all
     * ========================================================= */

    if (addButton) {

      addButton.addEventListener('click', function (event) {

        event.preventDefault();

        var selectedVariantId = variantInput.value;

        if (!selectedVariantId) {
          console.error('Quick View: No variant selected.');
          return;
        }

        if (wrapper.dataset.addingToCart === 'true') {
          return;
        }

        wrapper.dataset.addingToCart = 'true';

        addButton.disabled = true;
        if (addButtonText) addButtonText.textContent = 'ADDING...';

        var selectedOptions = getSelectedOptions();

        var normalizedOptions = selectedOptions.map(function (value) {
          return value ? String(value).trim().toLowerCase() : '';
        });

        var hasSizeM = normalizedOptions.indexOf('m') !== -1;
        var hasBlack = normalizedOptions.indexOf('black') !== -1;

        var items = [
          {
            id: Number(selectedVariantId),
            quantity: 1
          }
        ];

        var autoAddedProductId = Number({{ auto_added_product | default: 0 }});

        if (
          hasSizeM &&
          hasBlack &&
          autoAddedProductId &&
          autoAddedProductId !== Number(selectedVariantId)
        ) {
          items.push({
            id: autoAddedProductId,
            quantity: 1
          });
        }

        console.log('Quick View cart items:', items);

        fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ items: items })
        })
        .then(function (response) {
          if (!response.ok) {
            return response.json().then(function (error) {
              throw error;
            });
          }
          return response.json();
        })
        .then(function (data) {
          console.log('Quick View products added:', data);

          if (popup) {
            popup.classList.remove('is-open');
            popup.setAttribute('aria-hidden', 'true');
          }

          document.body.classList.remove('quick-view-open');

          document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
          document.dispatchEvent(new CustomEvent('cart:refresh', { detail: data }));

          window.location.href = window.Shopify.routes.root + 'cart';
        })
        .catch(function (error) {
          console.error('Quick View Add To Cart Error:', error);

          wrapper.dataset.addingToCart = 'false';

          var currentVariant = findSelectedVariant();
          addButton.disabled = !currentVariant || !currentVariant.available;

          if (addButtonText) {
            addButtonText.innerHTML = 'ADD TO CART <span class="popup_add_to_cart_arrow"> &xrarr; </span>';
          }
        });

      });
    }

    updateVariant();
  }


  function initializeAllPopups() {
    document.querySelectorAll('.popup_product_content').forEach(function (content) {
      initializeProductPopup(content);
    });
  }


  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeAllPopups);
  } else {
    initializeAllPopups();
  }


})();
</script>