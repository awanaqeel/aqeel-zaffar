{% assign auto_added_product = section.settings.select_product.selected_or_first_available_variant.id %}

<div class="popup_product_content">
  <div class="product_popup_close" id="close-popup-{{ product.id }}">
    <img
      src="https://cdn.shopify.com/s/files/1/0740/2592/6742/files/Group_1000008157.svg?v=1786149863"
      alt="close_icon"
    >
  </div>

  <div class="image_with_info">
    <!-- Product Image -->
    <div class="popup_product_image">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          loading="lazy"
        >
      {% endif %}
    </div>

    <!-- Product Information -->
    <div class="popup_product_info">

      <!-- Product Title -->
      <h3 class="popup_product_title">
        {{ product.title }}
      </h3>

      <!-- Product Price -->
      <div class="popup_product_price">
        {{ product.selected_or_first_available_variant.price | money }}
      </div>

      <!-- Description -->
      {% if product.description != blank %}
        <div class="popup_product_description">
          {{ product.description | strip_html | truncatewords: 30 }}
        </div>
      {% endif %}

    </div>
  </div>

  <!-- Product Form -->
  {% form 'product', product, class: 'popup_product_form' %}

    <input
      type="hidden"
      name="id"
      class="popup_variant_id"
      value="{{ product.selected_or_first_available_variant.id }}"
    >

    <!-- Product Options -->
    {% unless product.has_only_default_variant %}
      <div class="popup_product_options">

        {% for option in product.options_with_values %}

          <div
            class="popup_product_option"
            data-option-index="{{ forloop.index0 }}"
          >

            <label class="popup_option_label">
              {{ option.name }}
            </label>

            {% if forloop.first %}

              <!-- First option as select -->
              <div class="popup_select_wrapper">
                <select
                  class="popup_option_select"
                  data-option-index="{{ forloop.index0 }}"
                  placeholder="Choose your size;"
                >
                    <option value="" disabled selected>Choose your size</option>

                  {% for value in option.values %}
                    <option
                      value="{{ value | escape }}"
                    >
                      {{ value }}
                    </option>
                  {% endfor %}

                </select>

                <span class="popup_select_arrow">↓</span>
              </div>

            {% else %}

              <!-- Other options as buttons -->
              <div class="popup_option_buttons">

                {% for value in option.values %}

                  <button
                    type="button"
                    class="popup_option_button {% if option.selected_value == value %}is-selected{% endif %}"
                    style="border-left: 4px solid {{ value }}"
                    data-option-value="{{ value | escape }}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                  >
                    {{ value }}
                  </button>

                {% endfor %}

              </div>

            {% endif %}

          </div>

        {% endfor %}

      </div>
    {% endunless %}

    <!-- Add To Cart -->
    <button
      type="submit"
      name="add"
      class="popup_add_to_cart custom-banner__button"
      {% unless product.selected_or_first_available_variant.available %}
        disabled
      {% endunless %}
    >

      <span class="popup_add_to_cart_text">
        {% if product.selected_or_first_available_variant.available %}
          ADD TO CART
          <span class="popup_add_to_cart_arrow"> &xrarr; </span>
        {% else %}
          SOLD OUT
        {% endif %}
      </span>

    </button>

  {% endform %}

</div>


<!-- Product JSON -->
<script
  type="application/json"
  class="popup-product-json"
>
  {{ product | json }}
</script>


<script>
(function () {

  /*
   * IMPORTANT:
   *
   * This section can be rendered multiple times because
   * the popup exists for multiple products.
   *
   * We initialize the global popup events only once.
   * This prevents multiple cart submissions.
   */

  if (window.__quickViewInitialized) {
    return;
  }

  window.__quickViewInitialized = true;


  /* =========================================================
   * HELPER: CLOSE ALL POPUPS
   * ========================================================= */

  function closeAllPopups() {

    document.querySelectorAll('.product_popup.is-open').forEach(function (popup) {

      popup.classList.remove('is-open');

      popup.setAttribute('aria-hidden', 'true');

    });

    document.body.classList.remove('quick-view-open');
  }


  /* =========================================================
   * OPEN QUICK VIEW
   * ========================================================= */

  document.addEventListener('click', function (event) {

    var quickViewButton = event.target.closest('.quick_view_btn');

    if (!quickViewButton) {
      return;
    }

    event.preventDefault();

    var productId = quickViewButton.getAttribute('data-product-id');

    if (!productId) {
      return;
    }

    var popup = document.querySelector(
      '#product-popup-' + productId
    );

    if (!popup) {
      return;
    }


    /*
     * Close any popup that is already open.
     */
    closeAllPopups();


    /*
     * Open selected popup.
     */
    popup.classList.add('is-open');

    popup.setAttribute('aria-hidden', 'false');

    document.body.classList.add('quick-view-open');

  });


  /* =========================================================
   * CLOSE POPUP
   * ========================================================= */

  document.addEventListener('click', function (event) {

    /*
     * Close button
     */
    var closeButton = event.target.closest('.product_popup_close');

    if (closeButton) {

      event.preventDefault();

      var popup = closeButton.closest('.product_popup');

      if (popup) {

        popup.classList.remove('is-open');

        popup.setAttribute('aria-hidden', 'true');

      }

      document.body.classList.remove('quick-view-open');

      return;
    }


    /*
     * Overlay
     */
    var overlay = event.target.closest('.product_popup_overlay');

    if (overlay) {

      closeAllPopups();

    }

  });


  /* =========================================================
   * ESC KEY
   * ========================================================= */

  document.addEventListener('keydown', function (event) {

    if (event.key !== 'Escape') {
      return;
    }

    closeAllPopups();

  });


  /* =========================================================
   * INITIALIZE PRODUCT POPUPS
   * ========================================================= */

  function initializeProductPopup(content) {

    if (!content) {
      return;
    }


    /*
     * Prevent this particular popup from being initialized
     * more than once.
     */

    if (content.dataset.quickViewInitialized === 'true') {
      return;
    }

    content.dataset.quickViewInitialized = 'true';


    var form = content.querySelector('.popup_product_form');

    if (!form) {
      return;
    }


    var popup = content.closest('.product_popup');

    if (!popup) {
      return;
    }


    var variantInput = form.querySelector('.popup_variant_id');

    var addButton = form.querySelector('.popup_add_to_cart');

    var addButtonText = form.querySelector('.popup_add_to_cart_text');

    var priceElement = popup.querySelector('.popup_product_price');

    var productDataElement = popup.querySelector('.popup-product-json');


    if (!variantInput || !productDataElement) {
      return;
    }


    /* =========================================================
     * PRODUCT DATA
     * ========================================================= */

    var productData;

    try {

      productData = JSON.parse(
        productDataElement.textContent
      );

    } catch (error) {

      console.error(
        'Quick View product JSON error:',
        error
      );

      return;
    }


    if (!productData || !productData.variants) {
      return;
    }


    /* =========================================================
     * GET SELECTED OPTIONS
     * ========================================================= */

    function getSelectedOptions() {

      var selectedOptions = [];

      content
        .querySelectorAll('.popup_product_option')
        .forEach(function (optionContainer) {

          var index = parseInt(
            optionContainer.getAttribute('data-option-index'),
            10
          );


          /*
           * Button option
           */
          var selectedButton = optionContainer.querySelector(
            '.popup_option_button.is-selected'
          );


          /*
           * Select option
           */
          var select = optionContainer.querySelector(
            '.popup_option_select'
          );


          if (selectedButton) {

            selectedOptions[index] =
              selectedButton.getAttribute(
                'data-option-value'
              );

          } else if (select) {

            selectedOptions[index] = select.value;

          }

        });


      return selectedOptions;

    }


    /* =========================================================
     * FIND VARIANT
     * ========================================================= */

    function findSelectedVariant() {

      var selectedOptions = getSelectedOptions();


      /*
       * Make sure all options have a value.
       */

      if (
        !selectedOptions.length ||
        selectedOptions.some(function (value) {
          return typeof value === 'undefined';
        })
      ) {

        return null;

      }


      /*
       * Match exact Shopify variant.
       */

      var variant = productData.variants.find(
        function (variant) {

          return variant.options.every(
            function (optionValue, index) {

              return (
                String(optionValue).trim() ===
                String(selectedOptions[index]).trim()
              );

            }
          );

        }
      );


      return variant || null;

    }


    /* =========================================================
     * UPDATE VARIANT
     * ========================================================= */

    function updateVariant() {

      var variant = findSelectedVariant();


      /*
       * No matching variant.
       */

      if (!variant) {

        variantInput.value = '';

        if (addButton) {
          addButton.disabled = true;
        }

        if (addButtonText) {
          addButtonText.textContent = 'UNAVAILABLE';
        }

        return;

      }


      /*
       * IMPORTANT:
       *
       * Always update the hidden input with the
       * CURRENT selected variant ID.
       */

      variantInput.value = String(variant.id);


      /*
       * Update price.
       */

      if (
        priceElement &&
        typeof Shopify !== 'undefined' &&
        Shopify.formatMoney
      ) {

        priceElement.innerHTML =
          Shopify.formatMoney(
            variant.price,
            Shopify.money_format
          );

      }


      /*
       * Update Add To Cart button.
       */

      if (addButton) {

        addButton.disabled = !variant.available;

      }


      if (addButtonText) {

        addButtonText.textContent =
          variant.available
            ? 'ADD TO CART'
            : 'SOLD OUT';

      }

    }


    /* =========================================================
     * OPTION BUTTONS
     * ========================================================= */

    content
      .querySelectorAll('.popup_option_button')
      .forEach(function (button) {

        button.addEventListener(
          'click',
          function () {

            var index =
              this.getAttribute(
                'data-option-index'
              );


            /*
             * Remove selection from other buttons
             * of the same option.
             */

            content
              .querySelectorAll(
                '.popup_option_button[data-option-index="' +
                index +
                '"]'
              )
              .forEach(function (item) {

                item.classList.remove(
                  'is-selected'
                );

              });


            /*
             * Select clicked button.
             */

            this.classList.add(
              'is-selected'
            );


            /*
             * Update exact variant.
             */

            updateVariant();

          }
        );

      });


    /* =========================================================
     * SELECT OPTIONS
     * ========================================================= */

    content
      .querySelectorAll('.popup_option_select')
      .forEach(function (select) {

        select.addEventListener(
          'change',
          function () {

            /*
             * Update exact variant whenever
             * select value changes.
             */

            updateVariant();

          }
        );

      });


    /* =========================================================
     * ADD TO CART
     * ========================================================= */

    form.addEventListener(
      'submit',
      function (event) {

        event.preventDefault();
        event.stopPropagation();


        /*
         * Get the CURRENT variant directly
         * from the hidden input.
         */

        var selectedVariantId =
          variantInput.value;


        if (!selectedVariantId) {

          console.error(
            'Quick View: No variant selected.'
          );

          return;

        }


        /*
         * Prevent duplicate clicks/submissions.
         *
         * This is important because it prevents
         * quantity 2, 3, 4 etc.
         */

        if (form.dataset.addingToCart === 'true') {

          return;

        }


        form.dataset.addingToCart = 'true';


        /*
         * Disable button immediately.
         */

        if (addButton) {

          addButton.disabled = true;

        }


        if (addButtonText) {

          addButtonText.textContent =
            'ADDING...';

        }


        /* =====================================================
         * GET CURRENT SELECTED OPTIONS
         * ===================================================== */

        var selectedOptions =
          getSelectedOptions();


        /*
         * Normalize values.
         */

        var normalizedOptions =
          selectedOptions.map(function (value) {

            return value
              ? String(value)
                  .trim()
                  .toLowerCase()
              : '';

          });


        /*
         * Check Size M.
         */

        var hasSizeM =
          normalizedOptions.indexOf('m') !== -1;


        /*
         * Check Color Black.
         */

        var hasBlack =
          normalizedOptions.indexOf('black') !== -1;


        /* =====================================================
         * BUILD CART ITEMS
         * ===================================================== */

        var items = [

          {
            id: Number(selectedVariantId),
            quantity: 1
          }

        ];


        /*
         * If Size M + Color Black:
         *
         * Add auto_added_product exactly once.
         */

        var autoAddedProductId =
          Number({{ auto_added_product | default: 0 }});


        if (
          hasSizeM &&
          hasBlack &&
          autoAddedProductId &&
          autoAddedProductId !== Number(selectedVariantId)
        ) {

          items.push({

            id: autoAddedProductId,

            quantity: 1

          });

        }


        console.log(
          'Quick View cart items:',
          items
        );


        /* =====================================================
         * ADD TO SHOPIFY CART
         * ===================================================== */

        fetch(
          window.Shopify.routes.root + 'cart/add.js',
          {
            method: 'POST',

            headers: {

              'Content-Type':
                'application/json',

              'Accept':
                'application/json'

            },

            body: JSON.stringify({

              items: items

            })

          }
        )

        .then(function (response) {

          if (!response.ok) {

            return response
              .json()
              .then(function (error) {

                throw error;

              });

          }


          return response.json();

        })


        .then(function (data) {

          console.log(
            'Quick View products added:',
            data
          );


          /*
           * Close current popup.
           */

          if (popup) {

            popup.classList.remove(
              'is-open'
            );

            popup.setAttribute(
              'aria-hidden',
              'true'
            );

          }

          document.body.classList.remove(
            'quick-view-open'
          );


          /*
           * Tell the theme that the cart
           * has been updated.
           */

          document.dispatchEvent(
            new CustomEvent(
              'cart:updated',
              {
                detail: data
              }
            )
          );


          document.dispatchEvent(
            new CustomEvent(
              'cart:refresh',
              {
                detail: data
              }
            )
          );


          /*
           * If the theme has a cart drawer,
           * try to refresh it.
           */

          if (
            typeof window.refreshCart ===
            'function'
          ) {

            window.refreshCart();

          }


          /*
           * Reset form state.
           */

          form.dataset.addingToCart =
            'false';


          /*
           * Restore button state.
           */

          if (addButton) {

            addButton.disabled = false;

          }


          if (addButtonText) {

            addButtonText.innerHTML =
              'ADD TO CART <span class="popup_add_to_cart_arrow"> &xrarr; </span>';

          }

        })


        .catch(function (error) {

          console.error(
            'Quick View Add To Cart Error:',
            error
          );


          /*
           * Allow another attempt after
           * an error.
           */

          form.dataset.addingToCart =
            'false';


          /*
           * Restore button.
           */

          var currentVariant =
            findSelectedVariant();


          if (addButton) {

            addButton.disabled =
              !currentVariant ||
              !currentVariant.available;

          }


          if (addButtonText) {

            addButtonText.innerHTML =
              'ADD TO CART <span class="popup_add_to_cart_arrow"> &xrarr; </span>';

          }

        });

      }
    );


    /* =========================================================
     * INITIAL VARIANT
     * ========================================================= */

    updateVariant();

  }


  /* =========================================================
   * INITIALIZE ALL EXISTING POPUPS
   * ========================================================= */

  function initializeAllPopups() {

    document
      .querySelectorAll('.popup_product_content')
      .forEach(function (content) {

        initializeProductPopup(content);

      });

  }


  /*
   * Initialize immediately if DOM is already loaded.
   */

  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initializeAllPopups
    );

  } else {

    initializeAllPopups();

  }


})();
</script>