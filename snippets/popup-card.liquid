{% assign auto_product = section.settings.select_product %}

<div class="popup_product_info">

  <h3 class="popup_product_title">
    {{ product.title }}
  </h3>

  <div
    class="popup_product_price"
    data-original-price="{{ product.selected_or_first_available_variant.price }}"
  >
    {{ product.selected_or_first_available_variant.price | money }}
  </div>

  {% if product.description != blank %}
    <div class="popup_product_description">
      {{ product.description | strip_html | truncatewords: 30 }}
    </div>
  {% endif %}

</div>


{% form 'product',
  product,
  class: 'popup_product_form',
  data-product-id: product.id
%}

  <input
    type="hidden"
    name="id"
    class="popup_variant_id"
    value="{{ product.selected_or_first_available_variant.id }}"
  >


  {% unless product.has_only_default_variant %}

    <div class="popup_product_options">

      {% for option in product.options_with_values %}

        <div
          class="popup_product_option"
          data-option-index="{{ forloop.index0 }}"
          data-option-name="{{ option.name | escape }}"
        >

          <label class="popup_option_label">
            {{ option.name }}
          </label>


          {% if forloop.first %}

            <div class="popup_select_wrapper">

              <select
                class="popup_option_select"
                data-option-index="{{ forloop.index0 }}"
              >

                {% for value in option.values %}

                  <option
                    value="{{ value | escape }}"
                    {% if option.selected_value == value %}
                      selected
                    {% endif %}
                  >
                    {{ value }}
                  </option>

                {% endfor %}

              </select>

              <span class="popup_select_arrow">
                ↓
              </span>

            </div>


          {% else %}

            <div class="popup_option_buttons">

              {% for value in option.values %}

                <button
                  type="button"
                  class="
                    popup_option_button
                    {% if option.selected_value == value %}
                      is-selected
                    {% endif %}
                  "
                  data-option-value="{{ value | escape }}"
                  data-option-index="{{ forloop.parentloop.index0 }}"
                  style="border-left: 4px solid {{ value }}"
                >
                  {{ value }}
                </button>

              {% endfor %}

            </div>

          {% endif %}

        </div>

      {% endfor %}

    </div>

  {% endunless %}


  <button
    type="submit"
    name="add"
    class="popup_add_to_cart custom-banner__button"
    {% unless product.selected_or_first_available_variant.available %}
      disabled
    {% endunless %}
  >

    <span class="popup_add_to_cart_text">

      {% if product.selected_or_first_available_variant.available %}

        ADD TO CART

        <span class="popup_add_to_cart_arrow">
          &xrarr;
        </span>

      {% else %}

        SOLD OUT

      {% endif %}

    </span>

  </button>

{% endform %}


<!--
  ============================================================
  CURRENT PRODUCT VARIANTS
  ============================================================
-->

<script
  type="application/json"
  class="popup-product-variants"
>
[
  {% for variant in product.variants %}
    {
      "id": {{ variant.id | json }},
      "product_id": {{ product.id | json }},
      "available": {{ variant.available | json }},
      "price": {{ variant.price | json }},
      "options": {{ variant.options | json }},
      "title": {{ variant.title | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
</script>


<!--
  ============================================================
  AUTOMATIC PRODUCT
  ============================================================
-->

{% if auto_product != blank %}

  <script
    type="application/json"
    class="popup-auto-product-data"
  >
  {
    "product_id": {{ auto_product.id | json }},
    "title": {{ auto_product.title | json }},
    "options": {{ auto_product.options | json }},
    "variants": [
      {% for variant in auto_product.variants %}
        {
          "id": {{ variant.id | json }},
          "product_id": {{ auto_product.id | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | json }},
          "options": {{ variant.options | json }},
          "title": {{ variant.title | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
  </script>

{% endif %}