{% comment %}
  ============================================================
  QUICK VIEW PRODUCT POPUP
  ============================================================
{% endcomment %}

{% assign auto_added_product = section.settings.select_product %}

<div class="popup_product_content">

  <!-- ========================================================
       CLOSE BUTTON
       ======================================================== -->

  <button
    type="button"
    class="product_popup_close"
    id="close-popup-{{ product.id }}"
    aria-label="Close"
  >
    <img
      src="https://cdn.shopify.com/s/files/1/0740/2592/6742/files/Group_1000008157.svg?v=1786149863"
      alt="Close"
    >
  </button>


  <!-- ========================================================
       PRODUCT IMAGE + INFORMATION
       ======================================================== -->

  <div class="image_with_info">

    <!-- Product Image -->
    <div class="popup_product_image">

      {% if product.featured_image %}

        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          loading="lazy"
        >

      {% endif %}

    </div>


    <!-- Product Information -->
    <div class="popup_product_info">

      <!-- Product Title -->
      <h3 class="popup_product_title">
        {{ product.title }}
      </h3>


      <!-- Product Price -->
      <div class="popup_product_price">
        {{ product.selected_or_first_available_variant.price | money }}
      </div>


      <!-- Product Description -->
      {% if product.description != blank %}

        <div class="popup_product_description">
          {{ product.description | strip_html | truncatewords: 30 }}
        </div>

      {% endif %}

    </div>

  </div>


  <!-- ========================================================
       PRODUCT FORM
       ======================================================== -->

  {% form 'product',
    product,
    class: 'popup_product_form'
  %}

    <!--
      IMPORTANT:
      This value is intentionally empty initially.

      We do NOT want Shopify to use the first available
      variant when the customer has not selected a variant.
    -->

    <input
      type="hidden"
      name="id"
      class="popup_variant_id"
      value=""
    >


    <!-- ======================================================
         PRODUCT OPTIONS
         ====================================================== -->

    {% unless product.has_only_default_variant %}

      <div class="popup_product_options">

        {% for option in product.options_with_values %}

          <div
            class="popup_product_option"
            data-option-index="{{ forloop.index0 }}"
            data-option-name="{{ option.name | escape }}"
          >

            <label class="popup_option_label">
              {{ option.name }}
            </label>


            {% if forloop.first %}

              <!-- ============================================
                   FIRST OPTION - SELECT
                   ============================================ -->

              <div class="popup_select_wrapper">

                <select
                  class="popup_option_select"
                  data-option-index="{{ forloop.index0 }}"
                >

                  <option
                    value=""
                    disabled
                    selected
                  >
                    Choose your size
                  </option>


                  {% for value in option.values %}

                    <option
                      value="{{ value | escape }}"
                    >
                      {{ value }}
                    </option>

                  {% endfor %}

                </select>

                <span class="popup_select_arrow">
                  ↓
                </span>

              </div>


            {% else %}


              <!-- ============================================
                   OTHER OPTIONS - BUTTONS
                   ============================================ -->

              <div class="popup_option_buttons">

                {% for value in option.values %}

                  <button
                    type="button"
                    class="popup_option_button"
                    data-option-value="{{ value | escape }}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    {% if option.name | downcase == 'color' %}
                      style="border-left: 4px solid {{ value }}"
                    {% endif %}
                  >
                    {{ value }}
                  </button>

                {% endfor %}

              </div>

            {% endif %}

          </div>

        {% endfor %}

      </div>

    {% endunless %}


    <!-- ======================================================
         ADD TO CART
         ====================================================== -->

    <button
      type="submit"
      name="add"
      class="popup_add_to_cart custom-banner__button"
      disabled
    >

      <span class="popup_add_to_cart_text">
        CHOOSE OPTIONS
      </span>

    </button>

  {% endform %}

</div>


<!-- ==========================================================
     CURRENT PRODUCT JSON
     ========================================================== -->

<script
  type="application/json"
  class="popup-product-json"
>
  {{ product | json }}
</script>


<!-- ==========================================================
     AUTO ADDED PRODUCT JSON
     ========================================================== -->

{% if auto_added_product != blank %}

  <script
    type="application/json"
    class="auto-added-product-json"
  >
    {{ auto_added_product | json }}
  </script>

{% endif %}

<script>
(function () {

  /* =========================================================
     QUICK VIEW POPUP
     ========================================================= */

  function closeAllPopups() {

    document
      .querySelectorAll('.product_popup.is-open')
      .forEach(function (popup) {

        popup.classList.remove('is-open');

        popup.setAttribute(
          'aria-hidden',
          'true'
        );

      });

    document.body.classList.remove(
      'quick-view-open'
    );
  }


  /* =========================================================
     OPEN POPUP
     ========================================================= */

  document.addEventListener(
    'click',
    function (event) {

      var button =
        event.target.closest('.quick_view_btn');

      if (!button) {
        return;
      }

      event.preventDefault();
      event.stopPropagation();


      var productId =
        button.getAttribute(
          'data-product-id'
        );

      if (!productId) {
        console.error(
          'Quick View: data-product-id missing'
        );

        return;
      }


      var popup =
        document.querySelector(
          '#product-popup-' + productId
        );


      if (!popup) {

        console.error(
          'Quick View: popup not found:',
          '#product-popup-' + productId
        );

        return;
      }


      /*
       * Close all other popups first.
       */

      closeAllPopups();


      /*
       * Open selected popup.
       */

      popup.classList.add(
        'is-open'
      );

      popup.setAttribute(
        'aria-hidden',
        'false'
      );

      document.body.classList.add(
        'quick-view-open'
      );

    },
    true
  );


  /* =========================================================
     CLOSE POPUP
     ========================================================= */

  document.addEventListener(
    'click',
    function (event) {

      /*
       * YOUR ORIGINAL CODE USES:
       *
       * .close_popup
       */

      var closeButton =
        event.target.closest(
          '.close_popup'
        );


      if (closeButton) {

        event.preventDefault();
        event.stopPropagation();

        closeAllPopups();

        return;
      }


      /*
       * Also support the newer class just in case.
       */

      var closeButtonNew =
        event.target.closest(
          '.product_popup_close'
        );


      if (closeButtonNew) {

        event.preventDefault();
        event.stopPropagation();

        closeAllPopups();

        return;
      }


      /*
       * Overlay close.
       */

      var overlay =
        event.target.closest(
          '.product_popup_overlay'
        );


      if (overlay) {

        closeAllPopups();

      }

    },
    true
  );


  /* =========================================================
     ESC CLOSE
     ========================================================= */

  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {

        closeAllPopups();

      }

    }
  );


  /* =========================================================
     GET PRODUCT DATA
     ========================================================= */

  function getProductData(popup) {

    if (!popup) {
      return null;
    }


    var json =
      popup.querySelector(
        '.popup-product-json'
      );


    if (!json) {

      console.error(
        'Quick View: product JSON not found'
      );

      return null;
    }


    try {

      return JSON.parse(
        json.textContent
      );

    } catch (error) {

      console.error(
        'Quick View: invalid product JSON',
        error
      );

      return null;
    }

  }


  /* =========================================================
     GET AUTO ADDED PRODUCT
     ========================================================= */

  function getAutoAddedProduct(popup) {

    if (!popup) {
      return null;
    }


    var json =
      popup.querySelector(
        '.auto-added-product-json'
      );


    if (!json) {

      console.warn(
        'Quick View: auto-added product JSON not found'
      );

      return null;
    }


    try {

      return JSON.parse(
        json.textContent
      );

    } catch (error) {

      console.error(
        'Quick View: invalid auto product JSON',
        error
      );

      return null;
    }

  }


  /* =========================================================
     GET SELECTED OPTIONS
     ========================================================= */

  function getSelectedOptions(content) {

    var selectedOptions = [];


    content
      .querySelectorAll(
        '.popup_product_option'
      )
      .forEach(function (optionContainer) {

        var index =
          parseInt(
            optionContainer.getAttribute(
              'data-option-index'
            ),
            10
          );


        /*
         * Button option
         */

        var selectedButton =
          optionContainer.querySelector(
            '.popup_option_button.is-selected'
          );


        /*
         * Select option
         */

        var select =
          optionContainer.querySelector(
            '.popup_option_select'
          );


        if (selectedButton) {

          selectedOptions[index] =
            selectedButton.getAttribute(
              'data-option-value'
            );

        }
        else if (select) {

          selectedOptions[index] =
            select.value;

        }

      });


    return selectedOptions;

  }


  /* =========================================================
     FIND VARIANT
     ========================================================= */

  function findVariant(
    product,
    selectedOptions
  ) {

    if (
      !product ||
      !product.variants
    ) {

      return null;

    }


    /*
     * Don't select a variant until
     * all options have been selected.
     */

    var complete =
      product.options.length ===
      selectedOptions.length &&
      selectedOptions.every(
        function (value) {

          return (
            value !== undefined &&
            value !== null &&
            value !== ''
          );

        }
      );


    if (!complete) {

      return null;

    }


    return product.variants.find(
      function (variant) {

        return variant.options.every(
          function (
            optionValue,
            index
          ) {

            return (
              String(optionValue)
                .trim()
                .toLowerCase() ===

              String(
                selectedOptions[index]
              )
                .trim()
                .toLowerCase()
            );

          }
        );

      }
    ) || null;

  }


  /* =========================================================
     UPDATE VARIANT
     ========================================================= */

  function updateVariant(content) {

    if (!content) {
      return;
    }


    var popup =
      content.closest(
        '.product_popup'
      );


    if (!popup) {

      console.error(
        'Quick View: product_popup wrapper not found'
      );

      return;

    }


    var form =
      content.querySelector(
        '.popup_product_form'
      );


    var input =
      form.querySelector(
        '.popup_variant_id'
      );


    var button =
      form.querySelector(
        '.popup_add_to_cart'
      );


    var buttonText =
      form.querySelector(
        '.popup_add_to_cart_text'
      );


    var price =
      popup.querySelector(
        '.popup_product_price'
      );


    var product =
      getProductData(popup);


    if (
      !form ||
      !input ||
      !product
    ) {

      return;

    }


    var selectedOptions =
      getSelectedOptions(content);


    console.log(
      'SELECTED OPTIONS:',
      selectedOptions
    );


    var variant =
      findVariant(
        product,
        selectedOptions
      );


    /*
     * No complete variant selected.
     */

    if (!variant) {

      input.value = '';


      if (button) {
        button.disabled = true;
      }


      if (buttonText) {
        buttonText.textContent =
          'CHOOSE OPTIONS';
      }


      return;

    }


    /*
     * IMPORTANT:
     *
     * Update the Shopify variant ID.
     */

    input.value =
      String(variant.id);


    console.log(
      'SELECTED VARIANT ID:',
      variant.id
    );


    /*
     * Update price.
     */

    if (
      price &&
      typeof Shopify !== 'undefined' &&
      typeof Shopify.formatMoney ===
        'function'
    ) {

      price.innerHTML =
        Shopify.formatMoney(
          variant.price,
          Shopify.money_format
        );

    }


    /*
     * Availability.
     */

    if (button) {

      button.disabled =
        !variant.available;

    }


    if (buttonText) {

      buttonText.textContent =
        variant.available
          ? 'ADD TO CART'
          : 'SOLD OUT';

    }

  }


  /* =========================================================
     OPTION BUTTON
     ========================================================= */

  document.addEventListener(
    'click',
    function (event) {

      var optionButton =
        event.target.closest(
          '.popup_option_button'
        );


      if (!optionButton) {
        return;
      }


      var content =
        optionButton.closest(
          '.popup_product_content'
        );


      if (!content) {
        return;
      }


      event.preventDefault();


      var index =
        optionButton.getAttribute(
          'data-option-index'
        );


      /*
       * Remove selected state from
       * other buttons of same option.
       */

      content
        .querySelectorAll(
          '.popup_option_button[data-option-index="' +
          index +
          '"]'
        )
        .forEach(
          function (button) {

            button.classList.remove(
              'is-selected'
            );

          }
        );


      /*
       * Select clicked value.
       */

      optionButton.classList.add(
        'is-selected'
      );


      /*
       * Update variant ID.
       */

      updateVariant(content);

    }
  );


  /* =========================================================
     SELECT CHANGE
     ========================================================= */

  document.addEventListener(
    'change',
    function (event) {

      var select =
        event.target.closest(
          '.popup_option_select'
        );


      if (!select) {
        return;
      }


      var content =
        select.closest(
          '.popup_product_content'
        );


      if (!content) {
        return;
      }


      updateVariant(content);

    }
  );


  /* =========================================================
     CHECK M + BLACK
     ========================================================= */

  function isMediumBlack(
    selectedOptions
  ) {

    var values =
      selectedOptions.map(
        function (value) {

          return value
            ? String(value)
                .trim()
                .toLowerCase()
            : '';

        }
      );


    var hasMedium =
      values.indexOf('m') !== -1 ||
      values.indexOf('medium') !== -1;


    var hasBlack =
      values.indexOf('black') !== -1;


    return (
      hasMedium &&
      hasBlack
    );

  }


  /* =========================================================
     FIND M + BLACK VARIANT
     IN AUTO PRODUCT
     ========================================================= */

  function findAutoVariant(
    autoProduct
  ) {

    if (
      !autoProduct ||
      !autoProduct.variants
    ) {

      return null;

    }


    return autoProduct.variants.find(
      function (variant) {

        var values =
          variant.options.map(
            function (value) {

              return String(value)
                .trim()
                .toLowerCase();

            }
          );


        var black =
          values.indexOf('black') !== -1;


        var medium =
          values.indexOf('m') !== -1 ||
          values.indexOf('medium') !== -1;


        return (
          black &&
          medium
        );

      }
    ) || null;

  }


  /* =========================================================
     ADD TO CART
     ========================================================= */

  document.addEventListener(
    'submit',
    function (event) {

      var form =
        event.target.closest(
          '.popup_product_form'
        );


      if (!form) {
        return;
      }


      event.preventDefault();
      event.stopImmediatePropagation();


      /*
       * Prevent multiple clicks.
       */

      if (
        form.dataset.submitting ===
        'true'
      ) {

        return;

      }


      var content =
        form.closest(
          '.popup_product_content'
        );


      var popup =
        content.closest(
          '.product_popup'
        );


      var input =
        form.querySelector(
          '.popup_variant_id'
        );


      var button =
        form.querySelector(
          '.popup_add_to_cart'
        );


      var buttonText =
        form.querySelector(
          '.popup_add_to_cart_text'
        );


      if (
        !content ||
        !popup ||
        !input
      ) {

        return;

      }


      /*
       * Get EXACT selected variant.
       */

      var variantId =
        input.value;


      console.log(
        'CART VARIANT ID:',
        variantId
      );


      if (!variantId) {

        console.error(
          'No variant selected'
        );

        updateVariant(content);

        return;

      }


      /*
       * Lock form.
       */

      form.dataset.submitting =
        'true';


      if (button) {
        button.disabled = true;
      }


      if (buttonText) {
        buttonText.textContent =
          'ADDING...';
      }


      /* =======================================================
         MAIN PRODUCT
         ======================================================= */

      var items = [

        {
          id: Number(variantId),
          quantity: 1
        }

      ];


      /* =======================================================
         AUTO PRODUCT
         ======================================================= */

      var selectedOptions =
        getSelectedOptions(content);


      if (
        isMediumBlack(
          selectedOptions
        )
      ) {

        console.log(
          'M + BLACK DETECTED'
        );


        var autoProduct =
          getAutoAddedProduct(
            popup
          );


        if (autoProduct) {

          var autoVariant =
            findAutoVariant(
              autoProduct
            );


          if (autoVariant) {

            console.log(
              'AUTO PRODUCT:',
              autoProduct.title
            );


            console.log(
              'AUTO PRODUCT VARIANT:',
              autoVariant.id,
              autoVariant.options
            );


            items.push({

              id: Number(
                autoVariant.id
              ),

              quantity: 1

            });

          }
          else {

            console.error(
              'M + Black variant not found in auto product'
            );

          }

        }

      }


      console.log(
        'FINAL ITEMS:',
        items
      );


      /* =======================================================
         SHOPIFY CART
         ======================================================= */

      var cartUrl =
        (
          window.Shopify &&
          Shopify.routes &&
          Shopify.routes.root
        )
          ? Shopify.routes.root +
            'cart/add.js'
          : '/cart/add.js';


      fetch(
        cartUrl,
        {

          method: 'POST',

          headers: {

            'Content-Type':
              'application/json',

            'Accept':
              'application/json'

          },

          body: JSON.stringify({

            items: items

          })

        }
      )


      .then(
        function (response) {

          if (!response.ok) {

            return response
              .json()
              .then(
                function (error) {

                  throw error;

                }
              );

          }


          return response.json();

        }
      )


      .then(
        function (data) {

          console.log(
            'ADDED TO CART:',
            data
          );


          /*
           * Unlock.
           */

          form.dataset.submitting =
            'false';


          /*
           * Close popup.
           */

          closeAllPopups();


          /*
           * Notify Shopify theme.
           */

          document.dispatchEvent(
            new CustomEvent(
              'cart:updated',
              {
                detail: data
              }
            )
          );


          document.dispatchEvent(
            new CustomEvent(
              'cart:refresh',
              {
                detail: data
              }
            )
          );


          /*
           * Redirect to cart.
           *
           * Remove this line if your theme
           * already opens the cart drawer.
           */

          window.location.href =
            (
              window.Shopify &&
              Shopify.routes &&
              Shopify.routes.root
            )
              ? Shopify.routes.root +
                'cart'
              : '/cart';

        }
      )


      .catch(
        function (error) {

          console.error(
            'ADD TO CART ERROR:',
            error
          );


          form.dataset.submitting =
            'false';


          updateVariant(
            content
          );

        }
      );

    },
    true
  );


  /* =========================================================
     INITIALIZE EXISTING POPUPS
     ========================================================= */

  function initializeQuickViews() {

    document
      .querySelectorAll(
        '.popup_product_content'
      )
      .forEach(
        function (content) {

          var form =
            content.querySelector(
              '.popup_product_form'
            );


          if (!form) {
            return;
          }


          var input =
            form.querySelector(
              '.popup_variant_id'
            );


          var button =
            form.querySelector(
              '.popup_add_to_cart'
            );


          var buttonText =
            form.querySelector(
              '.popup_add_to_cart_text'
            );


          /*
           * Do NOT automatically select
           * first variant.
           */

          if (input) {
            input.value = '';
          }


          if (button) {
            button.disabled = true;
          }


          if (buttonText) {
            buttonText.textContent =
              'CHOOSE OPTIONS';
          }

        }
      );

  }


  /*
   * Run now.
   *
   * This is important for Shopify Theme Editor
   * where DOMContentLoaded may already have fired.
   */

  initializeQuickViews();


})();
</script>