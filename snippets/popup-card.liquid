{% assign auto_added_product = section.settings.select_product.selected_or_first_available_variant.id %}

<div class="popup_product_content">
  <div class="product_popup_close" id="close-popup-{{ product.id }}">
    <img
      src="https://cdn.shopify.com/s/files/1/0740/2592/6742/files/Group_1000008157.svg?v=1786149863"
      alt="close_icon"
    >
  </div>

  <div class="image_with_info">
    <!-- Product Image -->
    <div class="popup_product_image">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          loading="lazy"
        >
      {% endif %}
    </div>

    <!-- Product Information -->
    <div class="popup_product_info">

      <!-- Product Title -->
      <h3 class="popup_product_title">
        {{ product.title }}
      </h3>

      <!-- Product Price -->
      <div class="popup_product_price">
        {{ product.selected_or_first_available_variant.price | money }}
      </div>

      <!-- Description -->
      {% if product.description != blank %}
        <div class="popup_product_description">
          {{ product.description | strip_html | truncatewords: 30 }}
        </div>
      {% endif %}

    </div>
  </div>

  <!-- Product Form -->
  {% form 'product', product, class: 'popup_product_form' %}

    <input
      type="hidden"
      name="id"
      class="popup_variant_id"
      value="{{ product.selected_or_first_available_variant.id }}"
    >

    <!-- Product Options -->
    {% unless product.has_only_default_variant %}
      <div class="popup_product_options">

        {% for option in product.options_with_values %}

          <div
            class="popup_product_option"
            data-option-index="{{ forloop.index0 }}"
          >

            <label class="popup_option_label">
              {{ option.name }}
            </label>

            {% if forloop.first %}

              <!-- First option as select -->
              <div class="popup_select_wrapper">
                <select
                  class="popup_option_select"
                  data-option-index="{{ forloop.index0 }}"
                >

                  {% for value in option.values %}
                    <option
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}
                        selected
                      {% endif %}
                    >
                      {{ value }}
                    </option>
                  {% endfor %}

                </select>

                <span class="popup_select_arrow">↓</span>
              </div>

            {% else %}

              <!-- Other options as buttons -->
              <div class="popup_option_buttons">

                {% for value in option.values %}

                  <button
                    type="button"
                    class="popup_option_button {% if option.selected_value == value %}is-selected{% endif %}"
                    style="border-left: 4px solid {{ value }}"
                    data-option-value="{{ value | escape }}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                  >
                    {{ value }}
                  </button>

                {% endfor %}

              </div>

            {% endif %}

          </div>

        {% endfor %}

      </div>
    {% endunless %}

    <!-- Add To Cart -->
    <button
      type="submit"
      name="add"
      class="popup_add_to_cart custom-banner__button"
      {% unless product.selected_or_first_available_variant.available %}
        disabled
      {% endunless %}
    >

      <span class="popup_add_to_cart_text">
        {% if product.selected_or_first_available_variant.available %}
          ADD TO CART
          <span class="popup_add_to_cart_arrow"> &xrarr; </span>
        {% else %}
          SOLD OUT
        {% endif %}
      </span>

    </button>

  {% endform %}

  <!-- Product JSON (kept inside the popup content so each popup carries its own data) -->
  <script type="application/json" class="popup-product-json">
    {{ product | json }}
  </script>

</div>


<script>
document.addEventListener('DOMContentLoaded', function () {

  /* =========================================================
   * CLOSE ALL POPUPS
   * ========================================================= */

  function closeAllPopups() {
    document.querySelectorAll('.product_popup.is-open').forEach(function (popup) {
      popup.classList.remove('is-open');
      popup.setAttribute('aria-hidden', 'true');
    });

    document.body.classList.remove('quick-view-open');
  }


  /* =========================================================
   * OPEN POPUP
   * ========================================================= */

  document.addEventListener('click', function (event) {

    var quickViewButton = event.target.closest('.quick_view_btn');

    if (!quickViewButton) {
      return;
    }

    event.preventDefault();

    var productId = quickViewButton.getAttribute('data-product-id');

    if (!productId) {
      return;
    }

    var popup = document.querySelector(
      '#product-popup-' + productId
    );

    if (!popup) {
      console.error('Popup not found:', productId);
      return;
    }

    /* Close any other popup first */
    closeAllPopups();

    /* Open selected popup */
    popup.classList.add('is-open');
    popup.setAttribute('aria-hidden', 'false');

    document.body.classList.add('quick-view-open');

  });


  /* =========================================================
   * CLOSE POPUP
   * ========================================================= */

  document.addEventListener('click', function (event) {

    var closeButton = event.target.closest('.product_popup_close');

    if (closeButton) {

      event.preventDefault();

      var popup = closeButton.closest('.product_popup');

      if (popup) {
        popup.classList.remove('is-open');
        popup.setAttribute('aria-hidden', 'true');
      }

      document.body.classList.remove('quick-view-open');

      return;
    }


    /* Overlay close */

    var overlay = event.target.closest('.product_popup_overlay');

    if (overlay) {
      closeAllPopups();
    }

  });


  /* =========================================================
   * ESC KEY
   * ========================================================= */

  document.addEventListener('keydown', function (event) {

    if (event.key === 'Escape') {
      closeAllPopups();
    }

  });


  /* =========================================================
   * GET PRODUCT DATA
   * ========================================================= */

  function getProductData(popup) {

    var jsonElement = popup.querySelector(
      '.popup-product-json'
    );

    if (!jsonElement) {
      console.error(
        'Product JSON not found',
        popup
      );

      return null;
    }

    try {

      return JSON.parse(
        jsonElement.textContent
      );

    } catch (error) {

      console.error(
        'Unable to parse product JSON:',
        error
      );

      return null;
    }

  }


  /* =========================================================
   * GET SELECTED OPTIONS
   * ========================================================= */

  function getSelectedOptions(content) {

    var selectedOptions = [];

    content
      .querySelectorAll('.popup_product_option')
      .forEach(function (optionContainer) {

        var index = parseInt(
          optionContainer.getAttribute(
            'data-option-index'
          ),
          10
        );


        /* Selected button */

        var selectedButton =
          optionContainer.querySelector(
            '.popup_option_button.is-selected'
          );


        /* Select */

        var select =
          optionContainer.querySelector(
            '.popup_option_select'
          );


        if (selectedButton) {

          selectedOptions[index] =
            selectedButton.getAttribute(
              'data-option-value'
            );

        } else if (select) {

          selectedOptions[index] =
            select.value;

        }

      });

    return selectedOptions;

  }


  /* =========================================================
   * UPDATE VARIANT
   * ========================================================= */

  function updateVariant(content) {

    var popup = content.closest('.product_popup');

    if (!popup) {
      return;
    }


    var form =
      content.querySelector(
        '.popup_product_form'
      );

    if (!form) {
      return;
    }


    var variantInput =
      form.querySelector(
        '.popup_variant_id'
      );


    var addButton =
      form.querySelector(
        '.popup_add_to_cart'
      );


    var addButtonText =
      form.querySelector(
        '.popup_add_to_cart_text'
      );


    var priceElement =
      popup.querySelector(
        '.popup_product_price'
      );


    if (!variantInput) {
      console.error(
        'Variant hidden input not found',
        form
      );

      return;
    }


    var productData =
      getProductData(popup);


    if (
      !productData ||
      !productData.variants
    ) {
      return;
    }


    var selectedOptions =
      getSelectedOptions(content);


    console.log(
      'Selected options:',
      selectedOptions
    );


    /*
     * Don't try to find a variant until
     * every option has been selected.
     */

    var allOptionsSelected =
      selectedOptions.length === productData.options.length &&
      selectedOptions.every(function (value) {
        return value !== undefined &&
               value !== null &&
               value !== '';
      });


    if (!allOptionsSelected) {

      /*
       * IMPORTANT:
       * Clear the hidden variant ID.
       *
       * This prevents Shopify from adding
       * the first variant.
       */

      variantInput.value = '';

      console.log(
        'No complete variant selected'
      );

      if (addButton) {
        addButton.disabled = true;
      }

      if (addButtonText) {
        addButtonText.textContent =
          'CHOOSE OPTIONS';
      }

      return;
    }


    /* =======================================================
     * FIND EXACT VARIANT
     * ======================================================= */

    var variant =
      productData.variants.find(
        function (productVariant) {

          return productVariant.options.every(
            function (optionValue, index) {

              return (
                String(optionValue).trim() ===
                String(selectedOptions[index]).trim()
              );

            }
          );

        }
      );


    console.log(
      'Matched variant:',
      variant
    );


    /* =======================================================
     * NO MATCHING VARIANT
     * ======================================================= */

    if (!variant) {

      variantInput.value = '';

      if (addButton) {
        addButton.disabled = true;
      }

      if (addButtonText) {
        addButtonText.textContent =
          'UNAVAILABLE';
      }

      return;
    }


    /* =======================================================
     * UPDATE HIDDEN INPUT
     * ======================================================= */

    /*
     * THIS IS THE IMPORTANT PART.
     *
     * The actual selected Shopify variant ID
     * is written into the input used by the form.
     */

    variantInput.value = String(
      variant.id
    );


    /*
     * Also force the input event/change event.
     * This helps if another Shopify/theme script
     * is watching this field.
     */

    variantInput.dispatchEvent(
      new Event('change', {
        bubbles: true
      })
    );


    console.log(
      'UPDATED VARIANT INPUT:',
      variantInput.value
    );


    /* =======================================================
     * UPDATE PRICE
     * ======================================================= */

    if (
      priceElement &&
      typeof Shopify !== 'undefined' &&
      typeof Shopify.formatMoney === 'function'
    ) {

      priceElement.innerHTML =
        Shopify.formatMoney(
          variant.price,
          Shopify.money_format
        );

    }


    /* =======================================================
     * UPDATE BUTTON
     * ======================================================= */

    if (addButton) {

      addButton.disabled =
        !variant.available;

    }


    if (addButtonText) {

      addButtonText.innerHTML =
        variant.available
          ? 'ADD TO CART <span class="popup_add_to_cart_arrow"> &xrarr; </span>'
          : 'SOLD OUT';

    }

  }


  /* =========================================================
   * VARIANT BUTTON CLICK
   * ========================================================= */

  document.addEventListener('click', function (event) {

    var button =
      event.target.closest(
        '.popup_option_button'
      );

    if (!button) {
      return;
    }


    event.preventDefault();


    var content =
      button.closest(
        '.popup_product_content'
      );

    if (!content) {
      return;
    }


    var optionIndex =
      button.getAttribute(
        'data-option-index'
      );


    /*
     * Remove selected class from
     * buttons belonging to same option.
     */

    content
      .querySelectorAll(
        '.popup_option_button[data-option-index="' +
        optionIndex +
        '"]'
      )
      .forEach(function (item) {

        item.classList.remove(
          'is-selected'
        );

      });


    /*
     * Select clicked option.
     */

    button.classList.add(
      'is-selected'
    );


    /*
     * Update variant immediately.
     */

    updateVariant(content);

  });


  /* =========================================================
   * VARIANT SELECT CHANGE
   * ========================================================= */

  document.addEventListener('change', function (event) {

    var select =
      event.target.closest(
        '.popup_option_select'
      );

    if (!select) {
      return;
    }


    var content =
      select.closest(
        '.popup_product_content'
      );

    if (!content) {
      return;
    }


    /*
     * Update variant immediately.
     */

    updateVariant(content);

  });


  /* =========================================================
   * ADD TO CART
   * ========================================================= */

  document.addEventListener('submit', function (event) {

    var form =
      event.target.closest(
        '.popup_product_form'
      );

    if (!form) {
      return;
    }


    event.preventDefault();
    event.stopPropagation();


    var content =
      form.closest(
        '.popup_product_content'
      );

    if (!content) {
      return;
    }


    var popup =
      content.closest(
        '.product_popup'
      );


    var variantInput =
      form.querySelector(
        '.popup_variant_id'
      );


    var addButton =
      form.querySelector(
        '.popup_add_to_cart'
      );


    var addButtonText =
      form.querySelector(
        '.popup_add_to_cart_text'
      );


    if (!variantInput) {
      console.error(
        'Variant input not found'
      );

      return;
    }


    /*
     * IMPORTANT:
     *
     * Always get the variant ID from
     * the updated hidden input.
     */

    var selectedVariantId =
      variantInput.value;


    console.log(
      'SUBMITTING VARIANT ID:',
      selectedVariantId
    );


    /*
     * If no variant is selected,
     * do not add anything.
     */

    if (!selectedVariantId) {

      console.error(
        'No valid variant selected'
      );

      return;
    }


    /*
     * Prevent duplicate submissions.
     */

    if (
      form.dataset.addingToCart === 'true'
    ) {
      return;
    }


    form.dataset.addingToCart =
      'true';


    /*
     * Disable button immediately.
     */

    if (addButton) {
      addButton.disabled = true;
    }


    if (addButtonText) {
      addButtonText.textContent =
        'ADDING...';
    }


    /* =======================================================
     * CHECK M + BLACK
     * ======================================================= */

    var selectedOptions =
      getSelectedOptions(content);


    var normalizedOptions =
      selectedOptions.map(
        function (value) {

          return value
            ? String(value)
                .trim()
                .toLowerCase()
            : '';

        }
      );


    var hasSizeM =
      normalizedOptions.indexOf('m') !== -1;


    var hasBlack =
      normalizedOptions.indexOf('black') !== -1;


    /* =======================================================
     * CART ITEMS
     * ======================================================= */

    var items = [

      {
        id: Number(
          selectedVariantId
        ),
        quantity: 1
      }

    ];


    /*
     * Auto-added product.
     */

    var autoAddedProductId =
      Number(
        {{ auto_added_product | default: 0 }}
      );


    if (
      hasSizeM &&
      hasBlack &&
      autoAddedProductId &&
      autoAddedProductId !==
        Number(selectedVariantId)
    ) {

      items.push({

        id: autoAddedProductId,

        quantity: 1

      });

    }


    console.log(
      'FINAL CART ITEMS:',
      items
    );


    /* =======================================================
     * ADD TO CART
     * ======================================================= */

    fetch(
      window.Shopify.routes.root +
      'cart/add.js',
      {
        method: 'POST',

        headers: {
          'Content-Type':
            'application/json',

          'Accept':
            'application/json'
        },

        body: JSON.stringify({
          items: items
        })
      }
    )


    .then(function (response) {

      if (!response.ok) {

        return response
          .json()
          .then(function (error) {

            throw error;

          });

      }

      return response.json();

    })


    .then(function (data) {

      console.log(
        'ADDED TO CART:',
        data
      );


      /*
       * Close popup.
       */

      if (popup) {

        popup.classList.remove(
          'is-open'
        );

        popup.setAttribute(
          'aria-hidden',
          'true'
        );

      }


      document.body.classList.remove(
        'quick-view-open'
      );


      /*
       * Notify theme.
       */

      document.dispatchEvent(
        new CustomEvent(
          'cart:updated',
          {
            detail: data
          }
        )
      );


      document.dispatchEvent(
        new CustomEvent(
          'cart:refresh',
          {
            detail: data
          }
        )
      );


      /*
       * Reset submission state.
       */

      form.dataset.addingToCart =
        'false';


      if (addButton) {
        addButton.disabled = false;
      }


      if (addButtonText) {

        addButtonText.innerHTML =
          'ADD TO CART <span class="popup_add_to_cart_arrow"> &xrarr; </span>';

      }

    })


    .catch(function (error) {

      console.error(
        'ADD TO CART ERROR:',
        error
      );


      /*
       * Allow retry.
       */

      form.dataset.addingToCart =
        'false';


      /*
       * Recalculate current variant
       * before enabling button.
       */

      updateVariant(content);

    });

  });


  /* =========================================================
   * INITIALIZE ALL POPUPS
   * ========================================================= */

  document
    .querySelectorAll(
      '.popup_product_content'
    )
    .forEach(function (content) {

      /*
       * Don't automatically select the first
       * variant.
       *
       * If "Choose your size" is selected,
       * hidden input will remain empty.
       */

      var form =
        content.querySelector(
          '.popup_product_form'
        );

      if (!form) {
        return;
      }


      var variantInput =
        form.querySelector(
          '.popup_variant_id'
        );


      var select =
        content.querySelector(
          '.popup_option_select'
        );


      /*
       * If you have the "Choose your size"
       * placeholder, clear the variant initially.
       */

      if (
        select &&
        select.value === ''
      ) {

        variantInput.value = '';

      } else {

        /*
         * Otherwise calculate the initial
         * variant from current selections.
         */

        updateVariant(content);

      }

    });

});
</script>