{% assign auto_product = section.settings.select_product %}

<!-- ============================================================
     POPUP PRODUCT INFORMATION
============================================================ -->

<div class="popup_product_info">

  <!-- PRODUCT TITLE -->

  <h3 class="popup_product_title">
    {{ product.title }}
  </h3>


  <!-- PRODUCT PRICE -->

  <div
    class="popup_product_price"
    data-product-price
  >
    {{ product.selected_or_first_available_variant.price | money }}
  </div>


  <!-- PRODUCT DESCRIPTION -->

  {% if product.description != blank %}

    <div class="popup_product_description">
      {{ product.description | strip_html | truncatewords: 30 }}
    </div>

  {% endif %}

</div>


<!-- ============================================================
     PRODUCT FORM
============================================================ -->

{% form 'product',
  product,
  class: 'popup_product_form'
%}


  <!-- ==========================================================
       CURRENT PRODUCT VARIANT ID
  =========================================================== -->

  <input
    type="hidden"
    name="id"
    class="popup_variant_id"
    value="{{ product.selected_or_first_available_variant.id }}"
  >


  <!-- ==========================================================
       PRODUCT OPTIONS
  =========================================================== -->

  {% unless product.has_only_default_variant %}

    <div class="popup_product_options">

      {% for option in product.options_with_values %}

        <div
          class="popup_product_option"
          data-option-index="{{ forloop.index0 }}"
        >

          <label class="popup_option_label">
            {{ option.name }}
          </label>


          <!-- ==================================================
               FIRST OPTION = SELECT
          =================================================== -->

          {% if forloop.first %}

            <div class="popup_select_wrapper">

              <select
                class="popup_option_select"
                data-option-index="{{ forloop.index0 }}"
              >

                {% for value in option.values %}

                  <option
                    value="{{ value | escape }}"
                    {% if option.selected_value == value %}
                      selected
                    {% endif %}
                  >
                    {{ value }}
                  </option>

                {% endfor %}

              </select>


              <span class="popup_select_arrow">
                ↓
              </span>

            </div>


          <!-- ==================================================
               OTHER OPTIONS = BUTTONS
          =================================================== -->

          {% else %}

            <div class="popup_option_buttons">

              {% for value in option.values %}

                <button
                  type="button"
                  class="popup_option_button {% if option.selected_value == value %}is-selected{% endif %}"
                  data-option-value="{{ value | escape }}"
                  data-option-index="{{ forloop.parentloop.index0 }}"
                  style="border-left: 4px solid {{ value }}"
                >
                  {{ value }}
                </button>

              {% endfor %}

            </div>

          {% endif %}

        </div>

      {% endfor %}

    </div>

  {% endunless %}


  <!-- ==========================================================
       ADD TO CART
  =========================================================== -->

  <button
    type="submit"
    name="add"
    class="popup_add_to_cart custom-banner__button"
    {% unless product.selected_or_first_available_variant.available %}
      disabled
    {% endunless %}
  >

    <span class="popup_add_to_cart_text">

      {% if product.selected_or_first_available_variant.available %}

        ADD TO CART

        <span class="popup_add_to_cart_arrow">
          &xrarr;
        </span>

      {% else %}

        SOLD OUT

      {% endif %}

    </span>

  </button>


{% endform %}


<!-- ============================================================
     CURRENT PRODUCT VARIANT JSON
     
     JavaScript reads this instead of guessing the variant.
============================================================ -->

<script
  type="application/json"
  class="popup-product-variants"
>
[
  {% for variant in product.variants %}

    {
      "id": {{ variant.id | json }},
      "product_id": {{ variant.product_id | json }},
      "available": {{ variant.available | json }},
      "price": {{ variant.price | json }},
      "price_formatted": {{ variant.price | money | json }},
      "options": {{ variant.options | json }}
    }{% unless forloop.last %},{% endunless %}

  {% endfor %}
]
</script>


<!-- ============================================================
     AUTOMATIC PRODUCT DATA
     
     This is the important part for:
     
     BLACK + MEDIUM
     
     -> Soft Winter Jacket
     -> exact Black + Medium variant
============================================================ -->

{% if auto_product != blank %}

  <script
    type="application/json"
    class="popup-auto-product-data"
  >
  {
    "productId": {{ auto_product.id | json }},
    "productTitle": {{ auto_product.title | json }},
    "options": {{ auto_product.options | json }},
    "variants": [

      {% for variant in auto_product.variants %}

        {
          "id": {{ variant.id | json }},
          "product_id": {{ variant.product_id | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | json }},
          "options": {{ variant.options | json }}
        }{% unless forloop.last %},{% endunless %}

      {% endfor %}

    ]
  }
  </script>

{% endif %}