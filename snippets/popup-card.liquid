{% assign auto_added_product = section.settings.select_product.selected_or_first_available_variant.id %}

<script type="application/json" id="variants-json-{{ product.id }}">
  {{ product.variants | json }}
</script>

<div class="popup_product_content" data-auto-variant-id="{{ auto_added_product }}">
  <div class="product_popup_close" id="close-popup-{{ product.id }}">
    <img
      src="https://cdn.shopify.com/s/files/1/0740/2592/6742/files/Group_1000008157.svg?v=1786149863"
      alt="close_icon"
    >
  </div>

  <div class="image_with_info">
    <div class="popup_product_image">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          loading="lazy"
        >
      {% endif %}
    </div>

    <div class="popup_product_info">
      <h3 class="popup_product_title">
        {{ product.title }}
      </h3>

      <div class="popup_product_price">
        {{ product.selected_or_first_available_variant.price | money }}
      </div>

      {% if product.description != blank %}
        <div class="popup_product_description">
          {{ product.description | strip_html | truncatewords: 30 }}
        </div>
      {% endif %}
    </div>
  </div>

  <!-- No <form> tag at all now — plain div, no native submission possible -->
  <div class="popup_product_form">

    {% unless product.has_only_default_variant %}

      {% assign color_option = nil %}
      {% assign size_option = nil %}
      {% assign other_options = '' | split: ',' %}

      {% for option in product.options_with_values %}
        {% case option.name %}
          {% when 'Color', 'Colour' %}
            {% assign color_option = option %}
          {% when 'Size' %}
            {% assign size_option = option %}
          {% else %}
            {% assign other_options = other_options | concat: option %}
        {% endcase %}
      {% endfor %}

      {% assign ordered_options = '' | split: ',' %}
      {% if color_option %}
        {% assign ordered_options = ordered_options | concat: color_option %}
      {% endif %}
      {% if size_option %}
        {% assign ordered_options = ordered_options | concat: size_option %}
      {% endif %}
      {% assign ordered_options = ordered_options | concat: other_options %}

      <div class="popup_product_options">

        {% for option in ordered_options %}

          <div
            class="popup_product_option"
            data-option-index="{{ forloop.index0 }}"
          >

            <label class="popup_option_label">
              {{ option.name }}
            </label>

            {% if option.name == 'Size' %}

              <div class="popup_select_wrapper">
                <select
                  class="popup_option_select"
                  data-option-index="{{ forloop.index0 }}"
                >
                    <option value="" disabled selected>Choose your size</option>

                  {% for value in option.values %}
                    <option value="{{ value | escape }}">
                      {{ value }}
                    </option>
                  {% endfor %}

                </select>

                <span class="popup_select_arrow">↓</span>
              </div>

            {% else %}

              <div class="popup_option_buttons">

                {% for value in option.values %}

                  <button
                    type="button"
                    class="popup_option_button{% if option.selected_value == value %} is-selected{% endif %}{% if value == 'White' %} has-shadow-border{% endif %}"
                    style="border-left: 4px solid {{ value | handle }};"
                    data-option-value="{{ value | escape }}"
                    data-option-index="{{ forloop.index0 }}"
                  >
                    {{ value }}
                  </button>

                {% endfor %}

              </div>

            {% endif %}

          </div>

        {% endfor %}

      </div>
    {% endunless %}

    <!-- type="button" — never "submit", since there's no form to submit -->
    <button
      type="button"
      class="popup_add_to_cart custom-banner__button"
      {% unless product.selected_or_first_available_variant.available %}
        disabled
      {% endunless %}
    >
      <span class="popup_add_to_cart_text">
        {% if product.selected_or_first_available_variant.available %}
          ADD TO CART
          <span class="popup_add_to_cart_arrow"> &xrarr; </span>
        {% else %}
          SOLD OUT
        {% endif %}
      </span>
    </button>

  </div>

</div>
